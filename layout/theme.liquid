    <script>
      // NProgress Page Load Handling
      NProgress.configure({ showSpinner: false });
      NProgress.done();
      
      async function logoutAccount() {
        try {
          await fetch('/api/storefront/v2/auth/logout', { method: 'POST' });
          window.location.reload();
        } catch (err) {
          window.location.reload();
        }
      }
      
      document.addEventListener('click', e => {
        const a = e.target.closest('a');
        if (a && a.href && !a.href.startsWith('#') && !a.target && a.host === window.location.host) {
          if (a.href !== window.location.href) NProgress.start();
        }
      });

      // Discord Widget Data Fetcher
      {% if settings.discord.guild_id != blank %}
      fetch('https://discord.com/api/guilds/{{ settings.discord.guild_id | default: '1256991995147190272' }}/widget.json')
        .then(res => res.json())
        .then(data => {
          if (data.presence_count !== undefined) {
            document.querySelectorAll('.discord-live-count').forEach(el => {
              const format = el.getAttribute('data-format') || '{count}';
              el.textContent = format.replace('{count}', data.presence_count);
            });
          }
          if (data.instant_invite) {
            document.querySelectorAll('.discord-invite-link').forEach(el => {
              el.href = data.instant_invite;
            });
          }
        })
        .catch(err => console.error('Discord API Hatası:', err));
      {% endif %}

      // MCAPI.TR Minecraft Server Status Fetcher
      const serverIp = '{{ settings.server_ip | default: "mc.hypixel.net" }}';
      if (serverIp) {
        const countEl = document.getElementById('server-player-count');
        
        async function fetchServerStatus() {
          try {
            const res = await fetch(`https://mcapi.tr/api/v1/status/${serverIp}`);
            if (!res.ok) throw new Error('MCAPI.TR error');
            const data = await res.json();
            if (data.online && data.players) {
              return data.players.online;
            }
          } catch (e) {
            console.warn('MCAPI.TR failed, trying fallback...', e);
            try {
              const res2 = await fetch(`https://api.mcsrvstat.us/3/${serverIp}`);
              if (!res2.ok) throw new Error('Fallback API error');
              const data2 = await res2.json();
              if (data2.online && data2.players) {
                return data2.players.online;
              }
            } catch (e2) {
              console.error('All APIs failed', e2);
            }
          }
          return null;
        }

        fetchServerStatus().then(online => {
          document.querySelectorAll('.server-player-count').forEach(el => {
            if (online !== null) {
              el.textContent = `${online} Oyuncu Çevrimiçi`;
            } else {
              el.textContent = 'Bakımda veya Kapalı';
            }
          });
        });
      }
    </script>
    <script>
      function updateGlobalCartBadge() {
        try {
          const cart = JSON.parse(localStorage.getItem('cart') || '[]');
          const count = cart.reduce((sum, item) => sum + (item.quantity || 1), 0);
          document.querySelectorAll('.header-cart-badge').forEach((el) => {
            el.innerText = count;
            if (count > 0) el.classList.remove('hidden');
            else el.classList.add('hidden');
          });
        } catch (e) {}
      }

      // Global Add to Cart function
      window.addToCart = function (product, quantity = 1) {
        try {
          const productId = product.id || product._id;
          if (!productId) return;

          let cart = JSON.parse(localStorage.getItem('cart') || '[]');
          const idx = cart.findIndex((i) => (i.id || i._id) === productId);
          if (idx !== -1) {
            cart[idx].quantity += quantity;
          } else {
            product.quantity = quantity;
            product.id = productId; // ensure standard id field
            cart.push(product);
          }
          localStorage.setItem('cart', JSON.stringify(cart));
          updateGlobalCartBadge();
          window.showToast?.('Ürün sepete eklendi!', 'success');
        } catch (e) {
          console.error(e);
        }
      };

      document.addEventListener('DOMContentLoaded', updateGlobalCartBadge);
      // Listen for local storage changes across tabs
      window.addEventListener('storage', (e) => {
        if (e.key === 'cart') updateGlobalCartBadge();
      });
    </script>
    <!-- Drawer Management Scripts -->
    <script>
      // User Drawer (Right Side)
      function openUserMenu() {
        const drawer = document.getElementById('user-drawer');
        const backdrop = document.getElementById('user-drawer-backdrop');
        if (!drawer || !backdrop) return;
        backdrop.classList.remove('opacity-0', 'pointer-events-none');
        backdrop.classList.add('opacity-100');
        drawer.classList.remove('translate-x-full');
        drawer.classList.add('translate-x-0');
        document.body.style.overflow = 'hidden';
      }

      function closeUserMenu() {
        const drawer = document.getElementById('user-drawer');
        const backdrop = document.getElementById('user-drawer-backdrop');
        if (!drawer || !backdrop) return;
        backdrop.classList.remove('opacity-100');
        backdrop.classList.add('opacity-0', 'pointer-events-none');
        drawer.classList.remove('translate-x-0');
        drawer.classList.add('translate-x-full');
        document.body.style.overflow = '';
      }

      function toggleUserMenu() {
        const drawer = document.getElementById('user-drawer');
        if (drawer && drawer.classList.contains('translate-x-0')) {
          closeUserMenu();
        } else {
          openUserMenu();
        }
      }

      // Mobile Navigation Drawer (Left Side)
      function toggleMobileMenu() {
        const sidebar = document.getElementById('mobile-menu-sidebar');
        const overlay = document.getElementById('mobile-menu-overlay');
        if (!sidebar || !overlay) return;

        const isOpen = sidebar.classList.contains('translate-x-0');
        if (isOpen) {
          sidebar.classList.remove('translate-x-0');
          sidebar.classList.add('-translate-x-full');
          overlay.classList.remove('opacity-100');
          overlay.classList.add('opacity-0', 'pointer-events-none');
          document.body.style.overflow = '';
        } else {
          sidebar.classList.remove('-translate-x-full');
          sidebar.classList.add('translate-x-0');
          overlay.classList.remove('opacity-0', 'pointer-events-none');
          overlay.classList.add('opacity-100');
          document.body.style.overflow = 'hidden';
        }
      }

      // Close on Escape key
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
          closeUserMenu();
          const sidebar = document.getElementById('mobile-menu-sidebar');
          if (sidebar && sidebar.classList.contains('translate-x-0')) {
            toggleMobileMenu();
          }
        }
      });
    </script>

