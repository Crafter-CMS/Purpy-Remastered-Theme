<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {{ content_for_header }}

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
      :root {
        --color-primary: {{ settings.colors.primary | default: '#7c3aed' }};
        --color-secondary: {{ settings.colors.secondary | default: '#9333ea' }};
        --color-bg: {{ settings.colors.background | default: '#0e0914' }};
        --color-surface: {{ settings.colors.surface | default: '#1a1020' }};
        --color-border: {{ settings.colors.border | default: 'rgba(124, 58, 237, 0.25)' }};
        --color-text-primary: {{ settings.colors.text_primary | default: '#ffffff' }};
        --color-text-secondary: {{ settings.colors.text_secondary | default: '#cbd5e1' }};
        --color-primary-rgb: 124, 58, 237;
        /* Aliases */
        --text-primary: var(--color-text-primary);
        --text-secondary: var(--color-text-secondary);
        --text-muted: #7a6e8a;
        --bg-base: var(--color-bg);
        --bg-card: var(--color-surface);
        --bg-card-hover: #1f1428;
        --bg-card-elevated: #241830;
        --border: var(--color-border);
        --accent: var(--color-primary);
      }
    </style>
    <script>
      (function() {
        function hexToRgb(hex) {
          if (!hex) return '124, 58, 237';
          hex = hex.replace('#', '').trim();
          if (hex.length === 3) {
            hex = hex.split('').map(c => c + c).join('');
          }
          if (hex.length === 6) {
            const r = parseInt(hex.substring(0, 2), 16);
            const g = parseInt(hex.substring(2, 4), 16);
            const b = parseInt(hex.substring(4, 6), 16);
            return !isNaN(r) && !isNaN(g) && !isNaN(b) ? `${r}, ${g}, ${b}` : '124, 58, 237';
          }
          return '124, 58, 237';
        }
        const primaryHex = "{{ settings.colors.primary | default: '#7c3aed' }}";
        document.documentElement.style.setProperty('--color-primary-rgb', hexToRgb(primaryHex));
      })();
    </script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              primary: 'rgb(var(--color-primary-rgb) / <alpha-value>)',
              secondary: 'var(--color-secondary)',
              card: 'var(--color-surface)',
              base: 'var(--color-bg)',
            },
            fontFamily: {
              sans: ['Inter', 'sans-serif'],
              display: ['Rajdhani', 'sans-serif'],
            },
          },
        },
      };
    </script>

    <!-- Theme CSS -->
    <link rel="stylesheet" href="{{ 'assets/style.css' | asset_url }}">

    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- NProgress for smooth page transitions -->
    <link rel="stylesheet" href="https://unpkg.com/nprogress@0.2.0/nprogress.css">
    <script src="https://unpkg.com/nprogress@0.2.0/nprogress.js"></script>
    <style>
      #nprogress .bar {
        background: var(--color-primary) !important;
        height: 3px !important;
      }
      #nprogress .peg {
        box-shadow: 0 0 10px var(--color-primary), 0 0 5px var(--color-primary) !important;
      }
      #nprogress .spinner {
        display: none !important;
      }

      /* MPA View Transitions */
      @view-transition {
        navigation: auto;
      }
      @keyframes fade-in {
        from {
          opacity: 0;
          transform: translateY(10px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
      @keyframes fade-out {
        from {
          opacity: 1;
          transform: translateY(0);
        }
        to {
          opacity: 0;
          transform: translateY(-10px);
        }
      }
      ::view-transition-old(root) {
        animation: 200ms ease-out both fade-out;
      }
      ::view-transition-new(root) {
        animation: 200ms ease-out both fade-in;
      }

      /* Marquee Animation */
      @keyframes marquee {
        0% {
          transform: translateX(0);
        }
        100% {
          transform: translateX(-50%);
        }
      }

      /* Levitate Animation */
      @keyframes levitate {
        0% {
          transform: translateY(0);
        }
        50% {
          transform: translateY(-24px);
        }
        100% {
          transform: translateY(0);
        }
      }
      .animate-levitate {
        animation: levitate 4s ease-in-out infinite;
      }
    </style>

    {% if settings.integrations.google_analytics_id != blank %}
      <!-- Global site tag (gtag.js) - Google Analytics -->
      <script
        async
        src="https://www.googletagmanager.com/gtag/js?id={{ settings.integrations.google_analytics_id }}"
      ></script>
      <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          dataLayer.push(arguments);
        }
        gtag('js', new Date());
        gtag('config', '{{ settings.integrations.google_analytics_id }}');
      </script>
    {% endif %}
  </head>

  <body
    class="flex flex-col min-h-screen antialiased selection:bg-primary selection:text-white"
    style="background-color: var(--color-bg); color: var(--color-text-primary);"
  >
    {% unless template == 'auth' or template contains 'auth/' or template == 'errors/maintenance' %}
      <!--
        ============================================================
        HERO HEADER & CYBER-HUD NAVBAR (Dark Luxury Purpy Remastered)
        ============================================================
      -->
      <header class="relative w-full overflow-hidden pb-12 sm:pb-16">
        <!-- Background Wallpaper & Cinematic Lighting -->
        <div class="absolute inset-0 z-0 pointer-events-none overflow-hidden">
          <img
            src="{% if settings.header.banner %}{{ settings.header.banner }}{% else %}https://images.unsplash.com/photo-1627856013091-fed6e4e30025?q=80&w=2070&auto=format&fit=crop{% endif %}"
            alt="Hero Background"
            class="w-full h-[520px] object-cover blur-[2px] opacity-30 scale-105"
          >
          <div class="absolute inset-0 bg-gradient-to-b from-[#0e0914]/40 via-[#0e0914]/80 to-[#0e0914]"></div>
          <!-- Ambient Glow Spheres -->
          <div class="absolute -top-20 left-1/4 w-96 h-96 rounded-full blur-3xl opacity-20 pointer-events-none" style="background: var(--color-primary);"></div>
          <div class="absolute -top-20 right-1/4 w-96 h-96 rounded-full blur-3xl opacity-15 pointer-events-none" style="background: #ec4899;"></div>
        </div>

        <div class="relative z-20">
          <!-- Hero Banner Top: Status, Logo & Discord (3-Column Layout) -->
          <div class="relative w-full max-w-[1350px] mx-auto px-4 sm:px-6 pt-16 sm:pt-20 pb-12 sm:pb-16">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-center">
              <!-- Left HUD Card: Server IP & Live Player Status -->
              <div class="hidden lg:flex justify-start items-center">
                <div
                  onclick="copyIp('{{ settings.server_ip | default: 'mc.hypixel.net' }}')"
                  class="flex items-center gap-3.5 p-3.5 px-5 rounded-2xl border-2 backdrop-blur-xl shadow-2xl transition-all duration-300 hover:scale-105 hover:border-primary cursor-pointer select-none group"
                  style="
                    background: linear-gradient(135deg, rgba(26, 16, 32, 0.90), rgba(18, 10, 24, 0.90));
                    border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.30);
                  "
                  title="Sunucu adresini kopyalamak için tıklayın"
                >
                  <div
                    class="w-12 h-12 rounded-xl flex items-center justify-center flex-shrink-0 shadow-lg border transition-transform group-hover:scale-110"
                    style="
                      background: rgba(var(--color-primary-rgb, 124, 58, 237), 0.20);
                      border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.45);
                      color: var(--color-primary);
                    "
                  >
                    <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
                      <path d="M8 5v14l11-7z"/>
                    </svg>
                  </div>
                  <div class="flex flex-col text-left">
                    <span class="text-sm font-black text-white tracking-wide leading-tight group-hover:text-primary transition-colors" style="color: #ffffff !important;">
                      {{ settings.server_ip | default: 'mc.hypixel.net' }}
                    </span>
                    <div class="flex items-center gap-1.5 mt-1">
                      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                      <span class="server-player-count text-xs font-bold text-gray-300">
                        {% if statistics.onlinePlayers -%}
                          {{- statistics.onlinePlayers }} Oyuncu Aktif
                        {%- else -%}
                          Aktif
                        {%- endif %}
                      </span>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Center: Majestic Levitating Logo -->
              <div class="flex justify-center items-center w-full">
                <div class="relative z-40 animate-levitate flex items-center justify-center w-full">
                  <!-- Aura Behind Logo -->
                  <div class="absolute w-48 sm:w-64 h-48 sm:h-64 rounded-full blur-3xl opacity-30 pointer-events-none" style="background: var(--color-primary);"></div>
                  <a
                    href="/"
                    class="relative z-10 flex items-center justify-center w-full max-w-[240px] sm:max-w-[280px] md:max-w-[340px] lg:max-w-[380px] transition-transform duration-300 hover:scale-105"
                  >
                    {% assign default_logo = 'https://avatars.githubusercontent.com/u/3840546?s=280&v=4' %}
                    <img
                      src="{{ settings.logo_light | default: default_logo }}"
                      alt="{{ shop.name }}"
                      class="h-auto w-full object-contain drop-shadow-[0_15px_30px_rgba(0,0,0,0.5)]"
                      style="image-rendering: crisp-edges; max-height: 220px;"
                    >
                  </a>
                </div>
              </div>

              <!-- Right HUD Card: Discord Community -->
              <div class="hidden lg:flex justify-end items-center">
                <a
                  href="{{ settings.discord_url | default: '#' }}"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-3.5 p-3.5 px-5 rounded-2xl border-2 backdrop-blur-xl shadow-2xl transition-all duration-300 hover:scale-105 hover:border-[#5865F2] cursor-pointer select-none group"
                  style="
                    background: linear-gradient(135deg, rgba(26, 16, 32, 0.90), rgba(18, 10, 24, 0.90));
                    border-color: rgba(88, 101, 242, 0.35);
                  "
                >
                  <div class="flex flex-col text-right">
                    <span class="text-sm font-black text-white tracking-wide leading-tight group-hover:text-[#5865F2] transition-colors" style="color: #ffffff !important;">
                      Discord Topluluğu
                    </span>
                    <div class="flex items-center justify-end gap-1.5 mt-1">
                      <span class="w-2 h-2 rounded-full bg-sky-400 animate-pulse"></span>
                      <span
                        class="discord-live-count text-xs font-bold text-gray-300"
                        data-format="{count} Üye Çevrimiçi"
                      >
                        Topluluğa Katıl
                      </span>
                    </div>
                  </div>
                  <div
                    class="w-12 h-12 rounded-xl flex items-center justify-center flex-shrink-0 shadow-lg border transition-transform group-hover:scale-110"
                    style="
                      background: rgba(88, 101, 242, 0.20);
                      border-color: rgba(88, 101, 242, 0.45);
                      color: #5865F2;
                    "
                  >
                    <i class="fa-brands fa-discord text-2xl leading-none" style="color: #5865F2;"></i>
                  </div>
                </a>
              </div>
            </div>
          </div>

          <!--
            ============================================================
            FLOATING LUXURY CYBER-HUD NAVBAR BAR
            ============================================================
          -->
          <div class="w-full max-w-[1300px] mx-auto px-4 sm:px-6 relative z-40">
            <div
              class="relative rounded-3xl p-3 sm:p-4 px-4 sm:px-6 border-2 shadow-2xl backdrop-blur-2xl overflow-hidden flex items-center justify-between gap-4"
              style="
                background: linear-gradient(135deg, rgba(28, 16, 38, 0.95), rgba(18, 10, 24, 0.95));
                border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.30);
                box-shadow: 0 20px 50px -10px rgba(0, 0, 0, 0.8), 0 0 30px rgba(var(--color-primary-rgb, 124, 58, 237), 0.15);
              "
            >
              <!-- Ambient Top Highlight -->
              <div class="absolute top-0 inset-x-0 h-[1.5px] bg-gradient-to-r from-transparent via-primary to-transparent opacity-80"></div>

              <!-- Left: Direct Navigation Pills -->
              <nav class="flex items-center gap-2 sm:gap-3 flex-wrap">
                {% if settings.nav_links != blank and settings.nav_links.size > 0 %}
                  {% for link in settings.nav_links %}
                    {% assign is_active = false %}
                    {% if link.url == '/' %}
                      {% if request.path == '/' or request.path == blank %}
                        {% assign is_active = true %}
                      {% endif %}
                    {% elsif request.path contains link.url %}
                      {% assign is_active = true %}
                    {% endif %}
                    <a
                      href="{{ link.url }}"
                      class="px-4 py-2.5 rounded-xl font-black text-xs sm:text-sm uppercase tracking-wider transition-all duration-200 whitespace-nowrap flex items-center gap-2 border {% if is_active %}text-white bg-primary shadow-lg shadow-primary/30 border-primary/60{% else %}text-gray-300 hover:text-white hover:bg-white/5 border-transparent hover:border-white/10{% endif %}"
                      {% if link.new_tab %}target="_blank"{% endif %}
                    >
                      <span>{{ link.title }}</span>
                    </a>
                  {% endfor %}
                {% else %}
                  <a
                    href="/"
                    class="px-4 py-2.5 rounded-xl font-black text-xs sm:text-sm uppercase tracking-wider transition-all duration-200 whitespace-nowrap flex items-center gap-2 border {% if request.path == '/' or request.path == blank %}text-white bg-primary shadow-lg shadow-primary/30 border-primary/60{% else %}text-gray-300 hover:text-white hover:bg-white/5 border-transparent hover:border-white/10{% endif %}"
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
                    <span>Ana Sayfa</span>
                  </a>
                  <a
                    href="/store"
                    class="px-4 py-2.5 rounded-xl font-black text-xs sm:text-sm uppercase tracking-wider transition-all duration-200 whitespace-nowrap flex items-center gap-2 border {% if request.path contains '/store' %}text-white bg-primary shadow-lg shadow-primary/30 border-primary/60{% else %}text-gray-300 hover:text-white hover:bg-white/5 border-transparent hover:border-white/10{% endif %}"
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
                    <span>Mağaza</span>
                  </a>
                  <a
                    href="/support"
                    class="px-4 py-2.5 rounded-xl font-black text-xs sm:text-sm uppercase tracking-wider transition-all duration-200 whitespace-nowrap flex items-center gap-2 border {% if request.path contains '/support' %}text-white bg-primary shadow-lg shadow-primary/30 border-primary/60{% else %}text-gray-300 hover:text-white hover:bg-white/5 border-transparent hover:border-white/10{% endif %}"
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
                    <span>Destek</span>
                  </a>
                {% endif %}
              </nav>

              <!-- Right: Cart & User Account Actions -->
              <div class="flex items-center gap-2.5 sm:gap-3">
                <!-- Sepet Button -->
                <a
                  href="/cart"
                  id="nav-cart-btn"
                  class="relative text-white px-4 py-2.5 sm:px-5 sm:py-3 rounded-2xl font-black text-xs sm:text-sm uppercase tracking-wider transition-all duration-200 flex items-center justify-center gap-2 border-2 hover:scale-105 outline-none h-12 cursor-pointer shadow-xl"
                  style="
                    background: linear-gradient(135deg, rgba(var(--color-primary-rgb, 124, 58, 237), 0.25), rgba(147, 51, 234, 0.15));
                    border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.40);
                    color: #ffffff !important;
                  "
                >
                  <svg class="w-4 h-4 sm:w-5 sm:h-5 text-purple-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
                  </svg>
                  <span>Sepet</span>
                  <span class="header-cart-badge hidden absolute -top-1.5 -right-1.5 w-5 h-5 bg-red-500 text-white text-[10px] font-black rounded-full flex items-center justify-center shadow"
                    >0</span
                  >
                </a>

                <!-- User / Auth Action Button -->
                {% if customer %}
                  <div class="relative">
                    <button
                      type="button"
                      id="nav-user-btn"
                      class="relative text-white px-3 sm:px-4 py-2 rounded-2xl font-bold text-xs sm:text-sm transition-all duration-200 flex items-center justify-center gap-2.5 border-2 hover:scale-105 outline-none h-12 cursor-pointer shadow-xl"
                      style="
                        background: linear-gradient(135deg, var(--color-primary), #9333ea);
                        border-color: rgba(255, 255, 255, 0.25);
                      "
                      onclick="toggleUserMenu()"
                    >
                      <div class="relative w-8 h-8 rounded-xl overflow-hidden flex-shrink-0 ring-2 ring-white/30">
                        <img
                          src="https://mc-heads.net/avatar/{{ customer.username }}/32"
                          alt="{{ customer.username }}"
                          class="w-full h-full object-cover"
                        >
                      </div>
                      <span class="hidden sm:inline font-black uppercase tracking-wider text-xs whitespace-nowrap">{{ customer.username }}</span>
                      <svg class="w-4 h-4 hidden sm:block text-white/80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                      </svg>
                    </button>
                  </div>
                {% else %}
                  <a
                    href="/auth/login"
                    class="relative text-white px-4 sm:px-6 py-2.5 sm:py-3 rounded-2xl font-black text-xs sm:text-sm uppercase tracking-wider transition-all duration-200 flex items-center justify-center gap-2 border shadow-xl hover:scale-105 outline-none h-12 cursor-pointer"
                    style="
                      background: linear-gradient(135deg, var(--color-primary), #9333ea);
                      border-color: rgba(255, 255, 255, 0.25);
                    "
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                    </svg>
                    <span class="whitespace-nowrap">Giriş Yap</span>
                  </a>
                {% endif %}
              </div>
            </div>
          </div>
        </div>
      </header>

      <!-- Mobile Menu Overlay -->
      <div
        id="mobile-menu-overlay"
        class="fixed inset-0 z-[60] opacity-0 pointer-events-none transition-opacity duration-300"
        style="background: rgba(0,0,0,0.75); backdrop-filter: blur(4px);"
        onclick="toggleMobileMenu()"
      ></div>

      <!-- Mobile Menu Sidebar -->
      <div
        id="mobile-menu-sidebar"
        class="fixed inset-y-0 left-0 z-[70] w-full sm:w-[400px] shadow-2xl transform -translate-x-full transition-transform duration-300 ease-[cubic-bezier(0.4,0,0.2,1)] flex flex-col"
        style="background: linear-gradient(to bottom, #140c1e, #0e0914); border-right: 2px solid rgba(var(--color-primary-rgb,124,58,237),0.25);"
      >
        <!-- Sidebar Üst: Logo + Kapat -->
        <div
          class="flex items-center justify-between p-6 bg-gradient-to-r from-primary/20 via-primary/10 to-transparent"
          style="border-bottom: 2px solid rgba(var(--color-primary-rgb,124,58,237),0.25);"
        >
          <h2 class="text-2xl sm:text-3xl font-bold text-white">Menü</h2>
          <button
            onclick="toggleMobileMenu()"
            class="w-10 h-10 flex items-center justify-center rounded-xl transition-all"
            style="color: rgba(255,255,255,0.8);"
            onmouseover="this.style.background='rgba(var(--color-primary-rgb,124,58,237),0.2)'; this.style.transform='rotate(90deg)';"
            onmouseout="this.style.background='transparent'; this.style.transform='rotate(0deg)';"
            aria-label="Kapat"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </button>
        </div>

        <!-- Navigasyon Linkleri -->
        <div class="flex-1 overflow-y-auto p-6">
          <nav class="space-y-3">
            {% if settings.nav_links != blank %}
              {% for link in settings.nav_links %}
                {% assign is_active = false %}
                {% if link.url == '/' %}
                  {% if request.path == '/' or request.path == blank %}
                    {% assign is_active = true %}
                  {% endif %}
                {% elsif request.path contains link.url %}
                  {% assign is_active = true %}
                {% endif %}
                <a
                  href="{{ link.url }}"
                  onclick="toggleMobileMenu()"
                  class="flex items-center gap-4 px-4 py-4 rounded-2xl font-semibold transition-all duration-200"
                  style="
                    color: {% if is_active %}var(--color-primary){% else %}rgba(255,255,255,0.8){% endif %};
                    background: {% if is_active %}rgba(var(--color-primary-rgb,124,58,237),0.15){% else %}transparent{% endif %};
                    border: 2px solid {% if is_active %}rgba(var(--color-primary-rgb,124,58,237),0.3){% else %}transparent{% endif %};
                  "
                  onmouseover="this.style.background='rgba(var(--color-primary-rgb,124,58,237),0.1)'; this.style.color='var(--color-primary)'; this.style.transform='translateX(4px)';"
                  onmouseout="this.style.background='{% if is_active %}rgba(var(--color-primary-rgb,124,58,237),0.15){% else %}transparent{% endif %}'; this.style.color='{% if is_active %}var(--color-primary){% else %}rgba(255,255,255,0.8){% endif %}'; this.style.transform='translateX(0)';"
                >
                  <div
                    class="flex items-center justify-center w-12 h-12 rounded-xl"
                    style="background: rgba(var(--color-primary-rgb,124,58,237),0.15); color: var(--color-primary);"
                  >
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
                    </svg>
                  </div>
                  <span class="text-lg">{{ link.title }}</span>
                </a>
              {% endfor %}
            {% else %}
              <a
                href="/"
                onclick="toggleMobileMenu()"
                class="flex items-center gap-4 px-4 py-4 rounded-2xl font-semibold transition-all duration-200"
                style="color: rgba(255,255,255,0.8);"
