<!-- ============================================================
     KULLANICI PROFİLİ (Purpy Remastered Dark Luxury)
     ============================================================ -->
{% assign displayUser = profileUser %}
{% if profileUser.statusCode or profileUser == blank %}
  {% assign displayUser = customer %}
{% endif %}

{% assign isOwnProfile = false %}
{% if displayUser.username == customer.username %}
  {% assign isOwnProfile = true %}
{% endif %}

{% if displayUser.username %}
  <div class="w-full max-w-[1350px] mx-auto px-4 sm:px-6 py-6 sm:py-10 min-h-[60vh]">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- SOL SÜTUN: Profil Bilgileri & Menü (4 Cols) -->
      <div class="lg:col-span-4 space-y-6">
        <!-- Profil Ana Kartı -->
        <div
          class="rounded-3xl p-8 border-2 shadow-2xl relative overflow-hidden flex flex-col items-center text-center backdrop-blur-xl"
          style="
            background: linear-gradient(135deg, rgba(26, 16, 32, 0.95), rgba(18, 10, 24, 0.95));
            border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.30);
          "
        >
          <!-- Ambient Glow Effect -->
          <div
            class="absolute top-0 right-0 w-36 h-36 rounded-full blur-3xl opacity-25 pointer-events-none"
            style="background: var(--color-primary);"
          ></div>

          <div class="relative w-32 h-32 mb-6">
            <div
              class="absolute inset-0 rounded-3xl blur-xl opacity-50"
              style="background-color: var(--color-primary);"
            ></div>
            <img
              src="https://mc-heads.net/avatar/{{ displayUser.username }}/128"
              alt="{{ displayUser.username }}"
              class="relative w-full h-full object-cover rounded-3xl shadow-2xl border-2 border-primary/50"
            >
          </div>

          {% if displayUser.role %}
            <div
              class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-xl text-xs font-black uppercase tracking-wider mb-4 border shadow-sm"
              style="background-color: {{ displayUser.role.color }}18; color: {{ displayUser.role.color }}; border-color: {{ displayUser.role.color }}40;"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              </svg>
              <span>{{ displayUser.role.name }}</span>
            </div>
          {% endif %}

          <h1 class="text-2xl sm:text-3xl font-black text-white mb-2" style="color: #ffffff !important;">{{ displayUser.username }}</h1>

          <div class="flex items-center justify-center gap-3 text-xs font-semibold text-gray-400 mt-1">
            <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
            <span>Kayıt: {{ displayUser.createdAt | date: '%d.%m.%Y' }}</span>
          </div>
        </div>

        <!-- İstatistikler -->
        <div
          class="rounded-3xl p-6 border-2 shadow-2xl backdrop-blur-xl space-y-4"
          style="
            background: linear-gradient(135deg, rgba(26, 16, 32, 0.95), rgba(18, 10, 24, 0.95));
            border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.25);
          "
        >
          <h3 class="text-base font-black text-white mb-3 flex items-center gap-2" style="color: #ffffff !important;">
            <span class="w-2 h-4 rounded-full bg-primary inline-block"></span>
            İstatistikler
          </h3>

          <div class="space-y-3">
            <div
              class="flex items-center justify-between p-4 rounded-2xl border-2"
              style="background: rgba(16, 185, 129, 0.12); border-color: rgba(16, 185, 129, 0.35);"
            >
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 flex items-center justify-center">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                </div>
                <div>
                  <div class="text-[10px] font-black uppercase tracking-wider text-emerald-300">Bakiye</div>
                  <div class="text-lg font-black text-white" style="color: #ffffff !important;">{{ displayUser.balance | default: 0 }} ₺</div>
                </div>
              </div>
            </div>
            
            {% if isOwnProfile %}
              <div
                class="flex items-center justify-between p-4 rounded-2xl border-2"
                style="background: rgba(124, 58, 237, 0.12); border-color: rgba(124, 58, 237, 0.35);"
              >
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-xl bg-primary/20 text-primary border border-primary/30 flex items-center justify-center">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
                    </svg>
                  </div>
                  <div>
                    <div class="text-[10px] font-black uppercase tracking-wider text-purple-300">Sandık Eşyaları</div>
                    <div class="text-lg font-black text-white" style="color: #ffffff !important;">{{ displayUser.chest.size | default: 0 }}</div>
                  </div>
                </div>
              </div>
            {% endif %}
          </div>
        </div>

        <!-- Navigasyon Menüsü -->
        <div
          class="rounded-3xl p-6 border-2 shadow-2xl backdrop-blur-xl"
          style="
            background: linear-gradient(135deg, rgba(26, 16, 32, 0.95), rgba(18, 10, 24, 0.95));
            border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.25);
          "
        >
          <h3 class="text-base font-black text-white mb-3 flex items-center gap-2" style="color: #ffffff !important;">
            <span class="w-2 h-4 rounded-full bg-primary inline-block"></span>
            Menü
          </h3>
          <div class="space-y-2 flex flex-col">
            <button
              class="tab-btn w-full flex items-center gap-3 p-3.5 rounded-2xl font-black text-xs uppercase tracking-wider transition-all text-left border-2 cursor-pointer shadow"
              style="background: rgba(var(--color-primary-rgb, 124, 58, 237), 0.2); color: #ffffff; border-color: var(--color-primary);"
              data-target="tab-wall"
            >
              <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z"/>
              </svg>
              <span>Profil Duvarı</span>
            </button>
            
            {% if isOwnProfile %}
              <button
                class="tab-btn w-full flex items-center gap-3 p-3.5 rounded-2xl font-bold text-xs uppercase tracking-wider transition-all text-left text-gray-400 hover:text-white hover:bg-white/5 border-2 border-transparent cursor-pointer"
                data-target="tab-inventory"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                </svg>
                <span>Envanterim</span>
              </button>
              <a
                href="/profile/settings"
                class="w-full flex items-center gap-3 p-3.5 rounded-2xl font-bold text-xs uppercase tracking-wider transition-all text-left text-gray-400 hover:text-white hover:bg-white/5 border-2 border-transparent cursor-pointer"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
                <span>Ayarlar</span>
              </a>
              <a
                href="#" onclick="logoutAccount(); return false;"
                class="w-full flex items-center gap-3 p-3.5 rounded-2xl font-bold text-xs uppercase tracking-wider transition-all text-left text-red-400 hover:text-red-300 hover:bg-red-500/10 border-2 border-transparent cursor-pointer"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                </svg>
                <span>Çıkış Yap</span>
              </a>
            {% endif %}
          </div>
        </div>
      </div>

      <!-- SAĞ SÜTUN: Tab İçerikleri (8 Cols) -->
      <div class="lg:col-span-8">
        <!-- DUVAR TABI -->
        <div
          id="tab-wall"
          class="tab-content block rounded-3xl p-6 sm:p-8 border-2 shadow-2xl backdrop-blur-xl"
          style="
            background: linear-gradient(135deg, rgba(26, 16, 32, 0.95), rgba(18, 10, 24, 0.95));
            border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.25);
          "
        >
          <h2 class="text-xl sm:text-2xl font-black text-white mb-6 flex items-center gap-3 pb-4 border-b" style="color: #ffffff !important; border-color: rgba(255, 255, 255, 0.08);">
            <div class="w-8 h-8 rounded-xl flex items-center justify-center bg-primary/20 text-primary border border-primary/40">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/>
              </svg>
            </div>
            <span>Profil Duvarı</span>
          </h2>

          <!-- Mesaj Gönderme Kutusu -->
          {% if customer %}
            <div class="flex gap-4 mb-8">
              <div class="w-12 h-12 rounded-2xl border-2 border-primary/40 overflow-hidden shrink-0 shadow-lg" style="background: rgba(14, 9, 20, 0.8);">
                <img src="https://mc-heads.net/avatar/{{ customer.username }}/48" class="w-full h-full object-cover">
              </div>
              <div class="flex-1">
                <textarea
                  id="wall-message-input"
                  placeholder="Duvara bir mesaj yazın..."
                  class="w-full min-h-[100px] p-4 rounded-2xl border-2 focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary transition-all resize-none font-medium text-white placeholder:text-gray-500 text-sm shadow-inner"
                  style="background: rgba(14, 9, 20, 0.85); border-color: rgba(255, 255, 255, 0.1);"
                ></textarea>
                <div class="flex justify-end mt-3">
                  <button
                    id="btn-send-message"
                    class="px-6 py-2.5 rounded-xl font-black text-xs uppercase tracking-wider text-white shadow-xl transition-all duration-300 hover:scale-105 border border-white/20 cursor-pointer disabled:opacity-50"
                    style="background: linear-gradient(135deg, var(--color-primary), #9333ea);"
                  >
                    Gönder
                  </button>
                </div>
              </div>
            </div>
          {% else %}
            <div class="p-6 rounded-2xl border-2 text-center mb-8"
                 style="background: rgba(14, 9, 20, 0.6); border-color: rgba(255, 255, 255, 0.08);">
              <p class="text-gray-400 font-medium text-xs mb-3">Duvara mesaj gönderebilmek için giriş yapmalısınız.</p>
              <a href="/auth/sign-in"
                 class="inline-block px-6 py-2.5 rounded-xl font-black text-xs uppercase tracking-wider text-white shadow"
                 style="background: var(--color-primary);">
                Giriş Yap
              </a>
            </div>
          {% endif %}

          <!-- Duvar Mesajları Listesi -->
          <div id="wall-messages-list" class="space-y-4">
            <div class="py-12 text-center text-gray-400 font-bold rounded-2xl border-2 border-dashed"
                 style="background: rgba(14, 9, 20, 0.4); border-color: rgba(255, 255, 255, 0.08);">
              Mesajlar Yükleniyor...
            </div>
          </div>
        </div>

        <!-- ENVANTER TABI -->
        <div
          id="tab-inventory"
          class="tab-content hidden rounded-3xl p-6 sm:p-8 border-2 shadow-2xl backdrop-blur-xl"
          style="
            background: linear-gradient(135deg, rgba(26, 16, 32, 0.95), rgba(18, 10, 24, 0.95));
            border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.25);
          "
        >
          <h2 class="text-xl sm:text-2xl font-black text-white mb-6 flex items-center gap-3 pb-4 border-b" style="color: #ffffff !important; border-color: rgba(255, 255, 255, 0.08);">
            <div class="w-8 h-8 rounded-xl flex items-center justify-center bg-primary/20 text-primary border border-primary/40">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
              </svg>
            </div>
            <span>Eşya Envanterim</span>
          </h2>

          {% if customer.chest.size > 0 %}
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
              {% for item in customer.chest %}
                {% unless item.used %}
                  <div
                    class="p-4 rounded-2xl border-2 transition-all flex flex-col items-center text-center group hover:border-primary/50 shadow-lg"
                    style="background: rgba(14, 9, 20, 0.8); border-color: rgba(255, 255, 255, 0.08);"
                  >
                    <div class="w-16 h-16 rounded-2xl flex items-center justify-center text-3xl mb-3 group-hover:-translate-y-1 transition-transform border shadow-inner"
                         style="background: rgba(255, 255, 255, 0.03); border-color: rgba(255, 255, 255, 0.08);">
                      🎁
                    </div>
                    <div class="font-black text-white text-sm line-clamp-2 mb-1" style="color: #ffffff !important;">{{ item.product.name }}</div>
                    <div class="text-[10px] font-bold text-gray-400 mt-auto">{{ item.createdAt | date: '%d.%m.%Y' }}</div>
                  </div>
                {% endunless %}
              {% endfor %}
            </div>
          {% else %}
            <div class="py-12 text-center text-gray-400 font-bold rounded-2xl border-2 border-dashed"
                 style="background: rgba(14, 9, 20, 0.4); border-color: rgba(255, 255, 255, 0.08);">
              Envanterinizde henüz bir eşya bulunmuyor.
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>

  <script>
    {% if isOwnProfile %}
      window.SERVER_WALL_MESSAGES = {{ wallMessages | json }};
    {% else %}
      window.SERVER_WALL_MESSAGES = [];
    {% endif %}
    const isOwnProfile = {{ isOwnProfile | json }};
    const targetUserId = '{{ displayUser.id }}';
    const targetUsername = '{{ displayUser.username }}';
    const currentUsername = '{{ customer.username }}';
    
    document.addEventListener('DOMContentLoaded', () => {
      const urlParams = new URLSearchParams(window.location.search);
      const discordStatus = urlParams.get('discord_status');
      const discordErr = urlParams.get('discord_error');
      if (discordStatus === 'connected') {
        showToast('Discord hesabınız başarıyla bağlandı!', 'success');
        window.history.replaceState({}, '', '/profile');
      } else if (discordErr) {
        showToast(decodeURIComponent(discordErr), 'error');
        window.history.replaceState({}, '', '/profile');
      }
      const tabBtns = document.querySelectorAll('.tab-btn');
      const tabContents = document.querySelectorAll('.tab-content');

      tabBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          tabBtns.forEach((b) => {
            b.style.background = 'transparent';
            b.style.borderColor = 'transparent';
            b.style.color = '#9ca3af';
          });

          btn.style.background = 'rgba(var(--color-primary-rgb, 124, 58, 237), 0.2)';
          btn.style.borderColor = 'var(--color-primary)';
          btn.style.color = '#ffffff';

          tabContents.forEach((c) => c.classList.add('hidden'));
          tabContents.forEach((c) => c.classList.remove('block'));

          const target = document.getElementById(btn.getAttribute('data-target'));
          if (target) {
            target.classList.remove('hidden');
            target.classList.add('block');
          }
        });
      });

      // Duvar Mesajları Mantığı
      const wallContainer = document.getElementById('wall-messages-list');
      const wallInput = document.getElementById('wall-message-input');
      const btnSend = document.getElementById('btn-send-message');

      function formatTimeAgo(dateStr) {
        const date = new Date(dateStr);
        const seconds = Math.floor((new Date() - date) / 1000);
        let interval = seconds / 31536000;
        if (interval > 1) return Math.floor(interval) + ' yıl önce';
        interval = seconds / 2592000;
        if (interval > 1) return Math.floor(interval) + ' ay önce';
        interval = seconds / 86400;
        if (interval > 1) return Math.floor(interval) + ' gün önce';
        interval = seconds / 3600;
        if (interval > 1) return Math.floor(interval) + ' saat önce';
        interval = seconds / 60;
        if (interval > 1) return Math.floor(interval) + ' dakika önce';
        return 'az önce';
      }

      function renderWallMessages(messages = window.SERVER_WALL_MESSAGES) {
        if (!targetUserId || !wallContainer) return;
        if (!Array.isArray(messages)) messages = [];
        
        try {
          wallContainer.innerHTML = '';
          if (messages.length === 0) {
            wallContainer.innerHTML = `
              <div class="py-12 text-center text-gray-400 font-bold rounded-2xl border-2 border-dashed"
                   style="background: rgba(14, 9, 20, 0.4); border-color: rgba(255, 255, 255, 0.08);">
                Henüz bu duvarda bir mesaj bulunmuyor.
              </div>
            `;
            return;
          }

          messages.forEach((msg) => {
            const isStaff = msg.sender.role && msg.sender.role.name;
            const hasReplies = msg.replies && msg.replies.length > 0;
            
            let repliesHtml = '';
            if (hasReplies) {
              repliesHtml += `
                <div class="mt-3">
                  <button class="toggle-replies-btn text-xs font-bold text-purple-300 hover:text-white transition-colors flex items-center gap-1.5 cursor-pointer" data-id="${msg.id}">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                    <span>Yanıtları Göster (${msg.replies.length})</span>
                  </button>
                  
                  <div id="replies-${msg.id}" class="hidden mt-3 ml-6 pl-4 border-l-2 border-primary/40 space-y-3">
                    ${msg.replies.map(reply => {
                      const replyStaff = reply.sender.role && reply.sender.role.name;
                      return `
                        <div class="flex items-start gap-3 p-3 rounded-xl" style="background: rgba(14, 9, 20, 0.6);">
                          <div class="w-8 h-8 rounded-xl border border-primary/30 overflow-hidden shrink-0">
                            <img src="https://mc-heads.net/avatar/${reply.sender.username}/32" class="w-full h-full object-cover">
                          </div>
                          <div class="flex-1 min-w-0">
                            <div class="flex items-center gap-2 mb-1 flex-wrap">
                              <span class="font-bold text-white text-xs" style="color: #ffffff !important;">${reply.sender.username}</span>
                              ${
                                replyStaff
                                  ? `<span class="px-1.5 py-0.2 rounded text-[9px] font-black border uppercase tracking-wider" style="color: ${reply.sender.role.color}; border-color: ${reply.sender.role.color}40; background-color: ${reply.sender.role.color}15;">${reply.sender.role.name}</span>`
                                  : ''
                              }
                              <span class="text-[10px] font-semibold text-gray-400 ml-auto">${formatTimeAgo(reply.createdAt)}</span>
                            </div>
                            <p class="text-xs font-medium text-gray-300 leading-relaxed">${reply.content}</p>
                          </div>
                        </div>
                      `;
                    }).join('')}
                  </div>
                </div>
              `;
            }

            let replyInputHtml = '';
            if (currentUsername) {
              replyInputHtml = `
                <div id="reply-form-${msg.id}" class="hidden mt-3 ml-6 flex gap-3">
                  <div class="w-8 h-8 rounded-xl border border-primary/30 overflow-hidden shrink-0">
                    <img src="https://mc-heads.net/avatar/${currentUsername}/32" class="w-full h-full object-cover">
                  </div>
                  <div class="flex-1">
                    <textarea id="reply-input-${msg.id}" placeholder="Yanıtınızı yazın..." class="w-full min-h-[60px] p-3 text-xs rounded-xl border focus:outline-none focus:ring-1 focus:ring-primary focus:border-primary transition-all resize-none font-medium text-white" style="background: rgba(14, 9, 20, 0.85); border-color: rgba(255, 255, 255, 0.1);"></textarea>
                    <div class="flex justify-end gap-2 mt-2">
                      <button class="cancel-reply-btn px-3 py-1.5 rounded-lg text-gray-400 hover:text-white font-bold text-xs" style="background: rgba(255, 255, 255, 0.05);" data-id="${msg.id}">İptal</button>
                      <button class="send-reply-btn px-4 py-1.5 rounded-lg text-white font-bold text-xs shadow" style="background: var(--color-primary);" data-id="${msg.id}">Yanıtla</button>
                    </div>
                  </div>
                </div>
              `;
            }

            const html = `
              <div class="p-5 rounded-2xl border-2 transition-all"
                   style="background: rgba(14, 9, 20, 0.8); border-color: rgba(255, 255, 255, 0.08);">
                <div class="flex items-start gap-4">
                  <div class="w-10 h-10 rounded-2xl border-2 border-primary/40 overflow-hidden shrink-0 shadow">
                    <img src="https://mc-heads.net/avatar/${msg.sender.username}/40" class="w-full h-full object-cover">
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-2 mb-1 flex-wrap">
                      <span class="font-black text-white text-sm" style="color: #ffffff !important;">${msg.sender.username}</span>
                      ${
                        isStaff
                          ? `<span class="px-2 py-0.5 rounded text-[10px] font-black border uppercase tracking-wider" style="color: ${msg.sender.role.color}; border-color: ${msg.sender.role.color}40; background-color: ${msg.sender.role.color}15;">${msg.sender.role.name}</span>`
                          : ''
                      }
                      <span class="text-xs font-semibold text-gray-400 ml-auto">${formatTimeAgo(msg.createdAt)}</span>
                    </div>
                    <p class="text-xs sm:text-sm font-medium text-gray-200 mb-2 leading-relaxed">${msg.content}</p>
                    
                    ${currentUsername ? `
                      <button class="reply-btn text-xs font-bold text-purple-300 hover:text-white transition-colors flex items-center gap-1 cursor-pointer" data-id="${msg.id}">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"/></svg>
                        <span>Yanıtla</span>
                      </button>
                    ` : ''}
                    
                    ${repliesHtml}
                    ${replyInputHtml}
                  </div>
                </div>
              </div>
            `;
            wallContainer.insertAdjacentHTML('beforeend', html);
          });
        } catch (err) {
          console.error(err);
          wallContainer.innerHTML =
            '<div class="py-12 text-center text-red-400 font-bold rounded-2xl">Mesajlar yüklenemedi.</div>';
        }
      }

      async function fetchWallMessages() {
        if (!targetUserId) return;
        try {
          const res = await fetch(`/api/storefront/v2/users/${targetUserId}/wall`);
          const data = await res.json();
          const messages = data.data || data || [];
          renderWallMessages(messages);
        } catch (err) {
          console.error(err);
        }
      }

      if (btnSend) {
        btnSend.addEventListener('click', async () => {
          const content = wallInput.value.trim();
          if (!content) return;

          btnSend.disabled = true;
          btnSend.innerText = 'Gönderiliyor...';

          try {
            await fetch(`/api/storefront/v2/users/${targetUserId}/wall`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ content }),
            });
            wallInput.value = '';
            fetchWallMessages();
          } catch (err) {
            console.error(err);
            window.showToast?.('Mesaj gönderilirken hata oluştu.', 'error');
          } finally {
            btnSend.disabled = false;
            btnSend.innerText = 'Gönder';
          }
        });
      }

      wallContainer?.addEventListener('click', async (e) => {
        const target = e.target.closest('button');
        if (!target) return;

        const msgId = target.getAttribute('data-id');
        
        if (target.classList.contains('toggle-replies-btn')) {
          const repliesDiv = document.getElementById(`replies-${msgId}`);
          if (repliesDiv) {
            if (repliesDiv.classList.contains('hidden')) {
              repliesDiv.classList.remove('hidden');
              target.innerHTML = `<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"/></svg> <span>Yanıtları Gizle</span>`;
            } else {
              repliesDiv.classList.add('hidden');
              const replyCount = repliesDiv.children.length;
              target.innerHTML = `<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg> <span>Yanıtları Göster (${replyCount})</span>`;
            }
          }
        }

        if (target.classList.contains('reply-btn')) {
          document.querySelectorAll('[id^="reply-form-"]').forEach(f => f.classList.add('hidden'));
          
          const replyForm = document.getElementById(`reply-form-${msgId}`);
          if (replyForm) {
            replyForm.classList.remove('hidden');
            const input = document.getElementById(`reply-input-${msgId}`);
            if(input) input.focus();
          }
        }

        if (target.classList.contains('cancel-reply-btn')) {
          const replyForm = document.getElementById(`reply-form-${msgId}`);
          if (replyForm) {
            replyForm.classList.add('hidden');
            document.getElementById(`reply-input-${msgId}`).value = '';
          }
        }

        if (target.classList.contains('send-reply-btn')) {
          const input = document.getElementById(`reply-input-${msgId}`);
          const content = input.value.trim();
          if (!content) return;

          target.disabled = true;
          target.innerText = '...';

          try {
            await fetch(`/api/storefront/v2/users/${targetUserId}/wall/${msgId}/reply`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ content }),
            });
            input.value = '';
            fetchWallMessages();
          } catch (err) {
            console.error(err);
            window.showToast?.('Yanıt gönderilemedi.', 'error');
          } finally {
            target.disabled = false;
            target.innerText = 'Yanıtla';
          }
        }
      });

      if (isOwnProfile && Array.isArray(window.SERVER_WALL_MESSAGES) && window.SERVER_WALL_MESSAGES.length >= 0) {
        renderWallMessages();
      } else {
        fetchWallMessages();
      }
    });
  </script>
{% else %}
  <div class="w-full max-w-[1350px] mx-auto px-4 sm:px-6 py-16 min-h-[60vh] flex items-center justify-center">
    <div
      class="rounded-3xl border-2 shadow-2xl p-10 max-w-lg w-full text-center backdrop-blur-xl"
      style="
        background: linear-gradient(135deg, rgba(26, 16, 32, 0.95), rgba(18, 10, 24, 0.95));
        border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.25);
      "
    >
      <div
        class="w-20 h-20 mx-auto rounded-3xl flex items-center justify-center mb-6 shadow-2xl border"
        style="
          background: rgba(var(--color-primary-rgb, 124, 58, 237), 0.15);
          border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.35);
          color: var(--color-primary);
        "
      >
        <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
        </svg>
      </div>
      <h2 class="text-2xl sm:text-3xl font-black text-white mb-2" style="color: #ffffff !important;">Giriş Yapmalısınız</h2>
      <p class="text-xs sm:text-sm font-medium text-gray-300 mb-8 max-w-md mx-auto">
        Profilinizi görüntülemek için lütfen hesabınıza giriş yapın.
      </p>
      <a
        href="/auth/sign-in?return=/profile"
        class="w-full py-4 rounded-2xl font-black text-sm uppercase tracking-wider text-white shadow-2xl transition-all duration-300 hover:scale-[1.02] flex items-center justify-center gap-2 border border-white/20"
        style="
          background: linear-gradient(135deg, var(--color-primary), #9333ea);
          box-shadow: 0 10px 30px rgba(var(--color-primary-rgb, 124, 58, 237), 0.45);
        "
      >
        Giriş Yap
      </a>
    </div>
  </div>
{% endif %}
