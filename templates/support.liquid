<!-- ============================================================
     DESTEK MERKEZİ (Purpy Remastered Dark Luxury)
     ============================================================ -->
<div class="w-full max-w-[1350px] mx-auto px-4 sm:px-6 py-6 sm:py-10 space-y-8 min-h-[60vh]">
  <!-- Breadcrumb -->
  <div
    class="flex flex-wrap items-center gap-2 text-xs sm:text-sm font-semibold px-4 py-2.5 rounded-2xl border backdrop-blur-md w-fit shadow-lg"
    style="
      background: linear-gradient(135deg, rgba(26, 16, 32, 0.85), rgba(18, 10, 24, 0.85));
      border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.25);
    "
  >
    <a href="/" class="hover:text-primary transition-colors flex items-center gap-1.5" style="color: #cbd5e1;">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
      </svg>
    </a>
    <span class="text-gray-500">/</span>
    <span class="font-bold" style="color: var(--color-primary);">Destek Merkezi</span>
  </div>

  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6 pb-2 border-b" style="border-color: rgba(255, 255, 255, 0.08);">
    <div class="flex items-center gap-3.5">
      <div class="w-2 h-10 rounded-full" style="background: linear-gradient(to bottom, var(--color-primary), #9333ea);"></div>
      <div>
        <h1 class="text-2xl sm:text-3xl font-black text-white uppercase tracking-wide" style="color: #ffffff !important;">
          Destek Taleplerim
        </h1>
        <p class="text-xs sm:text-sm font-medium text-gray-300">
          Yardıma ihtiyacınız olan konularda uzman destek ekibimizle anında iletişime geçin.
        </p>
      </div>
    </div>

    {% if customer %}
      <a
        href="/support/new"
        class="inline-flex items-center gap-2 px-6 py-3.5 rounded-2xl font-black text-xs uppercase tracking-wider text-white shadow-2xl transition-all duration-300 hover:scale-105 border border-white/20"
        style="background: linear-gradient(135deg, var(--color-primary), #9333ea);"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/>
        </svg>
        <span>Yeni Talep Oluştur</span>
      </a>
    {% endif %}
  </div>

  <!-- Main Layout -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- SOL: Sidebar (4 Cols) -->
    <aside class="lg:col-span-4 space-y-6">
      {% if customer %}
        <!-- User Info -->
        <div
          class="rounded-3xl border-2 shadow-2xl p-6 backdrop-blur-xl"
          style="
            background: linear-gradient(135deg, rgba(26, 16, 32, 0.95), rgba(18, 10, 24, 0.95));
            border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.25);
          "
        >
          <div class="flex items-center gap-4 mb-4">
            <img
              src="https://mc-heads.net/avatar/{{ customer.username }}/48"
              class="w-12 h-12 rounded-2xl border-2 border-primary/40 shadow-lg"
              alt=""
            >
            <div>
              <div class="font-black text-white text-base" style="color: #ffffff !important;">{{ customer.username }}</div>
              <div class="text-xs font-semibold text-purple-300">Oyuncu</div>
            </div>
          </div>
          <a
            href="/profile"
            class="w-full block text-center py-2.5 rounded-xl text-xs font-bold uppercase tracking-wider text-gray-300 hover:text-white border border-white/10 hover:border-primary/40 transition-all"
            style="background: rgba(255, 255, 255, 0.05);"
          >
            Profile Git
          </a>
        </div>
      {% endif %}

      <!-- Filters -->
      <div
        class="rounded-3xl border-2 shadow-2xl p-6 backdrop-blur-xl"
        style="
          background: linear-gradient(135deg, rgba(26, 16, 32, 0.95), rgba(18, 10, 24, 0.95));
          border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.25);
        "
      >
        <h3 class="font-black text-white mb-4 text-sm flex items-center gap-2" style="color: #ffffff !important;">
          <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"/>
          </svg>
          <span>Durum Filtresi</span>
        </h3>

        <div class="space-y-1.5 flex flex-col" id="statusFilters">
          <button
            data-status="ALL"
            class="filter-btn w-full text-left px-3.5 py-2.5 rounded-xl text-xs font-black uppercase tracking-wider transition-all border shadow flex justify-between items-center cursor-pointer"
            style="background: rgba(var(--color-primary-rgb, 124, 58, 237), 0.25); color: #ffffff; border-color: var(--color-primary);"
          >
            <span>Tümü</span>
            <span class="px-2 py-0.5 rounded-md text-[11px] font-black" style="background: rgba(255, 255, 255, 0.15);" id="count-ALL">0</span>
          </button>
          <button
            data-status="OPEN"
            class="filter-btn w-full text-left px-3.5 py-2.5 rounded-xl text-xs font-bold transition-all border border-transparent text-gray-400 hover:text-white hover:bg-white/5 flex justify-between items-center cursor-pointer"
          >
            <span>Açık</span>
            <span class="px-2 py-0.5 rounded-md text-[11px] font-bold" style="background: rgba(16, 185, 129, 0.15); color: #6ee7b7;" id="count-OPEN">0</span>
          </button>
          <button
            data-status="REPLIED"
            class="filter-btn w-full text-left px-3.5 py-2.5 rounded-xl text-xs font-bold transition-all border border-transparent text-gray-400 hover:text-white hover:bg-white/5 flex justify-between items-center cursor-pointer"
          >
            <span>Yanıtlandı</span>
            <span class="px-2 py-0.5 rounded-md text-[11px] font-bold" style="background: rgba(59, 130, 246, 0.15); color: #93c5fd;" id="count-REPLIED">0</span>
          </button>
          <button
            data-status="CLOSED"
            class="filter-btn w-full text-left px-3.5 py-2.5 rounded-xl text-xs font-bold transition-all border border-transparent text-gray-400 hover:text-white hover:bg-white/5 flex justify-between items-center cursor-pointer"
          >
            <span>Kapalı</span>
            <span class="px-2 py-0.5 rounded-md text-[11px] font-bold" style="background: rgba(255, 255, 255, 0.08); color: #9ca3af;" id="count-CLOSED">0</span>
          </button>
        </div>
      </div>

      <!-- Info Box -->
      <div
        class="rounded-3xl border-2 shadow-2xl p-6 backdrop-blur-xl space-y-3"
        style="
          background: linear-gradient(135deg, rgba(28, 16, 38, 0.95), rgba(18, 10, 24, 0.95));
          border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.30);
        "
      >
        <h4 class="font-black text-white text-sm flex items-center gap-2" style="color: #ffffff !important;">
          <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <span>Önemli Bilgilendirme</span>
        </h4>
        <p class="text-xs text-gray-300 leading-relaxed font-medium">
          Destek taleplerinize ortalama <span class="font-black text-purple-300">12-24 saat</span> içerisinde dönüş yapılmaktadır. Lütfen mükerrer talep açmaktan kaçının.
        </p>
      </div>
    </aside>

    <!-- SAĞ: Talepler Listesi (8 Cols) -->
    <main class="lg:col-span-8">
      {% if customer %}
        <div
          class="rounded-3xl border-2 shadow-2xl overflow-hidden relative min-h-[400px] backdrop-blur-xl"
          style="
            background: linear-gradient(135deg, rgba(26, 16, 32, 0.95), rgba(18, 10, 24, 0.95));
            border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.25);
          "
        >
          <!-- Empty State -->
          <div
            id="tickets-empty"
            class="hidden absolute inset-0 z-10 flex-col items-center justify-center p-8 text-center"
            style="background: rgba(18, 10, 24, 0.98);"
          >
            <div class="w-16 h-16 rounded-3xl flex items-center justify-center mb-4 border"
                 style="background: rgba(var(--color-primary-rgb, 124, 58, 237), 0.15); border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.35); color: var(--color-primary);">
              <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/>
              </svg>
            </div>
            <h3 class="text-xl font-black text-white mb-1" style="color: #ffffff !important;">Gösterilecek Talep Yok</h3>
            <p class="text-xs text-gray-400 font-medium max-w-sm mb-6">
              Bu filtreye uygun herhangi bir destek talebi bulunamadı.
            </p>
            <a
              href="/support/new"
              class="px-6 py-3 rounded-2xl font-black text-xs uppercase tracking-wider text-white shadow-xl transition-all duration-300 hover:scale-105 border border-white/20"
              style="background: linear-gradient(135deg, var(--color-primary), #9333ea);"
            >
              Yeni Talep Oluştur
            </a>
          </div>

          <!-- Tickets List -->
          <div id="tickets-list" class="hidden flex-col divide-y" style="border-color: rgba(255, 255, 255, 0.08);">
            <!-- Populated by JS -->
          </div>
        </div>
      {% else %}
        <!-- Guest Notice -->
        <div
          class="rounded-3xl border-2 shadow-2xl p-10 flex flex-col items-center text-center backdrop-blur-xl"
          style="
            background: linear-gradient(135deg, rgba(26, 16, 32, 0.95), rgba(18, 10, 24, 0.95));
            border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.25);
          "
        >
          <div class="w-16 h-16 rounded-3xl flex items-center justify-center mb-4 border"
               style="background: rgba(var(--color-primary-rgb, 124, 58, 237), 0.15); border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.35); color: var(--color-primary);">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
            </svg>
          </div>
          <h3 class="text-2xl font-black text-white mb-2" style="color: #ffffff !important;">Giriş Yapmalısınız</h3>
          <p class="text-xs sm:text-sm text-gray-300 font-medium max-w-md mb-8">
            Destek taleplerinizi görüntülemek veya yeni talep oluşturmak için hesabınıza giriş yapın.
          </p>
          <a
            href="/auth/sign-in?return=/support"
            class="px-8 py-3.5 rounded-2xl font-black text-xs uppercase tracking-wider text-white shadow-2xl transition-all duration-300 hover:scale-105 border border-white/20"
            style="background: linear-gradient(135deg, var(--color-primary), #9333ea);"
          >
            Giriş Yap
          </a>
        </div>
      {% endif %}
    </main>
  </div>
</div>

<script>
  let allTickets = [];
  let currentFilter = 'ALL';

  function formatDate(isoStr) {
    const d = new Date(isoStr);
    return d.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit' });
  }

  function getStatusBadge(status) {
    if (status === 'OPEN') return '<span class="px-3 py-1 bg-emerald-500/20 text-emerald-300 rounded-xl text-xs font-black uppercase tracking-wider border border-emerald-500/40 shadow">Açık</span>';
    if (status === 'REPLIED') return '<span class="px-3 py-1 bg-blue-500/20 text-blue-300 rounded-xl text-xs font-black uppercase tracking-wider border border-blue-500/40 shadow">Yanıtlandı</span>';
    if (status === 'CLOSED') return '<span class="px-3 py-1 bg-white/5 text-gray-400 rounded-xl text-xs font-bold uppercase tracking-wider border border-white/10">Kapalı</span>';
    return `<span class="px-3 py-1 bg-white/5 text-gray-400 rounded-xl text-xs font-bold uppercase tracking-wider border border-white/10">${status}</span>`;
  }

  function updateCounts() {
    const counts = { ALL: allTickets.length, OPEN: 0, REPLIED: 0, CLOSED: 0 };
    allTickets.forEach(t => {
      if (counts[t.status] !== undefined) counts[t.status]++;
    });
    
    document.getElementById('count-ALL').innerText = counts.ALL;
    document.getElementById('count-OPEN').innerText = counts.OPEN;
    document.getElementById('count-REPLIED').innerText = counts.REPLIED;
    document.getElementById('count-CLOSED').innerText = counts.CLOSED;
  }

  function renderTickets() {
    const listEl = document.getElementById('tickets-list');
    const emptyEl = document.getElementById('tickets-empty');
    if (!listEl || !emptyEl) return;
    
    let filtered = allTickets;
    if (currentFilter !== 'ALL') {
      filtered = allTickets.filter(t => t.status === currentFilter);
    }
    
    if (filtered.length === 0) {
      listEl.classList.add('hidden');
      listEl.classList.remove('flex');
      emptyEl.classList.remove('hidden');
      emptyEl.classList.add('flex');
    } else {
      emptyEl.classList.add('hidden');
      emptyEl.classList.remove('flex');
      listEl.classList.remove('hidden');
      listEl.classList.add('flex');
      
      listEl.innerHTML = filtered.map(t => `
        <a href="/support/${t.id}" class="group block p-5 hover:bg-white/5 transition-all" style="border-bottom: 1px solid rgba(255, 255, 255, 0.06);">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-2xl flex items-center justify-center text-purple-300 border border-primary/30 group-hover:border-primary/60 group-hover:scale-105 transition-all shrink-0 shadow-lg"
                   style="background: rgba(var(--color-primary-rgb, 124, 58, 237), 0.15);">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              </div>
              <div>
                <h4 class="text-sm sm:text-base font-black text-white group-hover:text-primary transition-colors line-clamp-1" style="color: #ffffff !important;">${t.title}</h4>
                <div class="flex items-center gap-2 mt-1 text-xs font-semibold text-gray-400">
                  <span class="uppercase tracking-wider font-mono text-purple-300">#${t.id.substring(0,6)}</span>
                  <span>•</span>
                  <span>${formatDate(t.createdAt)}</span>
                </div>
              </div>
            </div>
            <div class="flex items-center justify-between sm:justify-end gap-4 shrink-0">
              ${getStatusBadge(t.status)}
              <svg class="w-5 h-5 text-gray-500 group-hover:text-primary transition-colors group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </div>
          </div>
        </a>
      `).join('');
    }
  }

  function initTickets() {
    allTickets = {{ tickets | json }} || [];
    allTickets.sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt));
    updateCounts();
    renderTickets();
  }

  document.querySelectorAll('#statusFilters .filter-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      document.querySelectorAll('#statusFilters .filter-btn').forEach(b => {
        b.style.background = 'transparent';
        b.style.borderColor = 'transparent';
        b.style.color = '#9ca3af';
      });
      
      const clicked = e.currentTarget;
      clicked.style.background = 'rgba(var(--color-primary-rgb, 124, 58, 237), 0.25)';
      clicked.style.borderColor = 'var(--color-primary)';
      clicked.style.color = '#ffffff';
      
      currentFilter = clicked.dataset.status;
      renderTickets();
    });
  });

  initTickets();
</script>
