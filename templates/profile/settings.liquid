<!-- ============================================================
     PROFİL AYARLARI (Purpy Remastered Dark Luxury)
     ============================================================ -->
{% if customer %}
  <div class="w-full max-w-[1350px] mx-auto px-4 sm:px-6 py-6 sm:py-10 min-h-[60vh]">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- SOL SÜTUN: Profil Bilgileri ve Navigasyon (4 Cols) -->
      <div class="lg:col-span-4 space-y-6">
        <!-- Profil Kartı -->
        <div
          class="rounded-3xl p-8 border-2 shadow-2xl relative overflow-hidden flex flex-col items-center text-center backdrop-blur-xl"
          style="
            background: linear-gradient(135deg, rgba(26, 16, 32, 0.95), rgba(18, 10, 24, 0.95));
            border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.30);
          "
        >
          <div class="relative w-28 h-28 mb-4">
            <div
              class="absolute inset-0 rounded-3xl blur-xl opacity-50"
              style="background-color: var(--color-primary);"
            ></div>
            <img
              src="https://mc-heads.net/avatar/{{ customer.username }}/128"
              alt="{{ customer.username }}"
              class="relative w-full h-full object-cover rounded-3xl shadow-2xl border-2 border-primary/50"
            >
          </div>

          {% if customer.role %}
            <div
              class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-xl text-xs font-black uppercase tracking-wider mb-3 border shadow-sm"
              style="background-color: {{ customer.role.color }}18; color: {{ customer.role.color }}; border-color: {{ customer.role.color }}40;"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              </svg>
              <span>{{ customer.role.name }}</span>
            </div>
          {% endif %}

          <h1 class="text-2xl font-black text-white mb-1" style="color: #ffffff !important;">{{ customer.username }}</h1>
          <div class="text-xs font-semibold text-gray-400">
            Kayıt: {{ customer.createdAt | date: '%d.%m.%Y' }}
          </div>
        </div>

        <!-- Navigasyon -->
        <div
          class="rounded-3xl p-6 border-2 shadow-2xl backdrop-blur-xl"
          style="
            background: linear-gradient(135deg, rgba(26, 16, 32, 0.95), rgba(18, 10, 24, 0.95));
            border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.25);
          "
        >
          <h3 class="text-base font-black text-white mb-3 flex items-center gap-2" style="color: #ffffff !important;">
            <span class="w-2 h-4 rounded-full bg-primary inline-block"></span>
            Menü
          </h3>
          <div class="space-y-2 flex flex-col">
            <a
              href="/profile"
              class="w-full flex items-center gap-3 p-3.5 rounded-2xl font-bold text-xs uppercase tracking-wider transition-all text-left text-gray-400 hover:text-white hover:bg-white/5 border-2 border-transparent cursor-pointer"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z"/>
              </svg>
              <span>Profil Duvarı</span>
            </a>
            <a
              href="/profile?tab=inventory"
              class="w-full flex items-center gap-3 p-3.5 rounded-2xl font-bold text-xs uppercase tracking-wider transition-all text-left text-gray-400 hover:text-white hover:bg-white/5 border-2 border-transparent cursor-pointer"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
              </svg>
              <span>Envanterim</span>
            </a>
            <a
              href="/profile/settings"
              class="w-full flex items-center gap-3 p-3.5 rounded-2xl font-black text-xs uppercase tracking-wider transition-all text-left border-2 cursor-pointer shadow"
              style="background: rgba(var(--color-primary-rgb, 124, 58, 237), 0.2); color: #ffffff; border-color: var(--color-primary);"
            >
              <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              <span>Ayarlar</span>
            </a>
            <a
              href="#" onclick="logoutAccount(); return false;"
              class="w-full flex items-center gap-3 p-3.5 rounded-2xl font-bold text-xs uppercase tracking-wider transition-all text-left text-red-400 hover:text-red-300 hover:bg-red-500/10 border-2 border-transparent cursor-pointer"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
              </svg>
              <span>Çıkış Yap</span>
            </a>
          </div>
        </div>
      </div>

      <!-- SAĞ SÜTUN: Ayarlar İçeriği (8 Cols) -->
      <div class="lg:col-span-8 space-y-6">
        <!-- SEKME BUTONLARI -->
        <div class="flex items-center gap-3 p-2 rounded-2xl border-2 backdrop-blur-xl overflow-x-auto"
             style="background: linear-gradient(135deg, rgba(26, 16, 32, 0.95), rgba(18, 10, 24, 0.95)); border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.25);">
          <button
            type="button"
            onclick="switchSettingsTab('tab-general')"
            id="tab-btn-general"
            class="settings-tab-btn flex-1 py-3 px-5 rounded-xl font-black text-xs uppercase tracking-wider transition-all flex items-center justify-center gap-2 cursor-pointer bg-primary text-white shadow-lg"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
            <span>Genel Ayarlar</span>
          </button>
          <button
            type="button"
            onclick="switchSettingsTab('tab-discord')"
            id="tab-btn-discord"
            class="settings-tab-btn flex-1 py-3 px-5 rounded-xl font-bold text-xs uppercase tracking-wider transition-all flex items-center justify-center gap-2 cursor-pointer text-gray-400 hover:text-white"
          >
            <i class="fa-brands fa-discord text-base"></i>
            <span>Discord Hesabı</span>
          </button>
          <button
            type="button"
            onclick="switchSettingsTab('tab-2fa')"
            id="tab-btn-2fa"
            class="settings-tab-btn flex-1 py-3 px-5 rounded-xl font-bold text-xs uppercase tracking-wider transition-all flex items-center justify-center gap-2 cursor-pointer text-gray-400 hover:text-white"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
            <span>2FA Güvenlik</span>
          </button>
        </div>

        <!-- TAB 1: GENEL AYARLAR -->
        <div
          id="tab-general"
          class="settings-content rounded-3xl p-6 sm:p-8 border-2 shadow-2xl backdrop-blur-xl"
          style="
            background: linear-gradient(135deg, rgba(26, 16, 32, 0.95), rgba(18, 10, 24, 0.95));
            border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.25);
          "
        >
          <h2 class="text-xl sm:text-2xl font-black text-white mb-6 flex items-center gap-3 pb-4 border-b" style="color: #ffffff !important; border-color: rgba(255, 255, 255, 0.08);">
            <div class="w-8 h-8 rounded-xl flex items-center justify-center bg-primary/20 text-primary border border-primary/40">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
            </div>
            <span>Hesap Bilgileri</span>
          </h2>

          <!-- Başarı Mesajı -->
          <div
            id="settings-success"
            class="hidden mb-6 p-4 rounded-2xl border flex items-center gap-3"
            style="background: rgba(16, 185, 129, 0.15); border-color: rgba(16, 185, 129, 0.4); color: #6ee7b7;"
          >
            <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
            <span class="text-xs sm:text-sm font-bold">Değişiklikleriniz başarıyla kaydedildi!</span>
          </div>
          
          <!-- Hata Mesajı -->
          <div
            id="settings-error"
            class="hidden mb-6 p-4 rounded-2xl border flex items-center gap-3"
            style="background: rgba(239, 68, 68, 0.15); border-color: rgba(239, 68, 68, 0.4); color: #fca5a5;"
          >
            <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <span id="settings-error-text" class="text-xs sm:text-sm font-bold">Bir hata oluştu.</span>
          </div>

          <form id="settings-form" class="space-y-6 max-w-lg">
            <div>
              <label class="block text-xs font-black uppercase tracking-wider text-purple-300 mb-2">Kullanıcı Adı</label>
              <input
                type="text"
                value="{{ customer.username }}"
                disabled
                class="w-full px-4 py-3.5 rounded-2xl border-2 font-mono font-bold text-sm text-gray-400 cursor-not-allowed"
                style="background: rgba(14, 9, 20, 0.5); border-color: rgba(255, 255, 255, 0.08);"
              >
              <p class="text-[11px] text-gray-400 mt-1.5 font-medium">Kullanıcı adı sistem tarafından sabit tutulur.</p>
            </div>

            <div>
              <label class="block text-xs font-black uppercase tracking-wider text-purple-300 mb-2">E-posta Adresi</label>
              <input
                type="email"
                id="input-email"
                value="{{ customer.email }}"
                required
                class="w-full px-4 py-3.5 rounded-2xl border-2 focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary transition-all font-medium text-white text-sm shadow-inner"
                style="background: rgba(14, 9, 20, 0.85); border-color: rgba(255, 255, 255, 0.1);"
              >
            </div>

            <div class="pt-6 border-t" style="border-color: rgba(255, 255, 255, 0.08);">
              <h4 class="text-base font-black text-white mb-2" style="color: #ffffff !important;">Şifre Değiştir</h4>
              <p class="text-xs text-gray-400 mb-4 font-medium">Şifrenizi değiştirmek istemiyorsanız bu alanları boş bırakabilirsiniz.</p>

              <div class="space-y-4">
                <div>
                  <label class="block text-xs font-black uppercase tracking-wider text-purple-300 mb-2">Mevcut Şifre</label>
                  <input
                    type="password"
                    id="input-current-password"
                    placeholder="••••••••"
                    class="w-full px-4 py-3.5 rounded-2xl border-2 focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary transition-all font-medium text-white text-sm shadow-inner"
                    style="background: rgba(14, 9, 20, 0.85); border-color: rgba(255, 255, 255, 0.1);"
                  >
                </div>
                <div>
                  <label class="block text-xs font-black uppercase tracking-wider text-purple-300 mb-2">Yeni Şifre</label>
                  <input
                    type="password"
                    id="input-new-password"
                    placeholder="••••••••"
                    class="w-full px-4 py-3.5 rounded-2xl border-2 focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary transition-all font-medium text-white text-sm shadow-inner"
                    style="background: rgba(14, 9, 20, 0.85); border-color: rgba(255, 255, 255, 0.1);"
                  >
                </div>
              </div>
            </div>

            <div class="pt-4">
              <button
                type="submit"
                id="btn-save-settings"
                class="px-8 py-3.5 rounded-2xl font-black text-xs uppercase tracking-wider text-white shadow-2xl transition-all duration-300 hover:scale-105 border border-white/20 cursor-pointer disabled:opacity-50"
                style="
                  background: linear-gradient(135deg, var(--color-primary), #9333ea);
                  box-shadow: 0 10px 25px rgba(var(--color-primary-rgb, 124, 58, 237), 0.4);
                "
              >
                Değişiklikleri Kaydet
              </button>
            </div>
          </form>
        </div>

        <!-- TAB 2: DISCORD HESABI -->
        <div
          id="tab-discord"
          class="settings-content hidden rounded-3xl p-6 sm:p-8 border-2 shadow-2xl backdrop-blur-xl"
          style="
            background: linear-gradient(135deg, rgba(26, 16, 32, 0.95), rgba(18, 10, 24, 0.95));
            border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.25);
          "
        >
          <div class="flex items-center justify-between mb-6 pb-4 border-b border-purple-900/30">
            <h2 class="text-xl sm:text-2xl font-black text-white flex items-center gap-3">
              <i class="fa-brands fa-discord text-[#5865F2]"></i>
              <span>Discord Entegrasyonu</span>
            </h2>
            <div id="discordStatusBadge" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-gray-900 text-gray-400 border border-purple-900/40">
              Yükleniyor...
            </div>
          </div>

          <p class="text-sm font-medium text-gray-400 mb-8 leading-relaxed">
            Discord hesabınızı bağlayarak tek tıkla hızlı giriş yapabilir, sunucumuzdaki rollerinizi otomatik eşitleyebilir ve 2FA güvenliğini Discord DM üzerinden sağlayabilirsiniz.
          </p>

          <div class="p-6 rounded-2xl border-2 border-purple-900/40 bg-gray-950/60 mb-6 flex flex-col sm:flex-row items-center gap-4">
            <div class="w-16 h-16 rounded-2xl bg-gray-900 border border-purple-900/40 flex items-center justify-center overflow-hidden shrink-0">
              <img id="discordAvatar" src="" class="w-full h-full object-cover hidden" alt="Discord Avatar">
              <i id="discordDefaultIcon" class="fa-brands fa-discord text-3xl text-gray-500"></i>
            </div>
            <div class="flex-grow text-center sm:text-left min-w-0">
              <div id="discordUsernameText" class="font-black text-white text-base truncate">Discord Bağlı Değil</div>
              <div id="discordSubText" class="text-xs text-gray-400 mt-0.5">Hesabınızı şimdi bağlayın</div>
            </div>
            <div id="discordActionBtnContainer" class="shrink-0">
              <button
                type="button"
                id="btnDiscordConnect"
                onclick="connectDiscord()"
                class="px-6 py-3 bg-[#5865F2] hover:bg-[#4752C4] text-white text-xs font-black uppercase tracking-wider rounded-xl transition-all shadow-lg flex items-center gap-2 cursor-pointer"
              >
                <i class="fa-brands fa-discord"></i>
                <span>Discord'u Bağla</span>
              </button>
            </div>
          </div>
        </div>

        <!-- TAB 3: 2FA GÜVENLİK -->
        <div
          id="tab-2fa"
          class="settings-content hidden rounded-3xl p-6 sm:p-8 border-2 shadow-2xl backdrop-blur-xl"
          style="
            background: linear-gradient(135deg, rgba(26, 16, 32, 0.95), rgba(18, 10, 24, 0.95));
            border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.25);
          "
        >
          <div class="flex items-center justify-between mb-6 pb-4 border-b border-purple-900/30">
            <h2 class="text-xl sm:text-2xl font-black text-white flex items-center gap-3">
              <svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
              <span>İki Aşamalı Doğrulama (2FA)</span>
            </h2>
            <div id="twofaOverallBadge" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-gray-900 text-gray-400 border border-purple-900/40">
              Yükleniyor...
            </div>
          </div>

          <p class="text-sm font-medium text-gray-400 mb-8 leading-relaxed">
            Hesabınızı yetkisiz erişimlere karşı korumak için 2FA doğrulamayı aktifleştirin.
          </p>

          <div class="space-y-4 mb-8">
            <!-- Authenticator -->
            <div class="p-5 rounded-2xl border border-purple-900/40 bg-gray-950/60 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-xl bg-purple-900/30 text-purple-400 border border-purple-500/30 flex items-center justify-center shrink-0">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                </div>
                <div>
                  <div class="flex items-center gap-2">
                    <h4 class="font-black text-white text-sm">Authenticator Uygulaması</h4>
                    <span id="badgeAuthenticator" class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-gray-800 text-gray-400">Kapalı</span>
                  </div>
                  <p class="text-xs text-gray-400 mt-0.5">Google Authenticator veya Authy uygulaması.</p>
                </div>
              </div>
              <div id="actionAuthenticator" class="shrink-0">
                <button type="button" onclick="startAuthenticatorSetup()" class="px-4 py-2.5 bg-purple-600 hover:bg-purple-500 text-white font-bold text-xs rounded-xl shadow cursor-pointer">Kurulum Yap</button>
              </div>
            </div>

            <!-- Email 2FA -->
            <div class="p-5 rounded-2xl border border-purple-900/40 bg-gray-950/60 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-xl bg-amber-900/30 text-amber-400 border border-amber-500/30 flex items-center justify-center shrink-0">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                </div>
                <div>
                  <div class="flex items-center gap-2">
                    <h4 class="font-black text-white text-sm">E-Posta Doğrulama</h4>
                    <span id="badgeEmail2Fa" class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-gray-800 text-gray-400">Kapalı</span>
                  </div>
                  <p class="text-xs text-gray-400 mt-0.5">Her girişte e-postanıza 6 haneli kod gönderilir.</p>
                </div>
              </div>
              <div id="actionEmail2Fa" class="shrink-0">
                <button type="button" onclick="startEmail2FaSetup()" class="px-4 py-2.5 bg-amber-600 hover:bg-amber-500 text-white font-bold text-xs rounded-xl shadow cursor-pointer">Aktifleştir</button>
              </div>
            </div>

            <!-- Discord 2FA -->
            <div class="p-5 rounded-2xl border border-purple-900/40 bg-gray-950/60 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-xl bg-[#5865F2]/20 text-[#5865F2] border border-[#5865F2]/40 flex items-center justify-center shrink-0">
                  <i class="fa-brands fa-discord text-2xl"></i>
                </div>
                <div>
                  <div class="flex items-center gap-2">
                    <h4 class="font-black text-white text-sm">Discord Hesabı ile Doğrulama</h4>
                    <span id="badgeDiscord2Fa" class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-gray-800 text-gray-400">Kapalı</span>
                  </div>
                  <p class="text-xs text-gray-400 mt-0.5" id="discord2FaSubText">Giriş yaparken Discord botumuz DM üzerinden 6 haneli kod gönderir.</p>
                </div>
              </div>
              <div id="actionDiscord2Fa" class="shrink-0">
                <button type="button" onclick="connectDiscord()" class="px-4 py-2.5 bg-[#5865F2] hover:bg-[#4752C4] text-white font-bold text-xs rounded-xl shadow cursor-pointer flex items-center gap-1.5">
                  <i class="fa-brands fa-discord"></i>
                  <span>Discord'u Bağla</span>
                </button>
              </div>
            </div>
          </div>

          <!-- Advanced Section -->
          <div id="twofaAdvancedSection" class="hidden space-y-6 pt-6 border-t border-purple-900/40">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-5 rounded-2xl bg-gray-950/60 border border-purple-900/40">
              <div>
                <h4 class="font-black text-white text-sm">Varsayılan Doğrulama Yöntemi</h4>
                <p class="text-xs text-gray-400 mt-0.5">Giriş yaparken öncelikli olarak istenecek yöntem.</p>
              </div>
              <select
                id="selectPrimaryMethod"
                onchange="updatePrimary2FaMethod(this.value)"
                class="px-4 py-2.5 bg-gray-900 border border-purple-900/60 rounded-xl text-xs font-bold text-white focus:outline-none focus:border-purple-500"
              >
                <option value="authenticator">Authenticator Uygulaması</option>
                <option value="email">E-Posta Kodu</option>
                <option value="discord">Discord</option>
              </select>
            </div>

            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-5 rounded-2xl bg-gray-950/60 border border-purple-900/40">
              <div>
                <div class="flex items-center gap-2">
                  <h4 class="font-black text-white text-sm">Kurtarma Kodları</h4>
                  <span id="recoveryCodesCountBadge" class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-purple-900/50 text-purple-300 border border-purple-700">0 KOD</span>
                </div>
                <p class="text-xs text-gray-400 mt-0.5">Cihazınıza erişemediğinizde tek kullanımlık kurtarma kodlarıyla giriş yapabilirsiniz.</p>
              </div>
              <button
                type="button"
                onclick="regenerateRecoveryCodes()"
                class="px-4 py-2.5 bg-gray-900 hover:bg-gray-800 text-purple-300 hover:text-white border border-purple-900/60 font-bold text-xs rounded-xl transition-all cursor-pointer"
              >
                Yeni Kodlar Üret
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- MODAL: AUTHENTICATOR SETUP -->
  <div id="modalAuthSetup" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-md">
    <div class="bg-[#181020] border-2 border-purple-500/30 rounded-3xl p-6 sm:p-8 max-w-md w-full shadow-2xl relative">
      <button onclick="closeModal('modalAuthSetup')" class="absolute top-6 right-6 text-gray-400 hover:text-white">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
      <h3 class="text-xl font-black text-white mb-2">Authenticator Kurulumu</h3>
      <p class="text-xs text-gray-400 mb-4">Google Authenticator uygulamasından QR kodu taratın veya kodu manuel girin.</p>

      <div id="authQrContainer" class="p-4 bg-white rounded-2xl flex items-center justify-center mb-4 max-w-[200px] mx-auto min-h-[200px]"></div>

      <div class="mb-4 text-center">
        <div class="text-[10px] text-gray-400 font-bold uppercase mb-1">Kurulum Anahtarı</div>
        <div id="authSecretCode" class="font-mono text-xs text-purple-300 font-bold bg-black/40 p-2 rounded-xl border border-purple-900/40 select-all">...</div>
      </div>

      <form id="formVerifyAuthSetup" class="space-y-4">
        <div>
          <label class="block text-xs font-bold text-gray-300 mb-1.5">6 Haneli Doğrulama Kodu</label>
          <input type="text" id="authSetupCodeInput" required maxlength="6" placeholder="123456"
            class="w-full text-center tracking-[0.4em] font-mono text-2xl font-black text-white bg-black/40 border border-purple-900/40 rounded-xl px-4 py-2.5 outline-none focus:border-purple-500">
        </div>
        <button type="submit" id="btnSubmitAuthSetup" class="w-full py-3.5 bg-purple-600 hover:bg-purple-500 text-white font-bold text-sm rounded-xl">
          Doğrula ve Aktifleştir
        </button>
      </form>
    </div>
  </div>

  <!-- MODAL: EMAIL 2FA SETUP -->
  <div id="modalEmailSetup" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-md">
    <div class="bg-[#181020] border-2 border-purple-500/30 rounded-3xl p-6 sm:p-8 max-w-md w-full shadow-2xl relative">
      <button onclick="closeModal('modalEmailSetup')" class="absolute top-6 right-6 text-gray-400 hover:text-white">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
      <h3 class="text-xl font-black text-white mb-2">E-Posta 2FA Doğrulama</h3>
      <p class="text-xs text-gray-400 mb-4">E-posta adresinize gönderilen 6 haneli doğrulama kodunu giriniz.</p>

      <form id="formVerifyEmailSetup" class="space-y-4">
        <div>
          <label class="block text-xs font-bold text-gray-300 mb-1.5">6 Haneli E-Posta Kodu</label>
          <input type="text" id="emailSetupCodeInput" required maxlength="6" placeholder="123456"
            class="w-full text-center tracking-[0.4em] font-mono text-2xl font-black text-white bg-black/40 border border-purple-900/40 rounded-xl px-4 py-2.5 outline-none focus:border-purple-500">
        </div>
        <button type="submit" id="btnSubmitEmailSetup" class="w-full py-3.5 bg-amber-600 hover:bg-amber-500 text-white font-bold text-sm rounded-xl">
          Doğrula ve Aktifleştir
        </button>
      </form>
    </div>
  </div>

  <!-- MODAL: RECOVERY CODES -->
  <div id="modalRecoveryCodes" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-md">
    <div class="bg-[#181020] border-2 border-purple-500/30 rounded-3xl p-6 sm:p-8 max-w-md w-full shadow-2xl relative">
      <button onclick="closeModal('modalRecoveryCodes')" class="absolute top-6 right-6 text-gray-400 hover:text-white">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
      <h3 class="text-xl font-black text-white mb-2">Kurtarma Kodlarınız</h3>
      <p class="text-xs text-gray-400 mb-4">Bu kodları güvenli bir yere kaydedin. Her kod tek seferliktir.</p>

      <div id="recoveryCodesGrid" class="grid grid-cols-2 gap-2 p-4 bg-black/40 rounded-2xl border border-purple-900/40 mb-4 text-center font-mono text-xs font-bold text-purple-300"></div>

      <button type="button" onclick="copyRecoveryCodes()" class="w-full py-3 bg-purple-600 hover:bg-purple-500 text-white font-bold text-xs uppercase rounded-xl">
        Kodları Kopyala
      </button>
    </div>
  </div>

  <!-- MODAL: DISABLE 2FA -->
  <div id="modalDisable2Fa" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-md">
    <div class="bg-[#181020] border-2 border-purple-500/30 rounded-3xl p-6 sm:p-8 max-w-md w-full shadow-2xl relative">
      <button onclick="closeModal('modalDisable2Fa')" class="absolute top-6 right-6 text-gray-400 hover:text-white">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
      <h3 class="text-xl font-black text-white mb-2">2FA'yı Kapat</h3>
      <p class="text-xs text-gray-400 mb-4">Güvenliğiniz için lütfen geçerli 2FA kodunuzu veya hesap şifrenizi giriniz.</p>

      <form id="formDisable2Fa" class="space-y-4">
        <div>
          <label class="block text-xs font-bold text-gray-300 mb-1.5">2FA Kodu veya Şifreniz</label>
          <input type="text" id="disable2FaCodeInput" required placeholder="6 Haneli Kod veya Şifre"
            class="w-full text-center font-mono text-base font-bold text-white bg-black/40 border border-purple-900/40 rounded-xl px-4 py-3 outline-none focus:border-red-500">
        </div>
        <button type="submit" id="btnSubmitDisable2Fa" class="w-full py-3.5 bg-red-600 hover:bg-red-500 text-white font-bold text-sm rounded-xl">
          2FA'yı Devre Dışı Bırak
        </button>
      </form>
    </div>
  </div>

  <script>
    let generatedRecoveryCodesCache = [];

    function switchSettingsTab(tabId) {
      document.querySelectorAll('.settings-content').forEach(el => el.classList.add('hidden'));
      document.querySelectorAll('.settings-tab-btn').forEach(el => {
        el.className = 'settings-tab-btn flex-1 py-3 px-5 rounded-xl font-bold text-xs uppercase tracking-wider transition-all flex items-center justify-center gap-2 cursor-pointer text-gray-400 hover:text-white';
      });

      const target = document.getElementById(tabId);
      const activeBtn = document.getElementById('tab-btn-' + tabId.replace('tab-', ''));
      if (target) target.classList.remove('hidden');
      if (activeBtn) {
        activeBtn.className = 'settings-tab-btn flex-1 py-3 px-5 rounded-xl font-black text-xs uppercase tracking-wider transition-all flex items-center justify-center gap-2 cursor-pointer bg-primary text-white shadow-lg';
      }
    }

    function openModal(id) {
      document.getElementById(id)?.classList.remove('hidden');
    }
    function closeModal(id) {
      document.getElementById(id)?.classList.add('hidden');
    }

    // Discord Status
    async function loadDiscordStatus() {
      const badge = document.getElementById('discordStatusBadge');
      const usernameText = document.getElementById('discordUsernameText');
      const subText = document.getElementById('discordSubText');
      const avatar = document.getElementById('discordAvatar');
      const defaultIcon = document.getElementById('discordDefaultIcon');
      const actionContainer = document.getElementById('discordActionBtnContainer');

      try {
        const res = await fetch('/api/storefront/v2/users/me/discord/status');
        const json = await res.json();
        const data = json.data || json;

        if (data.connected || data.isConnected || data.discordId) {
          window.__currentUserDiscordId = data.discordId || data.id;
          badge.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-emerald-950 text-emerald-300 border border-emerald-800';
          badge.innerHTML = '<span class="w-2 h-2 rounded-full bg-emerald-400"></span> BAĞLI';
          usernameText.innerText = data.discordUsername ? `@${data.discordUsername}` : 'Discord Hesabı';
          subText.innerText = data.connectedAt ? `Bağlandı: ${new Date(data.connectedAt).toLocaleDateString('tr-TR')}` : 'Hesabınız başarıyla eşleştirildi.';

          if (data.discordAvatar) {
            avatar.src = data.discordAvatar;
            avatar.classList.remove('hidden');
            defaultIcon.classList.add('hidden');
          }

          actionContainer.innerHTML = `
            <button type="button" onclick="unlinkDiscord()" class="px-5 py-2.5 bg-red-900/40 hover:bg-red-900 text-red-300 text-xs font-black rounded-xl uppercase tracking-wider border border-red-700/50 transition-all cursor-pointer">
              Bağlantıyı Kaldır
            </button>
          `;
        } else {
          badge.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-gray-900 text-gray-400 border border-purple-900/40';
          badge.innerText = 'BAĞLI DEĞİL';
          usernameText.innerText = 'Discord Bağlı Değil';
          subText.innerText = 'Hesabınızı bağlayarak tek tıkla giriş yapın.';
          avatar.classList.add('hidden');
          defaultIcon.classList.remove('hidden');

          actionContainer.innerHTML = `
            <button type="button" onclick="connectDiscord()" class="px-6 py-3 bg-[#5865F2] hover:bg-[#4752C4] text-white text-xs font-black uppercase tracking-wider rounded-xl transition-all shadow-lg flex items-center gap-2 cursor-pointer">
              <i class="fa-brands fa-discord"></i>
              <span>Discord'u Bağla</span>
            </button>
          `;
        }
      } catch (e) {
        if (badge) badge.innerText = 'HATA';
      }
    }

    async function connectDiscord() {
      try {
        const redirectUri = window.location.origin + '/profile/settings?tab=discord';
        const res = await fetch(`/api/storefront/v2/auth/discord?action=connect&redirectUri=${encodeURIComponent(redirectUri)}`);
        const data = await res.json();
        if (data.success && data.data?.oauthUrl) window.location.href = data.data.oauthUrl;
        else if (data.oauthUrl) window.location.href = data.oauthUrl;
        else (window.showToast?.(data.message || 'Discord bağlantı URL\'si alınamadı.', 'error') || alert(data.message));
      } catch (e) {
        (window.showToast?.('Discord servisine bağlanılamadı.', 'error') || alert('Discord servisine bağlanılamadı.'));
      }
    }

    async function unlinkDiscord() {
      if (!confirm('Discord bağlantınızı kaldırmak istediğinizden emin misiniz?')) return;
      try {
        const res = await fetch('/api/storefront/v2/users/me/discord/unlink', { method: 'POST' });
        const data = await res.json();
        if (data.success) {
          window.showToast?.('Discord bağlantısı kaldırıldı.', 'success');
          await loadDiscordStatus();
          await loadTwoFaStatus();
        } else {
          window.showToast?.(data.message || 'Bağlantı kaldırılamadı.', 'error');
        }
      } catch (e) {
        window.showToast?.('Bağlantı hatası.', 'error');
      }
    }

    // 2FA Status
    async function loadTwoFaStatus() {
      const overallBadge = document.getElementById('twofaOverallBadge');
      const badgeAuth = document.getElementById('badgeAuthenticator');
      const actionAuth = document.getElementById('actionAuthenticator');
      const badgeEmail = document.getElementById('badgeEmail2Fa');
      const actionEmail = document.getElementById('actionEmail2Fa');
      const badgeDiscord = document.getElementById('badgeDiscord2Fa');
      const actionDiscord = document.getElementById('actionDiscord2Fa');
      const discord2FaSub = document.getElementById('discord2FaSubText');
      const advancedSec = document.getElementById('twofaAdvancedSection');
      const selectPrimary = document.getElementById('selectPrimaryMethod');
      const recBadge = document.getElementById('recoveryCodesCountBadge');

      try {
        const res = await fetch('/api/storefront/v2/users/me/2fa/status');
        const json = await res.json();
        const data = json.data || json;

        const is2FaEnabled = data.enabled === true || data.isEnabled === true || json.enabled === true;
        let methodsArray = [];
        if (Array.isArray(data.methods)) methodsArray = data.methods;
        else if (Array.isArray(json.methods)) methodsArray = json.methods;
        else if (Array.isArray(data.twoFactorMethods)) methodsArray = data.twoFactorMethods;

        const hasAuth = methodsArray.includes('authenticator');
        const hasEmail = methodsArray.includes('email');
        const hasDiscord2Fa = methodsArray.includes('discord');
        const primary = data.primaryMethod || json.primaryMethod || 'authenticator';
        const recCount = data.recoveryCodesCount !== undefined ? data.recoveryCodesCount : (data.recoveryCodesLeft !== undefined ? data.recoveryCodesLeft : 0);
        const isDiscordLinked = data.discordLinked === true || (data.discordUsername && data.discordUsername !== null) || data.discordId != null;
        const dUsername = data.discordUsername || json.discordUsername;
        if (data.discordId) window.__currentUserDiscordId = data.discordId;

        if (is2FaEnabled) {
          overallBadge.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-emerald-950 text-emerald-300 border border-emerald-800';
          overallBadge.innerHTML = '<span class="w-2 h-2 rounded-full bg-emerald-400"></span> AKTİF';
          advancedSec.classList.remove('hidden');

          if (selectPrimary) selectPrimary.value = primary;
          if (recBadge) recBadge.innerText = `${recCount} KOD`;

          if (hasAuth) {
            badgeAuth.className = 'text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-950 text-emerald-300 border border-emerald-800';
            badgeAuth.innerText = 'Aktif';
            actionAuth.innerHTML = `<button type="button" onclick="startAuthenticatorSetup()" class="px-3.5 py-1.5 bg-gray-900 hover:bg-gray-800 text-gray-300 text-xs font-bold rounded-xl border border-purple-900/50">Yeniden Kur</button>`;
          } else {
            badgeAuth.className = 'text-[10px] font-bold px-2 py-0.5 rounded-full bg-gray-800 text-gray-400';
            badgeAuth.innerText = 'Kapalı';
            actionAuth.innerHTML = `<button type="button" onclick="startAuthenticatorSetup()" class="px-4 py-2 bg-purple-600 hover:bg-purple-500 text-white font-bold text-xs rounded-xl shadow cursor-pointer">Kurulum Yap</button>`;
          }

          if (hasEmail) {
            badgeEmail.className = 'text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-950 text-emerald-300 border border-emerald-800';
            badgeEmail.innerText = 'Aktif';
            actionEmail.innerHTML = `<button type="button" onclick="openDisable2FaModal()" class="px-3.5 py-1.5 bg-gray-900 hover:bg-gray-800 text-gray-300 text-xs font-bold rounded-xl border border-purple-900/50">Kapat</button>`;
          } else {
            badgeEmail.className = 'text-[10px] font-bold px-2 py-0.5 rounded-full bg-gray-800 text-gray-400';
            badgeEmail.innerText = 'Kapalı';
            actionEmail.innerHTML = `<button type="button" onclick="startEmail2FaSetup()" class="px-4 py-2 bg-amber-600 hover:bg-amber-500 text-white font-bold text-xs rounded-xl shadow cursor-pointer">Aktifleştir</button>`;
          }
        } else {
          overallBadge.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-gray-900 text-gray-400 border border-purple-900/40';
          overallBadge.innerText = 'DEVRE DIŞI';
          advancedSec.classList.add('hidden');

          badgeAuth.className = 'text-[10px] font-bold px-2 py-0.5 rounded-full bg-gray-800 text-gray-400';
          badgeAuth.innerText = 'Kapalı';
          actionAuth.innerHTML = `<button type="button" onclick="startAuthenticatorSetup()" class="px-4 py-2 bg-purple-600 hover:bg-purple-500 text-white font-bold text-xs rounded-xl shadow cursor-pointer">Kurulum Yap</button>`;

          badgeEmail.className = 'text-[10px] font-bold px-2 py-0.5 rounded-full bg-gray-800 text-gray-400';
          badgeEmail.innerText = 'Kapalı';
          actionEmail.innerHTML = `<button type="button" onclick="startEmail2FaSetup()" class="px-4 py-2 bg-amber-600 hover:bg-amber-500 text-white font-bold text-xs rounded-xl shadow cursor-pointer">Aktifleştir</button>`;
        }

        // Discord 2FA Status
        if (badgeDiscord && actionDiscord) {
          if (!isDiscordLinked) {
            badgeDiscord.className = 'text-[10px] font-bold px-2 py-0.5 rounded-full bg-gray-800 text-gray-400';
            badgeDiscord.innerText = 'Kapalı';
            if (discord2FaSub) discord2FaSub.innerHTML = `<span class="text-amber-400 font-semibold">⚠️ Önce Discord hesabınızı bağlayınız.</span>`;
            actionDiscord.innerHTML = `<button type="button" onclick="switchSettingsTab('tab-discord')" class="px-4 py-2 bg-[#5865F2] hover:bg-[#4752C4] text-white font-bold text-xs rounded-xl shadow flex items-center gap-1.5 cursor-pointer"><i class="fa-brands fa-discord"></i><span>Discord'u Bağla</span></button>`;
          } else if (hasDiscord2Fa) {
            badgeDiscord.className = 'text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-950 text-emerald-300 border border-emerald-800';
            badgeDiscord.innerText = 'Aktif';
            if (discord2FaSub) discord2FaSub.innerText = `Giriş sırasında @${dUsername || 'Discord'} hesabına DM üzerinden güvenlik kodu gönderilir.`;
            actionDiscord.innerHTML = `<button type="button" onclick="openDisable2FaModal()" class="px-3.5 py-1.5 bg-gray-900 hover:bg-gray-800 text-gray-300 text-xs font-bold rounded-xl border border-purple-900/50 cursor-pointer">Kapat</button>`;
          } else {
            badgeDiscord.className = 'text-[10px] font-bold px-2 py-0.5 rounded-full bg-blue-950 text-blue-300 border border-blue-800';
            badgeDiscord.innerText = 'Açılabilir';
            if (discord2FaSub) discord2FaSub.innerText = `@${dUsername || 'Discord'} hesabınız bağlı. Tek tıkla Discord 2FA aktifleştirebilirsiniz.`;
            actionDiscord.innerHTML = `<button type="button" onclick="startDiscord2FaSetup()" class="px-4 py-2 bg-[#5865F2] hover:bg-[#4752C4] text-white font-bold text-xs rounded-xl shadow flex items-center gap-1.5 cursor-pointer"><i class="fa-brands fa-discord"></i><span>Discord 2FA Aktifleştir</span></button>`;
          }
        }
      } catch (e) {
        if (overallBadge) overallBadge.innerText = 'Hata';
      }
    }

    // Authenticator Setup
    async function startAuthenticatorSetup() {
      openModal('modalAuthSetup');
      const qrContainer = document.getElementById('authQrContainer');
      const secretEl = document.getElementById('authSecretCode');
      qrContainer.innerHTML = '<span class="text-xs text-gray-400 font-bold animate-pulse">QR Kod Yükleniyor...</span>';

      try {
        const res = await fetch('/api/storefront/v2/users/me/2fa/authenticator/setup', { method: 'POST' });
        const data = await res.json();
        const payload = data.data || data;

        if (payload.qrCode || data.qrCode) {
          qrContainer.innerHTML = `<img src="${payload.qrCode || data.qrCode}" class="w-full h-full object-contain" alt="QR Code">`;
        }
        if (payload.secret || data.secret) {
          secretEl.innerText = payload.secret || data.secret;
        }
      } catch (e) {
        qrContainer.innerHTML = '<span class="text-xs text-red-400 font-bold">QR Kod yüklenemedi.</span>';
      }
    }

    document.getElementById('formVerifyAuthSetup')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const code = document.getElementById('authSetupCodeInput').value.trim();
      const btn = document.getElementById('btnSubmitAuthSetup');
      btn.disabled = true;
      btn.innerText = 'Doğrulanıyor...';

      try {
        const res = await fetch('/api/storefront/v2/users/me/2fa/authenticator/enable', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ code }),
        });
        const result = await res.json();
        const payload = result.data || result;

        if (result.success || payload.success) {
          closeModal('modalAuthSetup');
          document.getElementById('authSetupCodeInput').value = '';
          window.showToast?.(result.message || payload.message || 'Authenticator başarıyla aktifleştirildi!', 'success');
          await loadTwoFaStatus();
          const codes = result.recoveryCodes || payload.recoveryCodes || [];
          if (codes && codes.length > 0) displayRecoveryCodes(codes);
        } else {
          window.showToast?.(result.message || payload.message || 'Geçersiz doğrulama kodu.', 'error');
        }
      } catch (err) {
        window.showToast?.('Doğrulama hatası!', 'error');
      } finally {
        btn.disabled = false;
        btn.innerText = 'Doğrula ve Aktifleştir';
      }
    });

    // Email 2FA Setup
    async function startEmail2FaSetup() {
      try {
        const res = await fetch('/api/storefront/v2/users/me/2fa/email/send-code', { method: 'POST' });
        const data = await res.json();
        if (data.success) {
          window.showToast?.('Doğrulama kodu e-postanıza gönderildi.', 'success');
          openModal('modalEmailSetup');
        } else {
          window.showToast?.(data.message || 'Kod gönderilemedi.', 'error');
        }
      } catch (e) {
        window.showToast?.('Bağlantı hatası.', 'error');
      }
    }

    document.getElementById('formVerifyEmailSetup')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const code = document.getElementById('emailSetupCodeInput').value.trim();
      const btn = document.getElementById('btnSubmitEmailSetup');
      btn.disabled = true;
      btn.innerText = 'Doğrulanıyor...';

      try {
        const res = await fetch('/api/storefront/v2/users/me/2fa/email/enable', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ code }),
        });
        const result = await res.json();
        const payload = result.data || result;

        if (result.success || payload.success) {
          closeModal('modalEmailSetup');
          document.getElementById('emailSetupCodeInput').value = '';
          window.showToast?.(result.message || payload.message || 'E-Posta 2FA başarıyla aktifleştirildi!', 'success');
          await loadTwoFaStatus();
          const codes = result.recoveryCodes || payload.recoveryCodes || [];
          if (codes && codes.length > 0) displayRecoveryCodes(codes);
        } else {
          window.showToast?.(result.message || payload.message || 'Geçersiz kod.', 'error');
        }
      } catch (err) {
        window.showToast?.('Doğrulama hatası!', 'error');
      } finally {
        btn.disabled = false;
        btn.innerText = 'Doğrula ve Aktifleştir';
      }
    });

    // Discord 2FA Setup
    async function startDiscord2FaSetup() {
      const btn = document.getElementById('actionDiscord2Fa')?.querySelector('button');
      if (btn) { btn.disabled = true; btn.innerText = 'Aktifleştiriliyor...'; }
      try {
        const discordId = window.__currentUserDiscordId || '';
        const res = await fetch('/api/storefront/v2/users/me/2fa/discord/enable', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ discordId }),
        });
        const result = await res.json();
        const payload = result.data || result;

        if (result.success || payload.success) {
          window.showToast?.(result.message || payload.message || 'Discord 2FA başarıyla aktifleştirildi!', 'success');
          await loadTwoFaStatus();
          const codes = result.recoveryCodes || payload.recoveryCodes || [];
          if (codes && codes.length > 0) displayRecoveryCodes(codes);
        } else {
          window.showToast?.(result.message || payload.message || 'Discord 2FA aktifleştirilemedi.', 'error');
        }
      } catch (e) {
        window.showToast?.('Bağlantı hatası.', 'error');
      } finally {
        if (btn) { btn.disabled = false; btn.innerHTML = '<i class="fa-brands fa-discord"></i><span>Discord 2FA Aktifleştir</span>'; }
      }
    }

    // Primary Method
    async function updatePrimary2FaMethod(method) {
      try {
        const res = await fetch('/api/storefront/v2/users/me/2fa/primary-method', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ method }),
        });
        const data = await res.json();
        if (data.success) {
          window.showToast?.('Varsayılan 2FA yöntemi güncellendi.', 'success');
          await loadTwoFaStatus();
        } else {
          window.showToast?.(data.message || 'Güncellenemedi.', 'error');
        }
      } catch (e) {
        window.showToast?.('Bağlantı hatası.', 'error');
      }
    }

    // Recovery Codes
    function displayRecoveryCodes(codes) {
      generatedRecoveryCodesCache = codes;
      const grid = document.getElementById('recoveryCodesGrid');
      if (grid) {
        grid.innerHTML = codes.map((c) => `<div class="p-2.5 bg-gray-900 rounded-xl border border-purple-900/50 tracking-wider">${c}</div>`).join('');
      }
      openModal('modalRecoveryCodes');
    }

    function copyRecoveryCodes() {
      if (generatedRecoveryCodesCache.length > 0) {
        navigator.clipboard.writeText(generatedRecoveryCodesCache.join('\n'));
        window.showToast?.('Kurtarma kodları kopyalandı!', 'success');
      }
    }

    async function regenerateRecoveryCodes() {
      if (!confirm('Yeni kurtarma kodları üretilsin mi?')) return;
      try {
        const res = await fetch('/api/storefront/v2/users/me/2fa/recovery-codes/regenerate', { method: 'POST' });
        const result = await res.json();
        const payload = result.data || result;
        const codes = result.recoveryCodes || payload.recoveryCodes || [];

        if ((result.success || payload.success) && codes.length > 0) {
          displayRecoveryCodes(codes);
          await loadTwoFaStatus();
          window.showToast?.('Yeni kurtarma kodları üretildi.', 'success');
        } else {
          window.showToast?.(result.message || payload.message || 'Kodlar üretilemedi.', 'error');
        }
      } catch (e) {
        window.showToast?.('Bağlantı hatası.', 'error');
      }
    }

    function openDisable2FaModal() { openModal('modalDisable2Fa'); }

    document.getElementById('formDisable2Fa')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const code = document.getElementById('disable2FaCodeInput').value.trim();
      const btn = document.getElementById('btnSubmitDisable2Fa');
      btn.disabled = true;
      btn.innerText = 'Kapatılıyor...';

      try {
        const res = await fetch('/api/storefront/v2/users/me/2fa/disable', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ code }),
        });
        const result = await res.json();
        if (result.success) {
          closeModal('modalDisable2Fa');
          document.getElementById('disable2FaCodeInput').value = '';
          window.showToast?.('2FA başarıyla devre dışı bırakıldı.', 'success');
          await loadTwoFaStatus();
        } else {
          window.showToast?.(result.message || 'Geçersiz 2FA kodu.', 'error');
        }
      } catch (e) {
        window.showToast?.('Bağlantı hatası.', 'error');
      } finally {
        btn.disabled = false;
        btn.innerText = '2FA\'yı Devre Dışı Bırak';
      }
    });

    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('settings-form');
      const btnSave = document.getElementById('btn-save-settings');
      const inputEmail = document.getElementById('input-email');
      const inputPassword = document.getElementById('input-new-password');
      const successBox = document.getElementById('settings-success');
      const errorBox = document.getElementById('settings-error');
      const errorText = document.getElementById('settings-error-text');
      const customerId = '{{ customer.id }}';

      loadDiscordStatus();
      loadTwoFaStatus();

      const params = new URLSearchParams(window.location.search);
      const discordStatus = params.get('discord_status');
      const discordErr = params.get('discord_error');
      const discordUsername = params.get('discord_username');
      const tabParam = params.get('tab');

      if (discordStatus === 'connected') {
        const uName = discordUsername ? decodeURIComponent(discordUsername) : '';
        window.showToast?.(uName ? `"${uName}" Discord hesabınız başarıyla bağlandı!` : 'Discord hesabınız başarıyla bağlandı!', 'success');
        switchSettingsTab('tab-discord');
        loadDiscordStatus();
        window.history.replaceState({}, '', '/profile/settings?tab=discord');
      } else if (discordErr) {
        let msg = decodeURIComponent(discordErr);
        if (discordErr === 'ALREADY_LINKED_TO_ANOTHER_ACCOUNT') {
          msg = 'Bu Discord hesabı zaten başka bir oyuncu hesabına bağlı!';
        }
        window.showToast?.(msg, 'error');
        switchSettingsTab('tab-discord');
        window.history.replaceState({}, '', '/profile/settings?tab=discord');
      } else if (tabParam === 'discord') {
        switchSettingsTab('tab-discord');
      } else if (tabParam === '2fa') {
        switchSettingsTab('tab-2fa');
      }

      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        successBox?.classList.add('hidden');
        errorBox?.classList.add('hidden');
        if (btnSave) {
          btnSave.disabled = true;
          btnSave.innerText = 'Kaydediliyor...';
        }

        const email = inputEmail.value.trim();
        const currentPassword = document.getElementById('input-current-password')?.value.trim();
        const password = inputPassword.value.trim();

        try {
          if (email !== '{{ customer.email }}') {
            const res = await fetch(`/api/storefront/v2/users/${customerId}`, {
              method: 'PUT',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ email })
            });
            const data = await res.json();
            if (!data.success) {
              throw new Error(data.message || 'E-posta güncellenemedi.');
            }
          }

          if (password || currentPassword) {
            if (!currentPassword || !password) {
              throw new Error('Şifrenizi değiştirmek için hem mevcut hem de yeni şifrenizi girmelisiniz.');
            }
            if (password.length < 8) {
              throw new Error('Yeni şifre en az 8 karakter olmalıdır.');
            }
            
            const pRes = await fetch(`/api/storefront/v2/users/${customerId}/change-password`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ currentPassword: currentPassword, newPassword: password })
            });
            const pData = await pRes.json();
            if (!pData.success) {
              throw new Error(pData.message || 'Şifre güncellenemedi.');
            }
          }

          successBox?.classList.remove('hidden');
          window.showToast?.('Profil ayarlarınız kaydedildi.', 'success');
          
          if (password) {
            document.getElementById('input-current-password').value = '';
            inputPassword.value = '';
          }
        } catch (err) {
          if (errorText) errorText.innerText = err.message || 'Bilinmeyen bir hata oluştu.';
          errorBox?.classList.remove('hidden');
          window.showToast?.(err.message || 'Bir hata oluştu.', 'error');
        } finally {
          if (btnSave) {
            btnSave.disabled = false;
            btnSave.innerText = 'Değişiklikleri Kaydet';
          }
        }
      });
    });
  </script>
{% else %}
  <div class="w-full max-w-[1350px] mx-auto px-4 sm:px-6 py-16 min-h-[60vh] flex items-center justify-center">
    <div
      class="rounded-3xl border-2 shadow-2xl p-10 max-w-lg w-full text-center backdrop-blur-xl"
      style="
        background: linear-gradient(135deg, rgba(26, 16, 32, 0.95), rgba(18, 10, 24, 0.95));
        border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.25);
      "
    >
      <div
        class="w-20 h-20 mx-auto rounded-3xl flex items-center justify-center mb-6 shadow-2xl border"
        style="
          background: rgba(var(--color-primary-rgb, 124, 58, 237), 0.15);
          border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.35);
          color: var(--color-primary);
        "
      >
        <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
      </div>
      <h2 class="text-2xl sm:text-3xl font-black text-white mb-2" style="color: #ffffff !important;">Giriş Yapmalısınız</h2>
      <p class="text-xs sm:text-sm font-medium text-gray-300 mb-8 max-w-md mx-auto">
        Ayarlarınızı görüntülemek için lütfen hesabınıza giriş yapın.
      </p>
      <a
        href="/auth/sign-in?return=/profile/settings"
        class="w-full py-4 rounded-2xl font-black text-sm uppercase tracking-wider text-white shadow-2xl transition-all duration-300 hover:scale-[1.02] flex items-center justify-center gap-2 border border-white/20"
        style="
          background: linear-gradient(135deg, var(--color-primary), #9333ea);
          box-shadow: 0 10px 30px rgba(var(--color-primary-rgb, 124, 58, 237), 0.45);
        "
      >
        Giriş Yap
      </a>
    </div>
  </div>
{% endif %}
