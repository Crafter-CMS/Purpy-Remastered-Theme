<!-- ============================================================
     HEDİYE GÖNDER (Purpy Remastered Dark Luxury)
     ============================================================ -->
<div class="w-full max-w-[1350px] mx-auto px-4 sm:px-6 py-6 sm:py-10 space-y-8 min-h-[60vh]">
  <!-- Breadcrumb -->
  <div
    class="flex flex-wrap items-center gap-2 text-xs sm:text-sm font-semibold px-4 py-2.5 rounded-2xl border backdrop-blur-md w-fit shadow-lg"
    style="
      background: linear-gradient(135deg, rgba(26, 16, 32, 0.85), rgba(18, 10, 24, 0.85));
      border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.25);
    "
  >
    <a href="/" class="hover:text-primary transition-colors flex items-center gap-1.5" style="color: #cbd5e1;">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
      </svg>
    </a>
    <span class="text-gray-500">/</span>
    <span class="font-bold" style="color: var(--color-primary);">Hediye Gönder</span>
  </div>

  {% if customer %}
    <!-- Başlık ve Bakiye Kartı -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6 pb-2 border-b" style="border-color: rgba(255, 255, 255, 0.08);">
      <div class="flex items-center gap-3.5">
        <div class="w-2 h-10 rounded-full" style="background: linear-gradient(to bottom, var(--color-primary), #9333ea);"></div>
        <div>
          <h1 class="text-2xl sm:text-3xl font-black text-white uppercase tracking-wide" style="color: #ffffff !important;">
            Hediye Gönder
          </h1>
          <p class="text-xs sm:text-sm font-medium text-gray-300">
            Arkadaşlarınıza bakiye veya sandığınızdaki eşyaları anında transfer edin.
          </p>
        </div>
      </div>

      <div class="flex items-center gap-3 px-5 py-3.5 rounded-2xl border-2 shadow-xl backdrop-blur-xl w-fit"
           style="background: rgba(26, 16, 36, 0.9); border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.35);">
        <span class="text-xs font-bold text-gray-300">Mevcut Bakiye:</span>
        <span class="text-xl font-black text-primary drop-shadow-md">
          {{ customer.balance | default: 0 | round: 2 }} {{ store.currency | default: 'TRY' }}
        </span>
      </div>
    </div>

    <!-- Bildirim Konteyneri -->
    <div
      id="notification-container"
      class="hidden p-5 rounded-2xl font-bold flex items-center gap-3 shadow-xl border backdrop-blur-xl"
    >
      <svg class="w-6 h-6 flex-shrink-0" id="notification-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d=""/>
      </svg>
      <span id="notification-message" class="text-sm font-bold"></span>
    </div>

    <form id="gift-form" class="space-y-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <!-- SOL: Tür ve Miktar Seçimi (7 Cols) -->
        <div class="lg:col-span-7 space-y-6">
          <!-- Hediye Türü -->
          <div
            class="rounded-3xl border-2 shadow-2xl p-6 backdrop-blur-xl"
            style="
              background: linear-gradient(135deg, rgba(26, 16, 32, 0.95), rgba(18, 10, 24, 0.95));
              border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.25);
            "
          >
            <h3 class="text-base font-black text-white mb-4 flex items-center gap-2" style="color: #ffffff !important;">
              <span class="w-2 h-4 rounded-full bg-primary inline-block"></span>
              Hediye Türü Seçin
            </h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <button
                type="button"
                id="btn-type-balance"
                class="gift-type-btn relative p-5 rounded-2xl border-2 transition-all duration-300 text-left group overflow-hidden cursor-pointer shadow-lg"
                style="background: rgba(var(--color-primary-rgb, 124, 58, 237), 0.15); border-color: var(--color-primary);"
                data-type="balance"
              >
                <div class="relative z-10 flex items-center gap-3.5">
                  <div class="w-12 h-12 rounded-xl flex items-center justify-center text-2xl border shadow-inner"
                       style="background: rgba(14, 9, 20, 0.8); border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.4);">
                    💰
                  </div>
                  <div>
                    <div class="font-black text-base text-white" style="color: #ffffff !important;">Kredi Gönder</div>
                    <div class="text-xs text-gray-300 font-medium mt-0.5">Bakiyenden miktar transfer et</div>
                  </div>
                </div>
                <div class="type-check absolute top-3.5 right-3.5 text-primary">
                  <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                  </svg>
                </div>
              </button>

              <button
                type="button"
                id="btn-type-item"
                class="gift-type-btn relative p-5 rounded-2xl border-2 transition-all duration-300 text-left group overflow-hidden cursor-pointer shadow-lg"
                style="background: rgba(255, 255, 255, 0.03); border-color: rgba(255, 255, 255, 0.1);"
                data-type="item"
              >
                <div class="relative z-10 flex items-center gap-3.5">
                  <div class="w-12 h-12 rounded-xl flex items-center justify-center text-2xl border shadow-inner"
                       style="background: rgba(14, 9, 20, 0.8); border-color: rgba(255, 255, 255, 0.1);">
                    🎁
                  </div>
                  <div>
                    <div class="font-black text-base text-white" style="color: #ffffff !important;">Eşya Gönder</div>
                    <div class="text-xs text-gray-400 font-medium mt-0.5">Sandığındaki bir eşyayı yolla</div>
                  </div>
                </div>
                <div class="type-check absolute top-3.5 right-3.5 text-primary hidden">
                  <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                  </svg>
                </div>
              </button>
            </div>
          </div>

          <!-- Hediye Detayı (Kredi) -->
          <div
            id="panel-balance"
            class="rounded-3xl border-2 shadow-2xl p-6 backdrop-blur-xl"
            style="
              background: linear-gradient(135deg, rgba(26, 16, 32, 0.95), rgba(18, 10, 24, 0.95));
              border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.25);
            "
          >
            <h3 class="text-base font-black text-white mb-4 flex items-center gap-2" style="color: #ffffff !important;">
              <span class="w-2 h-4 rounded-full bg-primary inline-block"></span>
              Gönderilecek Miktar
            </h3>
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-5 flex items-center pointer-events-none text-purple-300 font-black text-base">
                {{ store.currency | default: 'TRY' }}
              </div>
              <input
                type="number"
                id="amount-input"
                min="1"
                step="1"
                placeholder="0.00"
                class="w-full pl-20 pr-6 py-4 text-xl font-black rounded-2xl border-2 focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary transition-all text-white placeholder:text-gray-500 shadow-inner"
                style="background: rgba(14, 9, 20, 0.85); border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.35);"
              >
            </div>

            <!-- Yetersiz Bakiye Uyarısı -->
            <div
              id="insufficient-balance-warning"
              class="hidden mt-4 p-4 rounded-2xl border flex items-center justify-between gap-4"
              style="background: rgba(239, 68, 68, 0.15); border-color: rgba(239, 68, 68, 0.35);"
            >
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-xl bg-rose-500/20 text-rose-400 border border-rose-500/30 flex items-center justify-center shrink-0">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                  </svg>
                </div>
                <div class="text-xs font-bold text-rose-200 leading-tight">
                  Yetersiz bakiye. Bu miktarı göndermek için bakiyeniz yetmiyor.
                </div>
              </div>
              <a
                href="/wallet"
                class="text-xs font-black text-white bg-rose-600 hover:bg-rose-500 py-2 px-3.5 rounded-xl transition-colors shrink-0 shadow"
              >
                Bakiye Yükle
              </a>
            </div>
          </div>

          <!-- Hediye Detayı (Eşya) -->
          <div
            id="panel-item"
            class="hidden rounded-3xl border-2 shadow-2xl p-6 backdrop-blur-xl"
            style="
              background: linear-gradient(135deg, rgba(26, 16, 32, 0.95), rgba(18, 10, 24, 0.95));
              border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.25);
            "
          >
            <h3 class="text-base font-black text-white mb-4 flex items-center gap-2" style="color: #ffffff !important;">
              <span class="w-2 h-4 rounded-full bg-primary inline-block"></span>
              Gönderilecek Eşya
            </h3>

            {% assign unused_items_count = 0 %}
            {% for item in customer.chest %}
              {% unless item.used %}
                {% assign unused_items_count = unused_items_count | plus: 1 %}
              {% endunless %}
            {% endfor %}

            {% if unused_items_count == 0 %}
              <div class="py-10 text-center rounded-2xl border-2 border-dashed flex flex-col items-center justify-center gap-2"
                   style="background: rgba(14, 9, 20, 0.5); border-color: rgba(255, 255, 255, 0.1);">
                <div class="text-3xl mb-1">📭</div>
                <p class="text-gray-400 font-bold text-xs">Sandığınızda hediye edilebilir eşya bulunmuyor.</p>
              </div>
            {% else %}
              <div
                class="grid grid-cols-2 sm:grid-cols-3 gap-3.5 max-h-[350px] overflow-y-auto pr-2 custom-scrollbar"
                id="chest-items-grid"
              >
                {% for item in customer.chest %}
                  {% unless item.used %}
                    <button
                      type="button"
                      class="chest-item-btn relative p-3.5 rounded-2xl border-2 transition-all text-center flex flex-col items-center gap-2 cursor-pointer shadow-lg"
                      style="background: rgba(14, 9, 20, 0.8); border-color: rgba(255, 255, 255, 0.08);"
                      data-item-id="{{ item.id }}"
                    >
                      <div class="item-check absolute top-2 right-2 w-5 h-5 bg-primary text-white rounded-full flex items-center justify-center shadow-sm hidden">
                        <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                        </svg>
                      </div>
                      <div class="w-12 h-12 rounded-xl flex items-center justify-center text-2xl shadow-inner border"
                           style="background: rgba(255, 255, 255, 0.03); border-color: rgba(255, 255, 255, 0.08);">
                        🎁
                      </div>
                      <div class="font-bold text-xs text-white line-clamp-2">{{ item.product.name }}</div>
                    </button>
                  {% endunless %}
                {% endfor %}
              </div>
            {% endif %}
          </div>
        </div>

        <!-- SAĞ: Alıcı Seçimi ve Gönder Butonu (5 Cols) -->
        <div class="lg:col-span-5 space-y-6">
          <div
            class="rounded-3xl border-2 shadow-2xl p-6 backdrop-blur-xl space-y-6"
            style="
              background: linear-gradient(135deg, rgba(28, 16, 38, 0.95), rgba(18, 10, 24, 0.95));
              border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.30);
            "
          >
            <h3 class="text-base font-black text-white flex items-center gap-2" style="color: #ffffff !important;">
              <span class="w-2 h-4 rounded-full bg-primary inline-block"></span>
              Kime Gönderilecek?
            </h3>

            <div class="space-y-3">
              <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-gray-400">
                  <svg id="search-icon-idle" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                  </svg>
                  <div id="search-icon-loading" class="hidden w-4 h-4 border-2 border-primary/20 border-t-primary rounded-full animate-spin"></div>
                </div>
                <input
                  type="text"
                  id="search-input"
                  placeholder="Kullanıcı adı yazın..."
                  class="w-full pl-12 pr-4 py-3.5 rounded-2xl border-2 focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary transition-all font-medium text-white text-sm placeholder:text-gray-500 shadow-inner"
                  style="background: rgba(14, 9, 20, 0.85); border-color: rgba(255, 255, 255, 0.1);"
                >
              </div>

              <button
                type="button"
                id="search-btn"
                class="w-full py-3.5 rounded-2xl font-black text-xs uppercase tracking-wider text-white shadow-lg transition-all duration-300 hover:scale-[1.02] border border-primary/40 cursor-pointer"
                style="background: rgba(var(--color-primary-rgb, 124, 58, 237), 0.35);"
              >
                Kullanıcı Bul
              </button>
            </div>

            <!-- Seçilen Kullanıcı Kartı -->
            <div
              id="selected-user-card"
              class="hidden p-4 rounded-2xl border-2 flex items-center gap-4 transition-opacity"
              style="background: rgba(var(--color-primary-rgb, 124, 58, 237), 0.15); border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.4);"
            >
              <div class="w-12 h-12 rounded-xl overflow-hidden border-2 border-primary/40 shrink-0 shadow-lg" style="background: rgba(14, 9, 20, 0.8);">
                <img id="selected-user-avatar" src="" alt="" class="w-full h-full object-cover">
              </div>
              <div class="flex-1 min-w-0">
                <h4 id="selected-user-username" class="text-sm font-black text-white truncate" style="color: #ffffff !important;"></h4>
                <p id="selected-user-email" class="text-xs font-medium text-purple-300 truncate"></p>
              </div>
              <button
                type="button"
                id="clear-user-btn"
                class="w-8 h-8 rounded-xl border text-gray-400 hover:text-red-400 hover:border-red-400/40 flex items-center justify-center transition-colors cursor-pointer"
                style="background: rgba(14, 9, 20, 0.6); border-color: rgba(255, 255, 255, 0.1);"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
              </button>
            </div>

            <!-- Gönder Butonu -->
            <button
              type="submit"
              id="submit-btn"
              disabled
              class="w-full py-4 rounded-2xl font-black text-sm uppercase tracking-wider text-white shadow-2xl transition-all duration-300 hover:scale-[1.02] flex items-center justify-center gap-2.5 border border-white/20 cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:scale-100"
              style="
                background: linear-gradient(135deg, var(--color-primary), #9333ea);
                box-shadow: 0 10px 30px rgba(var(--color-primary-rgb, 124, 58, 237), 0.45);
              "
            >
              <svg id="submit-icon-idle" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
              </svg>
              <div id="submit-icon-loading" class="hidden w-4 h-4 border-2 border-white/20 border-t-white rounded-full animate-spin"></div>
              <span id="submit-text">Hediyeyi Gönder</span>
            </button>
          </div>
        </div>
      </div>
    </form>

    <script>
      document.addEventListener('DOMContentLoaded', () => {
        let currentGiftType = 'balance';
        let currentSelectedUser = null;
        let currentSelectedChestItemId = null;
        const currentUserBalance = {{ customer.balance | default: 0 }};
        const currentUserId = '{{ customer.id }}';

        const typeBtns = document.querySelectorAll('.gift-type-btn');
        const panelBalance = document.getElementById('panel-balance');
        const panelItem = document.getElementById('panel-item');
        const chestItemBtns = document.querySelectorAll('.chest-item-btn');
        const amountInput = document.getElementById('amount-input');
        
        const searchInput = document.getElementById('search-input');
        const searchBtn = document.getElementById('search-btn');
        const iconIdle = document.getElementById('search-icon-idle');
        const iconLoading = document.getElementById('search-icon-loading');
        
        const selectedUserCard = document.getElementById('selected-user-card');
        const clearUserBtn = document.getElementById('clear-user-btn');
        
        const submitBtn = document.getElementById('submit-btn');
        const submitText = document.getElementById('submit-text');
        const submitIdle = document.getElementById('submit-icon-idle');
        const submitLoading = document.getElementById('submit-icon-loading');

        const notifContainer = document.getElementById('notification-container');
        const notifMessage = document.getElementById('notification-message');
        const notifIcon = document.getElementById('notification-icon');

        function showNotification(msg, isError = true) {
          if (!notifContainer) return;
          notifContainer.classList.remove('hidden');
          notifMessage.textContent = msg;
          
          if (isError) {
            notifContainer.style.background = 'rgba(239, 68, 68, 0.15)';
            notifContainer.style.borderColor = 'rgba(239, 68, 68, 0.4)';
            notifContainer.style.color = '#fca5a5';
            notifIcon.setAttribute('d', 'M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z');
          } else {
            notifContainer.style.background = 'rgba(16, 185, 129, 0.15)';
            notifContainer.style.borderColor = 'rgba(16, 185, 129, 0.4)';
            notifContainer.style.color = '#6ee7b7';
            notifIcon.setAttribute('d', 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z');
          }
        }

        function updateSubmitButtonState() {
          let isValid = false;
          const amt = parseFloat(amountInput.value) || 0;
          const warningBox = document.getElementById('insufficient-balance-warning');
          
          if (currentGiftType === 'balance') {
            if (amt > 0 && currentUserBalance < amt) {
              warningBox?.classList.remove('hidden');
            } else {
              warningBox?.classList.add('hidden');
            }
          } else {
            warningBox?.classList.add('hidden');
          }

          if (currentSelectedUser) {
            if (currentGiftType === 'balance') {
              if (amt > 0 && currentUserBalance >= amt) {
                isValid = true;
              }
            } else if (currentGiftType === 'item') {
              if (currentSelectedChestItemId) {
                isValid = true;
              }
            }
          }
          if (submitBtn) submitBtn.disabled = !isValid;
        }

        typeBtns.forEach(btn => {
          btn.addEventListener('click', () => {
            const type = btn.getAttribute('data-type');
            currentGiftType = type;
            
            typeBtns.forEach(b => {
              b.style.background = 'rgba(255, 255, 255, 0.03)';
              b.style.borderColor = 'rgba(255, 255, 255, 0.1)';
              b.querySelector('.type-check')?.classList.add('hidden');
            });
            
            btn.style.background = 'rgba(var(--color-primary-rgb, 124, 58, 237), 0.15)';
            btn.style.borderColor = 'var(--color-primary)';
            btn.querySelector('.type-check')?.classList.remove('hidden');

            if (type === 'balance') {
              panelBalance?.classList.remove('hidden');
              panelItem?.classList.add('hidden');
            } else {
              panelBalance?.classList.add('hidden');
              panelItem?.classList.remove('hidden');
            }

            updateSubmitButtonState();
            notifContainer?.classList.add('hidden');
          });
        });

        chestItemBtns.forEach(btn => {
          btn.addEventListener('click', () => {
            currentSelectedChestItemId = btn.getAttribute('data-item-id');
            
            chestItemBtns.forEach(b => {
              b.style.background = 'rgba(14, 9, 20, 0.8)';
              b.style.borderColor = 'rgba(255, 255, 255, 0.08)';
              b.querySelector('.item-check')?.classList.add('hidden');
            });
            
            btn.style.background = 'rgba(var(--color-primary-rgb, 124, 58, 237), 0.2)';
            btn.style.borderColor = 'var(--color-primary)';
            btn.querySelector('.item-check')?.classList.remove('hidden');

            updateSubmitButtonState();
          });
        });

        amountInput?.addEventListener('input', updateSubmitButtonState);

        async function performSearch() {
          const query = searchInput.value.trim();
          if (!query) {
            showNotification("Lütfen bir kullanıcı adı girin.");
            return;
          }

          iconIdle?.classList.add('hidden');
          iconLoading?.classList.remove('hidden');
          if (searchBtn) searchBtn.disabled = true;
          if (searchInput) searchInput.disabled = true;
          notifContainer?.classList.add('hidden');

          try {
            const res = await fetch(`/api/storefront/v2/users/@${query}`);
            const data = await res.json();
            
            const foundUser = data.data ? data.data : (data.id ? data : null);
            
            if (!res.ok || !foundUser) {
              throw new Error("Kullanıcı bulunamadı.");
            }
            
            if (foundUser.id === currentUserId) {
              showNotification("Kendinize hediye gönderemezsiniz.");
              currentSelectedUser = null;
              selectedUserCard?.classList.add('hidden');
              return;
            }
            
            currentSelectedUser = foundUser;
            
            document.getElementById('selected-user-avatar').src = `https://mc-heads.net/avatar/${foundUser.username}/64`;
            document.getElementById('selected-user-username').textContent = foundUser.username;
            document.getElementById('selected-user-email').textContent = foundUser.email || 'E-posta belirtilmemiş';
            
            selectedUserCard?.classList.remove('hidden');
            searchInput.value = "";
            
          } catch(err) {
            showNotification("Kullanıcı bulunamadı.");
            currentSelectedUser = null;
            selectedUserCard?.classList.add('hidden');
          } finally {
            iconIdle?.classList.remove('hidden');
            iconLoading?.classList.add('hidden');
            if (searchBtn) searchBtn.disabled = false;
            if (searchInput) searchInput.disabled = false;
            updateSubmitButtonState();
          }
        }

        searchBtn?.addEventListener('click', performSearch);
        searchInput?.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') {
            e.preventDefault();
            performSearch();
          }
        });

        clearUserBtn?.addEventListener('click', () => {
          currentSelectedUser = null;
          selectedUserCard?.classList.add('hidden');
          updateSubmitButtonState();
        });

        document.getElementById('gift-form')?.addEventListener('submit', async (e) => {
          e.preventDefault();
          
          if (!currentSelectedUser) return;

          submitBtn.disabled = true;
          submitIdle?.classList.add('hidden');
          submitLoading?.classList.remove('hidden');
          submitText.textContent = "İşleniyor...";
          notifContainer?.classList.add('hidden');

          try {
            if (currentGiftType === 'balance') {
              const amt = parseFloat(amountInput.value);
              
              const res = await fetch(`/api/storefront/users/me/balance/send`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ 
                  targetUserId: currentSelectedUser.id, 
                  amount: amt 
                })
              });
              
              const data = await res.json();
              if (res.ok && data.success) {
                showNotification(`${amt.toFixed(2)} {{ store.currency | default: 'TRY' }} başarıyla ${currentSelectedUser.username} adlı kullanıcıya gönderildi!`, false);
                setTimeout(() => window.location.reload(), 2000);
              } else {
                showNotification(data.message || "Hediye gönderilemedi.");
                resetSubmitBtn();
              }
            } else {
              const res = await fetch(`/api/storefront/chest/me/gift/${currentSelectedUser.id}/${currentSelectedChestItemId}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
              });
              
              const data = await res.json();
              if (res.ok && data.success) {
                showNotification(`Eşya başarıyla hediye edildi!`, false);
                setTimeout(() => window.location.reload(), 2000);
              } else {
                showNotification(data.message || "Hediye gönderilemedi.");
                resetSubmitBtn();
              }
            }
          } catch(err) {
            showNotification("Beklenmeyen bir sunucu hatası oluştu. Lütfen tekrar deneyin.");
            resetSubmitBtn();
          }
        });

        function resetSubmitBtn() {
          submitIdle?.classList.remove('hidden');
          submitLoading?.classList.add('hidden');
          submitText.textContent = "Hediyeyi Gönder";
          updateSubmitButtonState();
        }
      });
    </script>
  {% else %}
    <div class="w-full max-w-[1350px] mx-auto px-4 sm:px-6 py-16 min-h-[60vh] flex items-center justify-center">
      <div
        class="rounded-3xl border-2 shadow-2xl p-10 max-w-lg w-full text-center backdrop-blur-xl"
        style="
          background: linear-gradient(135deg, rgba(26, 16, 32, 0.95), rgba(18, 10, 24, 0.95));
          border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.25);
        "
      >
        <div
          class="w-20 h-20 mx-auto rounded-3xl flex items-center justify-center mb-6 shadow-2xl border"
          style="
            background: rgba(var(--color-primary-rgb, 124, 58, 237), 0.15);
            border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.35);
            color: var(--color-primary);
          "
        >
          <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
          </svg>
        </div>
        <h2 class="text-2xl sm:text-3xl font-black text-white mb-2" style="color: #ffffff !important;">Giriş Yapmalısınız</h2>
        <p class="text-xs sm:text-sm font-medium text-gray-300 mb-8 max-w-md mx-auto">
          Arkadaşlarınıza hediye gönderebilmek için lütfen hesabınıza giriş yapın.
        </p>
        <a
          href="/auth/sign-in?return=/gift"
          class="w-full py-4 rounded-2xl font-black text-sm uppercase tracking-wider text-white shadow-2xl transition-all duration-300 hover:scale-[1.02] flex items-center justify-center gap-2 border border-white/20"
          style="
            background: linear-gradient(135deg, var(--color-primary), #9333ea);
            box-shadow: 0 10px 30px rgba(var(--color-primary-rgb, 124, 58, 237), 0.45);
          "
        >
          Giriş Yap
        </a>
      </div>
    </div>
  {% endif %}
</div>
