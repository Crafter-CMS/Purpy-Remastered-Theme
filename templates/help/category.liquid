<!-- ============================================================
     YARDIM KATEGORİSİ VE REHBERLER (Purpy Remastered Dark Luxury)
     ============================================================ -->
<div class="w-full max-w-[1350px] mx-auto px-4 sm:px-6 py-6 sm:py-10 space-y-8 min-h-[60vh]">
  <!-- Breadcrumb & Geri Dön -->
  <div class="flex flex-wrap items-center justify-between gap-4">
    <div
      class="flex flex-wrap items-center gap-2 text-xs sm:text-sm font-semibold px-4 py-2.5 rounded-2xl border backdrop-blur-md w-fit shadow-lg"
      style="
        background: linear-gradient(135deg, rgba(26, 16, 32, 0.85), rgba(18, 10, 24, 0.85));
        border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.25);
      "
    >
      <a href="/help" class="hover:text-primary transition-colors flex items-center gap-1.5" style="color: #cbd5e1;">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
        </svg>
      </a>
      <span class="text-gray-500">/</span>
      <a href="/help" class="hover:text-primary transition-colors" style="color: #cbd5e1;">Yardım Merkezi</a>
      <span class="text-gray-500">/</span>
      <span class="font-bold" style="color: var(--color-primary);">{{ categoryDetail.name | default: 'Kategori' }}</span>
    </div>

    <a
      href="/help"
      class="inline-flex items-center gap-2 px-5 py-2.5 rounded-2xl font-bold text-xs uppercase tracking-wider text-gray-300 hover:text-white border border-white/10 hover:border-primary/40 bg-white/5 hover:bg-white/10 transition-all hover:scale-105"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
      </svg>
      <span>Geri Dön</span>
    </a>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- SOL: Makale Listesi Sidebar (4 Cols) -->
    <div class="lg:col-span-4 space-y-6">
      <div
        class="rounded-3xl border-2 shadow-2xl p-6 backdrop-blur-xl sticky top-24"
        style="
          background: linear-gradient(135deg, rgba(26, 16, 32, 0.95), rgba(18, 10, 24, 0.95));
          border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.25);
        "
      >
        <div class="flex items-center gap-4 mb-6 pb-5 border-b" style="border-color: rgba(255, 255, 255, 0.08);">
          <div class="w-14 h-14 rounded-2xl flex items-center justify-center flex-shrink-0 border shadow-lg"
               style="background: rgba(var(--color-primary-rgb, 124, 58, 237), 0.2); border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.4); color: var(--color-primary);">
            {% if categoryDetail.icon == 'CubeIcon' %}
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
            {% elsif categoryDetail.icon == 'DiscordIcon' %}
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z"/></svg>
            {% else %}
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            {% endif %}
          </div>
          <div>
            <h1 class="text-base font-black text-white leading-tight" style="color: #ffffff !important;">{{ categoryDetail.name }}</h1>
            <p class="text-xs text-gray-400 font-medium mt-1 line-clamp-2">{{ categoryDetail.description }}</p>
          </div>
        </div>

        <h3 class="text-[10px] font-black text-purple-300 uppercase tracking-wider mb-3">
          İçerikler ({{ categoryDetail.items.size | default: 0 }})
        </h3>
        
        <div class="space-y-2 flex flex-col" id="article-list">
          {% for item in categoryDetail.items %}
            <button
              onclick="showArticle('{{ item.id }}')"
              class="article-btn w-full text-left p-3.5 rounded-2xl flex items-center gap-3 transition-all border font-bold text-xs cursor-pointer
              {% if forloop.first %} shadow-lg {% else %} text-gray-400 hover:text-white hover:bg-white/5 border-transparent {% endif %}"
              style="{% if forloop.first %}background: rgba(var(--color-primary-rgb, 124, 58, 237), 0.25); color: #ffffff; border-color: var(--color-primary);{% endif %}"
              data-id="{{ item.id }}"
            >
              <div class="w-7 h-7 rounded-xl flex items-center justify-center flex-shrink-0 transition-colors
              {% if forloop.first %} bg-primary text-white {% else %} bg-white/5 text-purple-300 {% endif %}">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
              </div>
              <span class="truncate">{{ item.title }}</span>
            </button>
          {% else %}
            <div class="p-4 text-center text-xs text-gray-400 rounded-2xl border border-dashed" style="border-color: rgba(255, 255, 255, 0.1);">
              Bu kategoride içerik bulunmuyor.
            </div>
          {% endfor %}
        </div>
      </div>
    </div>

    <!-- SAĞ: Makale İçeriği (8 Cols) -->
    <div
      class="lg:col-span-8 rounded-3xl border-2 shadow-2xl overflow-hidden min-h-[500px] backdrop-blur-xl"
      style="
        background: linear-gradient(135deg, rgba(26, 16, 32, 0.95), rgba(18, 10, 24, 0.95));
        border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.25);
      "
    >
      <div id="articles-container">
        {% for item in categoryDetail.items %}
          <div id="article-{{ item.id }}" class="article-content {% unless forloop.first %}hidden{% endunless %}">
            <div class="p-6 sm:p-10 border-b flex items-center gap-4" style="background: rgba(14, 9, 20, 0.6); border-color: rgba(255, 255, 255, 0.08);">
              <h2 class="text-xl sm:text-2xl font-black text-white tracking-wide" style="color: #ffffff !important;">{{ item.title }}</h2>
            </div>
            <div class="p-6 sm:p-10 prose prose-invert prose-base max-w-none text-gray-200 font-medium leading-relaxed prose-headings:text-white prose-a:text-purple-400 hover:prose-a:text-purple-300">
              {% if item.content.root.children %}
                {% for node in item.content.root.children %}
                  {% if node.type == 'paragraph' %}
                    <p>{{ node.children[0].text }}</p>
                  {% elsif node.type == 'heading' %}
                    <h3 class="text-lg font-bold mt-6 mb-3 text-white">{{ node.children[0].text }}</h3>
                  {% else %}
                    <div>{{ node.children[0].text }}</div>
                  {% endif %}
                {% endfor %}
              {% else %}
                <p>Bu makale için içerik bulunamadı.</p>
              {% endif %}
            </div>
          </div>
        {% else %}
          <div class="p-16 text-center h-full flex flex-col items-center justify-center">
            <div class="w-20 h-20 rounded-3xl flex items-center justify-center text-gray-500 mb-4 border"
                 style="background: rgba(14, 9, 20, 0.6); border-color: rgba(255, 255, 255, 0.08);">
              <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
              </svg>
            </div>
            <h3 class="text-xl font-black text-white mb-2" style="color: #ffffff !important;">Makale Seçin</h3>
            <p class="text-xs text-gray-400 font-medium max-w-md mx-auto">
              Okumak istediğiniz içeriği sol menüden seçebilirsiniz. Detaylar burada görüntülenecektir.
            </p>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

<script>
  function showArticle(articleId) {
    document.querySelectorAll('.article-content').forEach(el => {
      el.classList.add('hidden');
    });
    
    const selectedArticle = document.getElementById('article-' + articleId);
    if (selectedArticle) {
      selectedArticle.classList.remove('hidden');
    }

    document.querySelectorAll('.article-btn').forEach(btn => {
      const isSelected = btn.getAttribute('data-id') === articleId;
      const iconWrap = btn.querySelector('div');
      
      if (isSelected) {
        btn.style.background = 'rgba(var(--color-primary-rgb, 124, 58, 237), 0.25)';
        btn.style.borderColor = 'var(--color-primary)';
        btn.style.color = '#ffffff';
        if (iconWrap) {
          iconWrap.className = 'w-7 h-7 rounded-xl flex items-center justify-center flex-shrink-0 transition-colors bg-primary text-white';
        }
      } else {
        btn.style.background = 'transparent';
        btn.style.borderColor = 'transparent';
        btn.style.color = '#9ca3af';
        if (iconWrap) {
          iconWrap.className = 'w-7 h-7 rounded-xl flex items-center justify-center flex-shrink-0 transition-colors bg-white/5 text-purple-300';
        }
      }
    });
  }
</script>
