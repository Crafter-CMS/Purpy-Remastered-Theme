<!-- ============================================================
     SEPETİM (Purpy Remastered Dark Luxury)
     ============================================================ -->
<div class="w-full max-w-[1350px] mx-auto px-4 sm:px-6 py-6 sm:py-10 space-y-8 min-h-[60vh]">
  <!-- Breadcrumb -->
  <div
    class="flex flex-wrap items-center gap-2 text-xs sm:text-sm font-semibold px-4 py-2.5 rounded-2xl border backdrop-blur-md w-fit shadow-lg"
    style="
      background: linear-gradient(135deg, rgba(26, 16, 32, 0.85), rgba(18, 10, 24, 0.85));
      border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.25);
    "
  >
    <a href="/store" class="hover:text-primary transition-colors flex items-center gap-1.5" style="color: #cbd5e1;">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
      </svg>
      <span>Mağaza</span>
    </a>
    <span class="text-gray-500">/</span>
    <span class="font-bold" style="color: var(--color-primary);">Sepetim</span>
  </div>

  <!-- Loading State -->
  <div id="cart-loading" class="flex flex-col items-center justify-center py-24">
    <div class="w-16 h-16 rounded-full border-4 border-primary/20 border-t-primary animate-spin mb-4"></div>
    <div class="font-bold text-sm text-gray-300">Sepetiniz yükleniyor...</div>
  </div>

  <!-- Empty State -->
  <div
    id="cart-empty"
    class="hidden rounded-3xl p-12 sm:p-16 text-center border-2 shadow-2xl backdrop-blur-xl flex flex-col items-center justify-center"
    style="
      background: linear-gradient(135deg, rgba(26, 16, 32, 0.95), rgba(18, 10, 24, 0.95));
      border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.25);
    "
  >
    <div
      class="w-24 h-24 rounded-3xl flex items-center justify-center mx-auto mb-6 shadow-2xl border"
      style="
        background: rgba(var(--color-primary-rgb, 124, 58, 237), 0.15);
        border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.35);
        color: var(--color-primary);
      "
    >
      <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
      </svg>
    </div>
    <h3 class="text-2xl sm:text-3xl font-black text-white mb-2" style="color: #ffffff !important;">Sepetiniz Boş</h3>
    <p class="text-xs sm:text-sm font-medium text-gray-300 mb-8 max-w-md">
      Henüz sepetinize bir ürün eklemediniz. Mağazamızı keşfederek dilediğiniz avantajlı paketleri sepete ekleyebilirsiniz.
    </p>
    <a
      href="/store"
      class="inline-flex items-center gap-2.5 px-8 py-4 rounded-2xl font-black text-xs sm:text-sm uppercase tracking-wider text-white shadow-2xl transition-all duration-300 hover:scale-105 border border-white/20"
      style="background: linear-gradient(135deg, var(--color-primary), #9333ea);"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
      </svg>
      <span>Mağazaya Git</span>
    </a>
  </div>

  <!-- Cart Content Grid -->
  <div id="cart-content" class="hidden grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- SOL: Ürünler Listesi (8 Cols) -->
    <div
      class="lg:col-span-8 rounded-3xl border-2 shadow-2xl overflow-hidden backdrop-blur-xl"
      style="
        background: linear-gradient(135deg, rgba(26, 16, 32, 0.95), rgba(18, 10, 24, 0.95));
        border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.25);
      "
    >
      <!-- Header -->
      <div
        class="p-6 border-b flex items-center justify-between"
        style="
          background: rgba(14, 9, 20, 0.6);
          border-color: rgba(255, 255, 255, 0.08);
        "
      >
        <h2 class="text-lg sm:text-xl font-black text-white flex items-center gap-3" style="color: #ffffff !important;">
          <div class="w-8 h-8 rounded-xl flex items-center justify-center bg-primary/20 text-primary border border-primary/40">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
            </svg>
          </div>
          <span>Sepet Ürünleri (<span id="cart-count">0</span>)</span>
        </h2>

        <button
          id="clearCartBtn"
          onclick="clearCart(this)"
          class="text-xs font-bold text-red-400 hover:text-red-300 transition-all px-3 py-1.5 rounded-xl border border-red-500/30 hover:border-red-500/60 bg-red-500/10 flex items-center gap-1.5 cursor-pointer"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
          </svg>
          <span>Temizle</span>
        </button>
      </div>

      <!-- Item Rows Container -->
      <div id="cart-items" class="divide-y" style="border-color: rgba(255, 255, 255, 0.06);">
        <!-- JS rendered items -->
      </div>
    </div>

    <!-- SAĞ: Sipariş Özeti (4 Cols) -->
    <div class="lg:col-span-4 space-y-6">
      <div
        class="rounded-3xl border-2 shadow-2xl p-6 sm:p-7 backdrop-blur-xl sticky top-24"
        style="
          background: linear-gradient(135deg, rgba(28, 16, 38, 0.95), rgba(18, 10, 24, 0.95));
          border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.30);
        "
      >
        <h2 class="text-lg sm:text-xl font-black text-white mb-6 flex items-center gap-2.5 pb-4 border-b" style="color: #ffffff !important; border-color: rgba(255, 255, 255, 0.08);">
          <div class="w-8 h-8 rounded-xl flex items-center justify-center bg-primary/20 text-primary border border-primary/40">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
            </svg>
          </div>
          <span>Sipariş Özeti</span>
        </h2>

        <!-- Coupon Form -->
        <div class="mb-6 pb-6 border-b" style="border-color: rgba(255, 255, 255, 0.08);">
          <div
            id="applied-coupon"
            class="hidden mb-4 p-4 rounded-2xl border relative overflow-hidden"
            style="background: rgba(16, 185, 129, 0.15); border-color: rgba(16, 185, 129, 0.4);"
          >
            <div class="flex items-center justify-between relative z-10">
              <div class="flex items-center gap-2">
                <svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                <div class="font-black text-emerald-300 text-sm font-mono tracking-wider" id="coupon-code-display"></div>
              </div>
              <button
                onclick="removeCoupon()"
                class="text-emerald-300 hover:text-white transition-colors p-1.5 rounded-lg hover:bg-emerald-500/20"
                title="Kuponu Kaldır"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
              </button>
            </div>
            <div class="text-xs font-semibold text-emerald-200 mt-2" id="coupon-description"></div>
          </div>

          <div id="coupon-input-container" class="flex items-center gap-2">
            <div class="relative flex-1">
              <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
                </svg>
              </div>
              <input
                type="text"
                id="couponCode"
                class="w-full pl-10 pr-4 py-3 rounded-xl border focus:ring-2 focus:ring-primary focus:border-primary transition-all font-medium text-white text-xs placeholder:text-gray-500 outline-none"
                style="background: rgba(14, 9, 20, 0.7); border-color: rgba(255, 255, 255, 0.1);"
                placeholder="İndirim Kuponu"
              >
            </div>
            <button
              onclick="applyCoupon()"
              id="applyCouponBtn"
              class="px-4 py-3 rounded-xl font-bold text-xs uppercase tracking-wider text-white transition-all hover:scale-105 border border-primary/40 cursor-pointer shadow flex-shrink-0"
              style="background: rgba(var(--color-primary-rgb, 124, 58, 237), 0.35);"
            >
              Uygula
            </button>
          </div>
        </div>

        <!-- Fiyat Satırları -->
        <div class="space-y-3 mb-6 text-sm">
          <div class="flex items-center justify-between font-medium text-gray-400">
            <span>Ara Toplam</span>
            <span id="subtotal" class="font-black text-white">0.00 ₺</span>
          </div>
          <div id="coupon-discount-row" class="hidden items-center justify-between font-semibold text-emerald-400">
            <span>Kupon İndirimi</span>
            <span id="coupon-discount" class="font-black">-0.00 ₺</span>
          </div>
        </div>

        <!-- Toplam -->
        <div class="border-t pt-5 mb-7" style="border-color: rgba(255, 255, 255, 0.08);">
          <div class="flex items-center justify-between">
            <span class="text-base font-bold text-gray-300">Genel Toplam</span>
            <span id="total" class="text-2xl font-black text-primary drop-shadow-md">0.00 ₺</span>
          </div>
        </div>

        <!-- Siparişi Tamamla Butonu -->
        <button
          onclick="purchase()"
          id="purchaseBtn"
          class="w-full py-4 rounded-2xl font-black text-sm uppercase tracking-wider text-white shadow-2xl transition-all duration-300 hover:scale-[1.02] flex items-center justify-center gap-2 border border-white/20 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
          style="
            background: linear-gradient(135deg, var(--color-primary), #9333ea);
            box-shadow: 0 10px 30px rgba(var(--color-primary-rgb, 124, 58, 237), 0.45);
          "
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
          </svg>
          <span>Siparişi Tamamla</span>
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  // Marketplace Settings injected from server
  const bulkDiscount = {{ marketplace.bulkDiscount | json | default: 'null' }};
  const isCustomer = {% if customer %}true{% else %}false{% endif %};
  
  let cartProducts = [];
  let appliedCoupon = null;

  async function loadCart() {
    const cartStr = localStorage.getItem('cart');
    let cart = [];
    if (cartStr) {
      try {
        cart = JSON.parse(cartStr);
        const originalLength = cart.length;
        cart = cart.filter(item => item && item.id && item.id.trim() !== '');
        if (cart.length !== originalLength) {
          localStorage.setItem('cart', JSON.stringify(cart));
        }
      } catch(e){}
    }

    if (cart.length === 0) {
      document.getElementById('cart-loading')?.classList.add('hidden');
      document.getElementById('cart-empty')?.classList.remove('hidden');
      document.getElementById('cart-content')?.classList.add('hidden');
      updateCartHeaderCount();
      return;
    }

    try {
      cartProducts = cart;
      document.getElementById('cart-loading')?.classList.add('hidden');
      
      if (cartProducts.length === 0) {
        document.getElementById('cart-empty')?.classList.remove('hidden');
        document.getElementById('cart-content')?.classList.add('hidden');
      } else {
        document.getElementById('cart-empty')?.classList.add('hidden');
        document.getElementById('cart-content')?.classList.remove('hidden');
        renderCart();
      }
    } catch(err) {
      console.error(err);
      document.getElementById('cart-loading')?.classList.add('hidden');
      window.showToast?.('Sepet yüklenirken hata oluştu', 'error');
    }
  }

  function renderCart() {
    const itemsContainer = document.getElementById('cart-items');
    if (!itemsContainer) return;
    itemsContainer.innerHTML = '';
    
    let totalSubtotal = 0;

    cartProducts.forEach(product => {
      const originalPrice = Number(product.price) || 0;
      const discountValue = Number(product.discountValue) || 0;
      const hasProductDiscount = discountValue > 0;
      
      let productDiscountedPrice = originalPrice;
      if (hasProductDiscount) {
        productDiscountedPrice = product.discountType === 'percentage'
          ? originalPrice - (originalPrice * discountValue / 100)
          : originalPrice - discountValue;
      }

      let bulkDiscountedPrice = originalPrice;
      let hasBulk = false;
      let bulkDiscountAmount = 0;

      if (bulkDiscount && bulkDiscount.amount > 0 && (!bulkDiscount.products || bulkDiscount.products.length === 0 || bulkDiscount.products.includes(product.id))) {
        hasBulk = true;
        if (bulkDiscount.type === 'percentage') {
          bulkDiscountAmount = (originalPrice * bulkDiscount.amount) / 100;
        } else {
          bulkDiscountAmount = bulkDiscount.amount;
        }
        bulkDiscountedPrice = originalPrice - bulkDiscountAmount;
      }

      let finalPrice = originalPrice;
      let badgeHtml = '';

      if (hasProductDiscount && hasBulk) {
        if (bulkDiscountedPrice < productDiscountedPrice) {
          finalPrice = bulkDiscountedPrice;
          badgeHtml = `<span class="px-2 py-0.5 rounded text-[10px] font-black uppercase text-rose-300 bg-rose-500/20 border border-rose-500/30">${bulkDiscount.type === 'percentage' ? `%${bulkDiscount.amount} İndirim` : `${bulkDiscount.amount}₺ İndirim`}</span>`;
        } else {
          finalPrice = productDiscountedPrice;
          badgeHtml = `<span class="px-2 py-0.5 rounded text-[10px] font-black uppercase text-rose-300 bg-rose-500/20 border border-rose-500/30">${product.discountType === 'percentage' ? `%${discountValue} İndirim` : `${discountValue}₺ İndirim`}</span>`;
        }
      } else if (hasBulk) {
        finalPrice = bulkDiscountedPrice;
        badgeHtml = `<span class="px-2 py-0.5 rounded text-[10px] font-black uppercase text-rose-300 bg-rose-500/20 border border-rose-500/30">${bulkDiscount.type === 'percentage' ? `%${bulkDiscount.amount} İndirim` : `${bulkDiscount.amount}₺ İndirim`}</span>`;
      } else if (hasProductDiscount) {
        finalPrice = productDiscountedPrice;
        badgeHtml = `<span class="px-2 py-0.5 rounded text-[10px] font-black uppercase text-rose-300 bg-rose-500/20 border border-rose-500/30">${product.discountType === 'percentage' ? `%${discountValue} İndirim` : `${discountValue}₺ İndirim`}</span>`;
      }

      let couponDiscount = 0;
      let hasCouponDiscount = false;
      if (appliedCoupon && appliedCoupon.type === 'product_discount') {
        if (!appliedCoupon.productId || product.id === appliedCoupon.productId) {
          hasCouponDiscount = true;
          if (appliedCoupon.discountType === 'percentage') {
            couponDiscount = (finalPrice * appliedCoupon.discountValue) / 100;
          } else {
            couponDiscount = appliedCoupon.discountValue;
          }
        }
      }

      const finalPriceWithCoupon = finalPrice - couponDiscount;
      const lineTotal = finalPriceWithCoupon * product.quantity;
      totalSubtotal += lineTotal;

      const imgUrl = product.image;
      const imgHtml = imgUrl ? `<img src="${imgUrl}" class="w-full h-full object-contain" alt="">` : `<div class="flex items-center justify-center text-primary/40 h-full"><svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg></div>`;

      let priceHtml = '';
      if (finalPrice < originalPrice || hasCouponDiscount) {
        priceHtml = `
          <div class="flex items-center gap-2 mt-1 flex-wrap">
            <span class="text-xs text-gray-500 line-through font-medium">${originalPrice.toFixed(2)} ₺</span>
            <span class="font-black text-white text-sm">${Math.max(0, finalPriceWithCoupon).toFixed(2)} ₺</span>
            ${badgeHtml}
            ${hasCouponDiscount ? `<span class="px-2 py-0.5 bg-emerald-500/20 border border-emerald-500/30 text-emerald-300 rounded text-[10px] font-bold">Kuponlu</span>` : ''}
          </div>
        `;
      } else {
        priceHtml = `<div class="font-black text-white text-sm mt-1">${originalPrice.toFixed(2)} ₺</div>`;
      }

      itemsContainer.innerHTML += `
        <div class="flex items-center gap-4 sm:gap-6 p-4 sm:p-6 transition-colors hover:bg-white/[0.02]">
          <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl border-2 flex-shrink-0 p-2 flex items-center justify-center shadow-lg"
               style="background: rgba(14, 9, 20, 0.8); border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.25);">
            ${imgHtml}
          </div>
          <div class="flex-1 min-w-0">
            <h3 class="font-black text-sm sm:text-base text-white truncate" style="color: #ffffff !important;">
              <a href="/store/product/${product.id}" class="hover:text-primary transition-colors">${product.name}</a>
            </h3>
            ${priceHtml}
          </div>
          <div class="flex items-center gap-3 sm:gap-4 flex-shrink-0">
            <!-- Adet Sayacı -->
            <div class="flex items-center gap-1.5 p-1 rounded-xl border shadow-inner"
                 style="background: rgba(14, 9, 20, 0.8); border-color: rgba(255, 255, 255, 0.1);">
              <button onclick="updateQty('${product.id}', ${product.quantity - 1})"
                      class="w-7 h-7 flex items-center justify-center rounded-lg text-gray-400 hover:text-white hover:bg-white/10 transition-all cursor-pointer">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M20 12H4"/></svg>
              </button>
              <span class="w-6 text-center font-black text-xs text-white">${product.quantity}</span>
              <button onclick="updateQty('${product.id}', ${product.quantity + 1})"
                      class="w-7 h-7 flex items-center justify-center rounded-lg text-gray-400 hover:text-white hover:bg-white/10 transition-all cursor-pointer">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/></svg>
              </button>
            </div>
            
            <!-- Tutar -->
            <div class="w-20 sm:w-24 text-right hidden sm:block">
              <span class="font-black text-primary text-base sm:text-lg">${Math.max(0, lineTotal).toFixed(2)} ₺</span>
            </div>

            <!-- Sil Butonu -->
            <button onclick="removeFromCart('${product.id}')"
                    class="w-9 h-9 flex items-center justify-center rounded-xl border border-red-500/20 text-red-400 hover:text-red-300 hover:bg-red-500/15 transition-colors cursor-pointer"
                    title="Ürünü Sil">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
            </button>
          </div>
        </div>
      `;
    });

    const countEl = document.getElementById('cart-count');
    if (countEl) countEl.innerText = cartProducts.length;

    let cartCouponDiscount = 0;
    if (appliedCoupon && appliedCoupon.type === 'cart_discount') {
      cartCouponDiscount = appliedCoupon.discountType === 'percentage'
        ? (totalSubtotal * appliedCoupon.discountValue) / 100
        : appliedCoupon.discountValue;
    }

    const grandTotal = Math.max(0, totalSubtotal - cartCouponDiscount);

    const subtotalEl = document.getElementById('subtotal');
    if (subtotalEl) subtotalEl.innerText = `${totalSubtotal.toFixed(2)} ₺`;

    const couponDiscountRow = document.getElementById('coupon-discount-row');
    const couponDiscountEl = document.getElementById('coupon-discount');
    if (cartCouponDiscount > 0 && couponDiscountRow && couponDiscountEl) {
      couponDiscountRow.classList.remove('hidden');
      couponDiscountRow.classList.add('flex');
      couponDiscountEl.innerText = `-${cartCouponDiscount.toFixed(2)} ₺`;
    } else if (couponDiscountRow) {
      couponDiscountRow.classList.add('hidden');
      couponDiscountRow.classList.remove('flex');
    }
    
    const totalEl = document.getElementById('total');
    if (totalEl) totalEl.innerText = `${grandTotal.toFixed(2)} ₺`;
    
    updateCartHeaderCount();
  }

  function updateQty(id, newQty) {
    if (newQty < 1) {
      removeFromCart(id);
      return;
    }
    const idx = cartProducts.findIndex(p => p.id === id);
    if (idx !== -1) {
      cartProducts[idx].quantity = newQty;
      saveCart();
      renderCart();
    }
  }

  function removeFromCart(id) {
    cartProducts = cartProducts.filter(p => p.id !== id);
    saveCart();
    if (cartProducts.length === 0) {
      loadCart();
    } else {
      renderCart();
    }
  }

  let clearCartTimeout;
  function clearCart(btn) {
    if (btn.classList.contains('confirm-mode')) {
      cartProducts = [];
      appliedCoupon = null;
      saveCart();
      loadCart();
      
      btn.classList.remove('confirm-mode', 'bg-red-600', 'text-white');
      btn.classList.add('bg-red-500/10', 'text-red-400');
      btn.innerHTML = `<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg> <span>Temizle</span>`;
      clearTimeout(clearCartTimeout);
    } else {
      btn.classList.add('confirm-mode', 'bg-red-600', 'text-white');
      btn.classList.remove('bg-red-500/10', 'text-red-400');
      btn.innerHTML = `<svg class="w-3.5 h-3.5 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg> <span>Emin misin?</span>`;
      
      clearCartTimeout = setTimeout(() => {
        btn.classList.remove('confirm-mode', 'bg-red-600', 'text-white');
        btn.classList.add('bg-red-500/10', 'text-red-400');
        btn.innerHTML = `<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg> <span>Temizle</span>`;
      }, 3000);
    }
  }

  function saveCart() {
    const minCart = cartProducts.map(p => ({ id: p.id, quantity: p.quantity }));
    localStorage.setItem('cart', JSON.stringify(minCart));
    updateCartHeaderCount();
  }

  function updateCartHeaderCount() {
    const minCart = JSON.parse(localStorage.getItem('cart') || '[]');
    const badges = document.querySelectorAll('.header-cart-badge');
    badges.forEach(b => {
      b.innerText = minCart.length;
      if (minCart.length > 0) b.classList.remove('hidden');
      else b.classList.add('hidden');
    });
  }

  async function applyCoupon() {
    const code = document.getElementById('couponCode').value.trim();
    if (!code) return;
    
    const btn = document.getElementById('applyCouponBtn');
    const ogText = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '...';

    try {
      const res = await fetch(`/api/storefront/v1/coupons/${code}`);
      const data = await res.json().catch(() => ({}));
      
      const c = data.data || (data.code || data.id ? data : null);
      if (res.ok && c && data.success !== false) {
        if (!c.isActive) {
          window.showToast?.('Kupon artık aktif değil.', 'error');
          return;
        }

        const currentSubtotal = cartProducts.reduce((sum, p) => sum + (Number(p.price) || 0) * p.quantity, 0);
        if (c.minCartValue && currentSubtotal < c.minCartValue) {
          window.showToast?.(`Minimum sepet tutarı: ${c.minCartValue}₺`, 'warning');
          return;
        }

        if (c.type === 'product_discount' && c.productId) {
          if (!cartProducts.some(p => p.id === c.productId)) {
            window.showToast?.('Bu kupon sepetinizdeki ürünler için geçerli değil.', 'error');
            return;
          }
        }

        appliedCoupon = c;
        document.getElementById('coupon-input-container').classList.add('hidden');
        document.getElementById('applied-coupon').classList.remove('hidden');
        document.getElementById('coupon-code-display').innerText = c.code;
        
        let desc = 'İndirim uygulandı';
        if (c.type === 'product_discount') desc = `Belirli ürünlere ${c.discountType==='percentage'?`%${c.discountValue}`:`${c.discountValue}₺`} indirim`;
        if (c.type === 'cart_discount') desc = `Sepete ${c.discountType==='percentage'?`%${c.discountValue}`:`${c.discountValue}₺`} indirim`;
        if (c.type === 'free_product') desc = `Ücretsiz ürün hediyesi!`;
        
        document.getElementById('coupon-description').innerText = desc;
        renderCart();
        window.showToast?.('Kupon uygulandı!', 'success');
      } else {
        window.showToast?.(data.message || 'Geçersiz kupon kodu.', 'error');
      }
    } catch (e) {
      window.showToast?.('Kupon kontrol edilemedi.', 'error');
    } finally {
      btn.disabled = false;
      btn.innerHTML = ogText;
    }
  }

  function removeCoupon() {
    appliedCoupon = null;
    document.getElementById('couponCode').value = '';
    document.getElementById('coupon-input-container').classList.remove('hidden');
    document.getElementById('applied-coupon').classList.add('hidden');
    renderCart();
  }

  let purchaseTimeout;
  async function purchase() {
    if (!isCustomer) {
      window.location.href = '/auth/login?return=/cart';
      return;
    }

    if (cartProducts.length === 0) return;

    const btn = document.getElementById('purchaseBtn');
    const ogText = '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/></svg> <span>Siparişi Tamamla</span>';

    if (!btn.classList.contains('confirm-mode')) {
      btn.classList.add('confirm-mode', 'bg-emerald-600');
      btn.classList.remove('bg-primary');
      btn.innerHTML = '<svg class="w-5 h-5 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> <span>Onaylıyor musunuz?</span>';
      
      purchaseTimeout = setTimeout(() => {
        btn.classList.remove('confirm-mode', 'bg-emerald-600');
        btn.classList.add('bg-primary');
        btn.innerHTML = ogText;
      }, 3000);
      return;
    }
    
    clearTimeout(purchaseTimeout);
    btn.disabled = true;
    btn.classList.remove('bg-emerald-600');
    btn.classList.add('bg-primary');
    btn.innerHTML = '<div class="w-5 h-5 border-2 border-white/20 border-t-white rounded-full animate-spin mr-2"></div> <span>İşleniyor...</span>';

    try {
      const productIds = cartProducts.map(p => p.id);
      const payload = { productIds };
      if (appliedCoupon) payload.coupon = appliedCoupon.code;

      const res = await fetch('/api/storefront/v1/marketplace/purchase', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();

      if (data.success || res.ok) {
        window.showToast?.('Sipariş başarıyla tamamlandı! Sandığa yönlendiriliyorsunuz.', 'success');
        localStorage.removeItem('cart');
        setTimeout(() => {
          window.location.href = '/chest';
        }, 2000);
      } else {
        window.showToast?.(data.message || 'Sipariş tamamlanamadı.', 'error');
        btn.disabled = false;
        btn.innerHTML = ogText;
      }
    } catch (e) {
      window.showToast?.('Bağlantı hatası.', 'error');
      btn.disabled = false;
      btn.innerHTML = ogText;
    }
  }

  document.addEventListener('DOMContentLoaded', loadCart);
</script>
