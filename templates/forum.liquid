<!-- ============================================================
     FORUM (Purpy Remastered Dark Luxury)
     ============================================================ -->
<div class="w-full max-w-[1350px] mx-auto px-4 sm:px-6 py-6 sm:py-10 space-y-8 min-h-[60vh]">
  <!-- Breadcrumb -->
  <div
    class="flex flex-wrap items-center gap-2 text-xs sm:text-sm font-semibold px-4 py-2.5 rounded-2xl border backdrop-blur-md w-fit shadow-lg"
    style="
      background: linear-gradient(135deg, rgba(26, 16, 32, 0.85), rgba(18, 10, 24, 0.85));
      border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.25);
    "
  >
    <a href="/" class="hover:text-primary transition-colors flex items-center gap-1.5" style="color: #cbd5e1;">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
      </svg>
    </a>
    <span class="text-gray-500">/</span>
    <span class="font-bold" style="color: var(--color-primary);">Forum</span>
  </div>

  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6 pb-2 border-b" style="border-color: rgba(255, 255, 255, 0.08);">
    <div class="flex items-center gap-3.5">
      <div class="w-2 h-10 rounded-full" style="background: linear-gradient(to bottom, var(--color-primary), #9333ea);"></div>
      <div>
        <h1 class="text-2xl sm:text-3xl font-black text-white uppercase tracking-wide" style="color: #ffffff !important;">
          Topluluk Forumu
        </h1>
        <p class="text-xs sm:text-sm font-medium text-gray-300">
          Oyuncularla etkileşime geçin, rehberleri inceleyin ve tartışmalara katılın.
        </p>
      </div>
    </div>

    {% if customer %}
      <a
        href="/forum/new"
        class="inline-flex items-center gap-2 px-6 py-3.5 rounded-2xl font-black text-xs uppercase tracking-wider text-white shadow-2xl transition-all duration-300 hover:scale-105 border border-white/20"
        style="background: linear-gradient(135deg, var(--color-primary), #9333ea);"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/>
        </svg>
        <span>Yeni Konu Aç</span>
      </a>
    {% endif %}
  </div>

  <!-- Main Layout -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- SOL / ORTA: Ana İçerik (8 Cols) -->
    <div class="lg:col-span-8 space-y-8">
      <!-- Kategoriler -->
      <div>
        <h2 class="text-lg sm:text-xl font-black text-white mb-4 flex items-center gap-2.5" style="color: #ffffff !important;">
          <div class="w-8 h-8 rounded-xl flex items-center justify-center bg-primary/20 text-primary border border-primary/40">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/>
            </svg>
          </div>
          <span>Kategoriler</span>
        </h2>

        {% if forumCategories and forumCategories.size > 0 %}
          <div class="grid gap-4 sm:grid-cols-2">
            {% for category in forumCategories %}
              <a
                href="/forum/{{ category.slug | default: category.id }}"
                class="rounded-3xl border-2 p-5 transition-all duration-300 group flex items-start gap-4 shadow-xl hover:border-primary/60 hover:scale-[1.02] backdrop-blur-xl cursor-pointer"
                style="
                  background: linear-gradient(135deg, rgba(26, 16, 32, 0.95), rgba(18, 10, 24, 0.95));
                  border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.20);
                "
              >
                <div class="w-12 h-12 rounded-2xl flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform shadow-lg border"
                     style="background: rgba(var(--color-primary-rgb, 124, 58, 237), 0.2); border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.4); color: var(--color-primary);">
                  {% if category.icon %}
                    <i class="{{ category.icon }} text-xl"></i>
                  {% else %}
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/>
                    </svg>
                  {% endif %}
                </div>
                <div class="flex-1 min-w-0">
                  <h3 class="font-black text-white group-hover:text-primary transition-colors text-base" style="color: #ffffff !important;">
                    {{ category.name }}
                  </h3>
                  <p class="text-xs text-gray-400 mt-1 line-clamp-2 leading-relaxed">{{ category.description }}</p>
                  <div class="flex items-center gap-3 mt-3 text-[11px] font-bold text-purple-300">
                    <span class="flex items-center gap-1">
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                      </svg>
                      <span>{{ category.topics.size | default: 0 }} Konu</span>
                    </span>
                  </div>
                </div>
              </a>
            {% endfor %}
          </div>
        {% else %}
          <div class="py-12 text-center rounded-3xl border-2 border-dashed flex flex-col items-center justify-center gap-2"
               style="background: rgba(14, 9, 20, 0.4); border-color: rgba(255, 255, 255, 0.08);">
            <p class="text-xs text-gray-400 font-bold">Henüz forum kategorisi bulunmuyor.</p>
          </div>
        {% endif %}
      </div>

      <!-- Son Konular -->
      <div>
        <h2 class="text-lg sm:text-xl font-black text-white mb-4 flex items-center gap-2.5" style="color: #ffffff !important;">
          <div class="w-8 h-8 rounded-xl flex items-center justify-center bg-primary/20 text-primary border border-primary/40">
            <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z"/>
            </svg>
          </div>
          <span>Son Konular</span>
        </h2>

        {% if forumStatistics.lastTopics and forumStatistics.lastTopics.size > 0 %}
          <div class="space-y-3">
            {% for topic in forumStatistics.lastTopics %}
              {% assign catSlug = topic.categoryId | default: 't' %}
              <a
                href="/forum/{{ catSlug }}/{{ topic.slug | default: topic.id }}"
                class="block rounded-3xl border-2 p-4 transition-all duration-300 group hover:border-primary/60 hover:scale-[1.01] backdrop-blur-xl shadow-lg cursor-pointer"
                style="
                  background: linear-gradient(135deg, rgba(26, 16, 32, 0.95), rgba(18, 10, 24, 0.95));
                  border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.20);
                "
              >
                <div class="flex items-start gap-4">
                  <div class="flex-shrink-0">
                    <img
                      src="https://mc-heads.net/avatar/{{ topic.authorName }}/48"
                      class="w-11 h-11 rounded-2xl border-2 border-primary/40 shadow"
                      alt="{{ topic.authorName }}"
                    >
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-2 mb-1 flex-wrap">
                      {% if topic.isPinned %}
                        <span class="px-2 py-0.5 text-amber-300 text-[10px] font-black uppercase tracking-wider rounded-lg border border-amber-500/30" style="background: rgba(245, 158, 11, 0.15);">
                          Sabit
                        </span>
                      {% endif %}
                      {% if topic.isLocked %}
                        <span class="px-2 py-0.5 text-rose-300 text-[10px] font-black uppercase tracking-wider rounded-lg border border-rose-500/30" style="background: rgba(239, 68, 68, 0.15);">
                          Kilitli
                        </span>
                      {% endif %}
                      <h3 class="font-black text-white group-hover:text-primary transition-colors truncate text-sm sm:text-base" style="color: #ffffff !important;">
                        {{ topic.title }}
                      </h3>
                    </div>
                    <div class="flex flex-wrap items-center gap-3 text-[11px] font-semibold text-gray-400">
                      <span class="text-purple-300 font-bold">{{ topic.authorName }}</span>
                      <span>•</span>
                      <span>{{ topic.createdAt | date: '%d.%m.%Y %H:%M' }}</span>
                      <span>•</span>
                      <span class="flex items-center gap-1">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                        {{ topic.viewCount | default: 0 }}
                      </span>
                      <span class="flex items-center gap-1">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
                        {{ topic.replyCount | default: 0 }}
                      </span>
                    </div>
                  </div>
                </div>
              </a>
            {% endfor %}
          </div>
        {% else %}
          <div class="py-12 text-center rounded-3xl border-2 border-dashed flex flex-col items-center justify-center gap-2"
               style="background: rgba(14, 9, 20, 0.4); border-color: rgba(255, 255, 255, 0.08);">
            <p class="text-xs text-gray-400 font-bold">Henüz konu bulunmuyor.</p>
          </div>
        {% endif %}
      </div>
    </div>

    <!-- SAĞ: Sidebar (4 Cols) -->
    <aside class="lg:col-span-4 space-y-6">
      {% unless customer %}
        <div
          class="rounded-3xl border-2 shadow-2xl p-6 text-center backdrop-blur-xl"
          style="
            background: linear-gradient(135deg, rgba(28, 16, 38, 0.95), rgba(18, 10, 24, 0.95));
            border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.30);
          "
        >
          <div class="w-14 h-14 rounded-2xl flex items-center justify-center mx-auto mb-4 border shadow-lg"
               style="background: rgba(var(--color-primary-rgb, 124, 58, 237), 0.2); border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.4); color: var(--color-primary);">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"/>
            </svg>
          </div>
          <h3 class="font-black text-white text-base mb-1" style="color: #ffffff !important;">Aramıza Katılın</h3>
          <p class="text-xs text-gray-300 font-medium mb-5">Konu açmak ve cevap yazmak için hesabınıza giriş yapın.</p>
          <a
            href="/auth/sign-in?return=/forum"
            class="block w-full py-3 rounded-2xl font-black text-xs uppercase tracking-wider text-white shadow-xl transition-all duration-300 hover:scale-105 border border-white/20 text-center"
            style="background: linear-gradient(135deg, var(--color-primary), #9333ea);"
          >
            Giriş Yap
          </a>
        </div>
      {% endunless %}

      {% if forumStatistics.lastMessages and forumStatistics.lastMessages.size > 0 %}
        <div
          class="rounded-3xl border-2 shadow-2xl p-6 backdrop-blur-xl"
          style="
            background: linear-gradient(135deg, rgba(26, 16, 32, 0.95), rgba(18, 10, 24, 0.95));
            border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.25);
          "
        >
          <h3 class="font-black text-white mb-4 text-sm flex items-center gap-2 pb-3 border-b" style="color: #ffffff !important; border-color: rgba(255, 255, 255, 0.08);">
            <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span>Son Aktiviteler</span>
          </h3>
          <div class="space-y-3.5">
            {% for msg in forumStatistics.lastMessages limit: 5 %}
              <div class="flex items-start gap-3 p-2 rounded-xl transition-colors hover:bg-white/5">
                <img
                  src="https://mc-heads.net/avatar/{{ msg.authorName }}/32"
                  class="w-7 h-7 rounded-xl border border-primary/30 flex-shrink-0"
                  alt=""
                >
                <div class="flex-1 min-w-0">
                  <p class="text-xs text-gray-300 line-clamp-2 font-medium">
                    <span class="font-black text-white" style="color: #ffffff !important;">{{ msg.authorName }}</span> yanıtladı.
                  </p>
                  <p class="text-[10px] font-semibold text-gray-400 mt-0.5">{{ msg.createdAt | date: '%d.%m.%Y %H:%M' }}</p>
                </div>
              </div>
            {% endfor %}
          </div>
        </div>
      {% endif %}

      {% if forumStatistics.topMessageUsers and forumStatistics.topMessageUsers.size > 0 %}
        <div
          class="rounded-3xl border-2 shadow-2xl p-6 backdrop-blur-xl"
          style="
            background: linear-gradient(135deg, rgba(26, 16, 32, 0.95), rgba(18, 10, 24, 0.95));
            border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.25);
          "
        >
          <h3 class="font-black text-white mb-4 text-sm flex items-center gap-2 pb-3 border-b" style="color: #ffffff !important; border-color: rgba(255, 255, 255, 0.08);">
            <svg class="w-4 h-4 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
            </svg>
            <span>En Aktif Kullanıcılar</span>
          </h3>
          <div class="space-y-2.5">
            {% for user in forumStatistics.topMessageUsers limit: 5 %}
              <div class="flex items-center justify-between p-2 rounded-xl" style="background: rgba(14, 9, 20, 0.6);">
                <div class="flex items-center gap-2.5">
                  <span class="text-[10px] font-black text-purple-300 w-4 text-center">#{{ forloop.index }}</span>
                  <img src="https://mc-heads.net/avatar/{{ user.username }}/28" class="w-6 h-6 rounded-lg border border-primary/30" alt="">
                  <span class="text-xs font-bold text-white">{{ user.username }}</span>
                </div>
                <span class="text-[10px] font-black px-2 py-0.5 rounded-lg border border-primary/30 text-purple-300"
                      style="background: rgba(var(--color-primary-rgb, 124, 58, 237), 0.15);">
                  {{ user.count }} msg
                </span>
              </div>
            {% endfor %}
          </div>
        </div>
      {% endif %}
    </aside>
  </div>
</div>
