<!-- ============================================================
     BAKIM MODU (Purpy Remastered Dark Luxury)
     ============================================================ -->
<div class="flex-grow flex items-center justify-center p-4 py-16 min-h-[70vh]">
  <div
    class="max-w-md w-full rounded-3xl border-2 p-8 sm:p-10 shadow-2xl text-center backdrop-blur-xl"
    style="
      background: linear-gradient(135deg, rgba(28, 16, 38, 0.95), rgba(18, 10, 24, 0.95));
      border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.35);
    "
  >
    <div
      class="w-20 h-20 rounded-3xl flex items-center justify-center mx-auto mb-6 shadow-2xl border"
      style="
        background: rgba(var(--color-primary-rgb, 124, 58, 237), 0.2);
        border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.45);
        color: var(--color-primary);
      "
    >
      <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
      </svg>
    </div>

    <h1 class="text-2xl sm:text-3xl font-black text-white tracking-tight mb-3" style="color: #ffffff !important;">
      {{ settings.maintenance.title | default: 'Bakım Çalışması' }}
    </h1>
    <p class="text-xs sm:text-sm text-gray-300 font-medium mb-8 max-w-sm mx-auto leading-relaxed">
      {{ settings.maintenance.description | default: 'Şu anda sistemlerimizde planlı bir bakım ve iyileştirme çalışması yürütülmektedir. Çok yakında geri döneceğiz. Anlayışınız için teşekkür ederiz.' }}
    </p>

    <a
      href="/auth/sign-in"
      class="inline-block px-6 py-3 rounded-2xl text-xs font-bold text-gray-300 hover:text-white border border-white/10 hover:border-primary/40 bg-white/5 hover:bg-white/10 transition-all hover:scale-105"
    >
      {{ settings.maintenance.footer_text | default: 'Yetkiniz varsa giriş yapıp görüntüleyebilirsiniz' }}
    </a>
  </div>
</div>
