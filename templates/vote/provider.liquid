<!-- ============================================================
     OY VERME İŞLEMİ (Purpy Remastered Dark Luxury)
     ============================================================ -->
<div class="w-full max-w-[1050px] mx-auto px-4 sm:px-6 py-6 sm:py-10 space-y-8 min-h-[60vh]">
  <!-- Breadcrumb -->
  <div
    class="flex flex-wrap items-center gap-2 text-xs sm:text-sm font-semibold px-4 py-2.5 rounded-2xl border backdrop-blur-md w-fit shadow-lg"
    style="
      background: linear-gradient(135deg, rgba(26, 16, 32, 0.85), rgba(18, 10, 24, 0.85));
      border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.25);
    "
  >
    <a href="/" class="hover:text-primary transition-colors flex items-center gap-1.5" style="color: #cbd5e1;">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
      </svg>
    </a>
    <span class="text-gray-500">/</span>
    <a href="/vote" class="hover:text-primary transition-colors" style="color: #cbd5e1;">Oy Ver</a>
    <span class="text-gray-500">/</span>
    <span class="font-bold capitalize" style="color: var(--color-primary);">
      {% if provider.type == 'serversmc' %}ServersMC{% else %}{{ provider.type }}{% endif %}
    </span>
  </div>

  <div class="max-w-2xl mx-auto">
    <div
      class="rounded-3xl border-2 shadow-2xl p-6 sm:p-10 backdrop-blur-xl relative overflow-hidden"
      style="
        background: linear-gradient(135deg, rgba(26, 16, 32, 0.95), rgba(18, 10, 24, 0.95));
        border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.25);
      "
    >
      <div class="flex items-center gap-5 mb-8 pb-6 border-b" style="border-color: rgba(255, 255, 255, 0.08);">
        {% if provider.logo %}
          <img src="{{ provider.logo }}" alt="{{ provider.type }}" class="w-16 h-16 rounded-2xl shadow-lg object-contain p-2 bg-white/5 border border-white/10">
        {% elsif provider.type == 'serversmc' %}
          <img src="/images/vote-providers/smc.webp" alt="ServersMC" class="w-16 h-16 rounded-2xl shadow-lg object-contain p-2 bg-white/5 border border-white/10">
        {% else %}
          <div class="w-16 h-16 rounded-2xl flex items-center justify-center shadow-lg border"
               style="background: rgba(var(--color-primary-rgb, 124, 58, 237), 0.2); border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.4); color: var(--color-primary);">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
        {% endif %}
        
        <div>
          <h2 class="text-xl sm:text-2xl font-black text-white capitalize" style="color: #ffffff !important;">
            {% if provider.type == 'serversmc' %}ServersMC{% else %}{{ provider.type }}{% endif %} Oy İşlemi
          </h2>
          <p class="text-xs text-gray-300 font-medium mt-1">Lütfen bekleme süresine dikkat ederek oy gönder butonuna tıklayın.</p>
        </div>
      </div>

      <div id="vote-status-container"></div>

      <!-- Success Message -->
      <div
        id="vote-success"
        class="hidden mb-6 p-4 rounded-2xl border flex items-center gap-3"
        style="background: rgba(16, 185, 129, 0.15); border-color: rgba(16, 185, 129, 0.4); color: #6ee7b7;"
      >
        <svg class="w-6 h-6 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
        <div>
          <h4 class="text-sm font-black text-emerald-300">Oy Gönderildi!</h4>
          <p id="vote-success-text" class="text-xs font-medium text-emerald-200 mt-0.5">
            Oyunuz başarıyla kaydedildi. Bizi desteklediğiniz için teşekkür ederiz!
          </p>
        </div>
      </div>

      <!-- Error Message -->
      <div
        id="vote-error"
        class="hidden mb-6 p-4 rounded-2xl border flex items-center gap-3"
        style="background: rgba(239, 68, 68, 0.15); border-color: rgba(239, 68, 68, 0.4); color: #fca5a5;"
      >
        <svg class="w-6 h-6 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        <div>
          <h4 class="text-sm font-black text-rose-300">Gönderim Başarısız</h4>
          <p id="vote-error-text" class="text-xs font-medium text-rose-200 mt-0.5">Oy gönderilirken bir hata oluştu.</p>
        </div>
      </div>

      <div class="space-y-4 pt-2">
        <button
          id="btn-submit-vote"
          class="w-full py-4.5 rounded-2xl font-black text-sm uppercase tracking-wider text-white shadow-2xl transition-all duration-300 hover:scale-[1.02] flex items-center justify-center gap-3 border border-white/20 cursor-pointer"
          style="
            background: linear-gradient(135deg, var(--color-primary), #9333ea);
            box-shadow: 0 10px 30px rgba(var(--color-primary-rgb, 124, 58, 237), 0.45);
          "
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <span>Oy Ver & Ödülü Al</span>
        </button>

        <a
          href="/vote"
          class="w-full flex items-center justify-center py-3.5 rounded-2xl text-xs font-bold uppercase tracking-wider text-gray-300 hover:text-white border border-white/10 hover:border-primary/40 bg-white/5 hover:bg-white/10 transition-all text-center"
        >
          Geri Dön
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const btnSubmit = document.getElementById('btn-submit-vote');
    const boxSuccess = document.getElementById('vote-success');
    const boxError = document.getElementById('vote-error');
    const textSuccess = document.getElementById('vote-success-text');
    const textError = document.getElementById('vote-error-text');
    const statusContainer = document.getElementById('vote-status-container');
    const providerId = '{{ provider.id | default: provider._id }}';

    let canVote = true;

    {% if customer.nextVoteAt %}
      const nextVote = new Date('{{ customer.nextVoteAt }}');
      if (nextVote > new Date()) {
        canVote = false;
        
        if (statusContainer) {
          statusContainer.innerHTML = `
            <div class="mb-6 p-4 rounded-2xl border flex items-center gap-3 text-xs font-bold"
                 style="background: rgba(245, 158, 11, 0.15); border-color: rgba(245, 158, 11, 0.35); color: #fcd34d;">
              <svg class="w-5 h-5 text-amber-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              <div>
                <div class="font-black text-amber-300">Bekleme Süresi Aktif</div>
                <div class="text-[11px] text-amber-200 mt-0.5">Sonraki oy hakkı: ${nextVote.toLocaleString('tr-TR')}</div>
              </div>
            </div>
          `;
        }

        if (btnSubmit) {
          btnSubmit.disabled = true;
          btnSubmit.style.opacity = '0.5';
          btnSubmit.style.cursor = 'not-allowed';
          btnSubmit.innerHTML = `
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <span>Şu An Oy Veremezsiniz</span>
          `;
        }
      } else {
        if (statusContainer) {
          statusContainer.innerHTML = `
            <div class="mb-6 p-3.5 rounded-2xl border flex items-center justify-center gap-2 text-xs font-black uppercase tracking-wider text-emerald-300"
                 style="background: rgba(16, 185, 129, 0.15); border-color: rgba(16, 185, 129, 0.35);">
              <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              <span>Şimdi Oy Verebilirsiniz</span>
            </div>
          `;
        }
      }
    {% else %}
      if (statusContainer) {
        statusContainer.innerHTML = `
          <div class="mb-6 p-3.5 rounded-2xl border flex items-center justify-center gap-2 text-xs font-black uppercase tracking-wider text-emerald-300"
               style="background: rgba(16, 185, 129, 0.15); border-color: rgba(16, 185, 129, 0.35);">
            <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <span>Şimdi Oy Verebilirsiniz</span>
          </div>
        `;
      }
    {% endif %}

    btnSubmit?.addEventListener('click', async () => {
      if (!canVote) return;

      boxError?.classList.add('hidden');
      boxSuccess?.classList.add('hidden');
      
      btnSubmit.disabled = true;
      btnSubmit.innerHTML = `
        <div class="w-4 h-4 border-2 border-white/20 border-t-white rounded-full animate-spin mr-2"></div>
        <span>İşleniyor...</span>
      `;

      try {
        const res = await fetch('/api/storefront/config/vote-providers/vote', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ providerId })
        });
        
        const data = await res.json();
        
        if (res.ok && !data.error && data.status !== false) {
          boxSuccess?.classList.remove('hidden');
          if (data.message && textSuccess) {
            textSuccess.innerText = data.message;
          }
          setTimeout(() => {
            window.location.reload();
          }, 2000);
        } else {
          boxError?.classList.remove('hidden');
          if (textError) textError.innerText = data.message || data.error || 'Oy gönderilirken bir hata oluştu.';
          
          btnSubmit.disabled = false;
          btnSubmit.innerHTML = `
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <span>Tekrar Dene</span>
          `;
        }
      } catch (err) {
        boxError?.classList.remove('hidden');
        if (textError) textError.innerText = 'Sunucuyla bağlantı kurulamadı.';
        btnSubmit.disabled = false;
        btnSubmit.innerHTML = `
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <span>Tekrar Dene</span>
        `;
      }
    });
  });
</script>
