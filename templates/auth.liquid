{% if websiteData.security.cf_turnstile.site_key %}
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
{% endif %}

<div class="relative w-full min-h-screen flex items-center justify-center p-4 sm:p-6 lg:p-10 overflow-hidden" style="background: #0e0914;">
  <!-- Background Blurred Wallpaper -->
  <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
    <img
      src="{% if settings.auth.background %}{{ settings.auth.background }}{% elsif settings.header.banner %}{{ settings.header.banner }}{% else %}https://images.unsplash.com/photo-1627856013091-fed6e4e30025?q=80&w=2070&auto=format&fit=crop{% endif %}"
      alt="Background"
      class="w-full h-full object-cover blur-md opacity-25 scale-105"
    >
    <div class="absolute inset-0 bg-gradient-to-t from-[#0e0914] via-[#0e0914]/85 to-[#0e0914]/60"></div>
    <div class="absolute -top-40 -left-40 w-96 h-96 rounded-full blur-3xl opacity-20" style="background: var(--color-primary);"></div>
    <div class="absolute -bottom-40 -right-40 w-96 h-96 rounded-full blur-3xl opacity-20" style="background: var(--color-primary);"></div>
  </div>

  <!-- Main Container -->
  <div class="w-full max-w-[1200px] mx-auto relative z-10">
    <div
      class="grid grid-cols-1 lg:grid-cols-12 rounded-3xl overflow-hidden border-2 shadow-2xl backdrop-blur-xl"
      style="
        background: linear-gradient(135deg, rgba(26, 16, 32, 0.95), rgba(18, 10, 24, 0.95));
        border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.25);
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7);
      "
    >
      <!-- LEFT SIDE: Forms (7 Cols) -->
      <div class="lg:col-span-7 p-6 sm:p-10 lg:p-14 flex flex-col justify-center relative">
        <!-- Back to Home -->
        <a
          href="/"
          class="inline-flex items-center gap-2 text-xs sm:text-sm font-bold text-gray-400 hover:text-primary transition-colors mb-6 w-fit"
          style="color: #cbd5e1;"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
          </svg>
          <span>Ana Sayfaya Dön</span>
        </a>

        <!-- Logo -->
        <a href="/" class="block mb-6">
          {% assign default_logo = 'https://avatars.githubusercontent.com/u/3840546?s=280&v=4' %}
          <img
            src="{{ settings.logo_light | default: default_logo }}"
            alt="{{ shop.name }}"
            class="h-12 sm:h-14 object-contain drop-shadow-md"
          >
        </a>

        <!-- AUTH ALERT BANNER -->
        <div id="authAlertBanner" class="hidden mb-6 p-4 rounded-2xl border text-sm font-bold flex items-start gap-3 shadow-lg animate-[fade-in_300ms_ease-out]">
          <div id="authAlertIcon" class="text-base shrink-0 mt-0.5"></div>
          <div class="flex-1">
            <div id="authAlertTitle" class="uppercase tracking-wider font-black mb-0.5"></div>
            <div id="authAlertDesc" class="font-medium text-xs opacity-90 leading-relaxed"></div>
          </div>
          <button type="button" onclick="document.getElementById('authAlertBanner').classList.add('hidden')" class="text-gray-400 hover:text-white">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>

        <!-- ================= LOGIN FORM ================= -->
        <div
          id="login-container"
          class="auth-step {% if request.path contains 'sign-up' or request.path contains 'register' %}hidden{% endif %} transition-all duration-300"
        >
          <div class="mb-6">
            <h1 class="text-2xl sm:text-3xl lg:text-4xl font-black tracking-tight text-white mb-2" style="color: #ffffff !important;">
              {{ settings.auth.login_title | default: 'Tekrar Hoş Geldiniz!' }}
            </h1>
            <p class="text-xs sm:text-sm font-medium" style="color: #94a3b8;">
              {{ settings.auth.login_description | default: 'Devam etmek için hesabınıza giriş yapın.' }}
            </p>
          </div>

          <!-- Discord Login Button -->
          <button
            type="button"
            onclick="handleDiscordAuth('login')"
            class="w-full mb-4 py-3.5 px-4 rounded-xl text-xs sm:text-sm font-black uppercase tracking-wider text-white bg-[#5865F2] hover:bg-[#4752C4] transition-all flex items-center justify-center gap-2 border border-[#5865F2]/40 shadow-lg shadow-[#5865F2]/20 cursor-pointer"
          >
            <i class="fa-brands fa-discord text-lg"></i>
            <span>Discord ile Giriş Yap</span>
          </button>

          <div class="relative flex py-2 items-center mb-4">
            <div class="flex-grow border-t border-purple-900/40"></div>
            <span class="flex-shrink mx-4 text-xs font-bold text-gray-500 uppercase tracking-widest">VEYA</span>
            <div class="flex-grow border-t border-purple-900/40"></div>
          </div>

          <form id="loginForm" class="space-y-4">
            <div>
              <label class="block text-xs font-black uppercase tracking-wider text-gray-300 mb-1.5">
                Kullanıcı Adı
              </label>
              <div class="relative">
                <input
                  type="text"
                  name="username"
                  required
                  placeholder="Kullanıcı adınızı girin"
                  class="w-full text-white text-sm rounded-xl px-4 py-3.5 border-2 transition-all outline-none"
                  style="
                    background: rgba(14, 9, 20, 0.85);
                    border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.25);
                    color: #ffffff;
                  "
                  onfocus="this.style.borderColor='var(--color-primary)';"
                  onblur="this.style.borderColor='rgba(var(--color-primary-rgb, 124, 58, 237), 0.25)';"
                >
              </div>
            </div>

            <div>
              <div class="flex items-center justify-between mb-1.5">
                <label class="block text-xs font-black uppercase tracking-wider text-gray-300">
                  Şifre
                </label>
                <a
                  href="/auth/password/forgot"
                  class="text-xs font-bold transition-colors hover:underline"
                  style="color: var(--color-primary);"
                >
                  Şifremi Unuttum?
                </a>
              </div>
              <div class="relative">
                <input
                  id="login-password"
                  type="password"
                  name="password"
                  required
                  placeholder="••••••••"
                  class="w-full text-white text-sm rounded-xl px-4 py-3.5 pr-12 border-2 transition-all outline-none"
                  style="
                    background: rgba(14, 9, 20, 0.85);
                    border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.25);
                    color: #ffffff;
                  "
                  onfocus="this.style.borderColor='var(--color-primary)';"
                  onblur="this.style.borderColor='rgba(var(--color-primary-rgb, 124, 58, 237), 0.25)';"
                >
                <button
                  type="button"
                  onclick="togglePasswordVisibility('login-password', this)"
                  class="absolute right-3.5 top-1/2 -translate-y-1/2 text-gray-400 hover:text-white transition-colors cursor-pointer"
                >
                  <svg class="w-5 h-5 eye-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                </button>
              </div>
            </div>

            {% if websiteData.security.cf_turnstile.site_key %}
              <div class="cf-turnstile mt-2" data-sitekey="{{ websiteData.security.cf_turnstile.site_key }}"></div>
            {% endif %}

            <button
              type="submit"
              class="w-full py-4 px-6 rounded-xl font-black text-xs sm:text-sm uppercase tracking-wider text-white shadow-xl transition-all duration-300 hover:scale-[1.02] flex items-center justify-center gap-2 cursor-pointer mt-2"
              style="background: linear-gradient(135deg, var(--color-primary), #9333ea);"
            >
              <span>Giriş Yap</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </button>
          </form>

          <p class="text-center text-xs sm:text-sm font-medium mt-6 text-gray-400">
            Henüz hesabınız yok mu?
            <button
              type="button"
              onclick="toggleAuth('register')"
              class="font-black hover:underline ml-1 cursor-pointer"
              style="color: var(--color-primary);"
            >
              Hemen Kayıt Ol
            </button>
          </p>
        </div>

        <!-- ================= 2. REGISTER FORM ================= -->
        <div
          id="register-container"
          class="auth-step {% unless request.path contains 'sign-up' or request.path contains 'register' %}hidden{% endunless %} transition-all duration-300"
        >
          <div class="mb-6">
            <h1 class="text-2xl sm:text-3xl lg:text-4xl font-black tracking-tight text-white mb-2" style="color: #ffffff !important;">
              {{ settings.auth.register_title | default: 'Maceraya Katıl!' }}
            </h1>
            <p class="text-xs sm:text-sm font-medium" style="color: #94a3b8;">
              {{ settings.auth.register_description | default: 'Hemen ücretsiz bir hesap oluştur ve binlerce oyuncu arasına katıl.' }}
            </p>
          </div>

          <form id="registerForm" class="space-y-3.5">
            <div>
              <label class="block text-xs font-black uppercase tracking-wider text-gray-300 mb-1.5">
                Kullanıcı Adı
              </label>
              <input
                type="text"
                name="username"
                required
                placeholder="Minecraft kullanıcı adınız"
                class="w-full text-white text-sm rounded-xl px-4 py-3 border-2 transition-all outline-none"
                style="
                  background: rgba(14, 9, 20, 0.85);
                  border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.25);
                  color: #ffffff;
                "
                onfocus="this.style.borderColor='var(--color-primary)';"
                onblur="this.style.borderColor='rgba(var(--color-primary-rgb, 124, 58, 237), 0.25)';"
              >
            </div>

            <div>
              <label class="block text-xs font-black uppercase tracking-wider text-gray-300 mb-1.5">
                E-posta Adresi
              </label>
              <input
                type="email"
                name="email"
                required
                placeholder="ornek@minecraft.com"
                class="w-full text-white text-sm rounded-xl px-4 py-3 border-2 transition-all outline-none"
                style="
                  background: rgba(14, 9, 20, 0.85);
                  border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.25);
                  color: #ffffff;
                "
                onfocus="this.style.borderColor='var(--color-primary)';"
                onblur="this.style.borderColor='rgba(var(--color-primary-rgb, 124, 58, 237), 0.25)';"
              >
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label class="block text-xs font-black uppercase tracking-wider text-gray-300 mb-1.5">
                  Şifre
                </label>
                <input
                  type="password"
                  name="password"
                  required
                  placeholder="••••••••"
                  class="w-full text-white text-sm rounded-xl px-4 py-3 border-2 transition-all outline-none"
                  style="
                    background: rgba(14, 9, 20, 0.85);
                    border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.25);
                    color: #ffffff;
                  "
                  onfocus="this.style.borderColor='var(--color-primary)';"
                  onblur="this.style.borderColor='rgba(var(--color-primary-rgb, 124, 58, 237), 0.25)';"
                >
              </div>

              <div>
                <label class="block text-xs font-black uppercase tracking-wider text-gray-300 mb-1.5">
                  Şifre Tekrar
                </label>
                <input
                  type="password"
                  name="confirm_password"
                  required
                  placeholder="••••••••"
                  class="w-full text-white text-sm rounded-xl px-4 py-3 border-2 transition-all outline-none"
                  style="
                    background: rgba(14, 9, 20, 0.85);
                    border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.25);
                    color: #ffffff;
                  "
                  onfocus="this.style.borderColor='var(--color-primary)';"
                  onblur="this.style.borderColor='rgba(var(--color-primary-rgb, 124, 58, 237), 0.25)';"
                >
              </div>
            </div>

            <div class="flex items-center gap-2 pt-1">
              <input
                type="checkbox"
                id="terms"
                required
                class="w-4 h-4 rounded text-purple-600 bg-gray-900 border-gray-700 cursor-pointer"
              >
              <label for="terms" class="text-xs text-gray-400 cursor-pointer">
                <a href="/legal/terms" target="_blank" class="text-purple-400 hover:underline">Hizmet Şartları</a> ve <a href="/legal/privacy" target="_blank" class="text-purple-400 hover:underline">Gizlilik Politikasını</a> kabul ediyorum.
              </label>
            </div>

            {% if websiteData.security.cf_turnstile.site_key %}
              <div class="cf-turnstile mt-2" data-sitekey="{{ websiteData.security.cf_turnstile.site_key }}"></div>
            {% endif %}

            <button
              type="submit"
              id="registerSubmitBtn"
              class="w-full py-4 px-6 rounded-xl font-black text-xs sm:text-sm uppercase tracking-wider text-white shadow-xl transition-all duration-300 hover:scale-[1.02] flex items-center justify-center gap-2 cursor-pointer mt-2"
              style="background: linear-gradient(135deg, var(--color-primary), #9333ea);"
            >
              <span>Hesap Oluştur</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
              </svg>
            </button>
          </form>

          <p class="text-center text-xs sm:text-sm font-medium mt-6 text-gray-400">
            Zaten bir hesabınız var mı?
            <button
              type="button"
              onclick="toggleAuth('login')"
              class="font-black hover:underline ml-1 cursor-pointer"
              style="color: var(--color-primary);"
            >
              Giriş Yap
            </button>
          </p>
        </div>

        <!-- ================= 3. EMAIL OTP FORM ================= -->
        <div id="email-otp-container" class="auth-step hidden transition-all duration-300">
          <div class="mb-6">
            <h1 class="text-2xl sm:text-3xl font-black tracking-tight text-white mb-2">E-Posta Doğrulama Kodu</h1>
            <p class="text-xs sm:text-sm text-gray-400">
              Güvenliğiniz için <strong id="otpMaskedEmail" class="text-purple-400">e-postanıza</strong> bir doğrulama kodu gönderildi.
            </p>
          </div>

          <form id="emailOtpForm" class="space-y-4">
            <div>
              <label class="block text-xs font-black uppercase tracking-wider text-gray-300 mb-1.5">6 Haneli Doğrulama Kodu</label>
              <input
                type="text"
                id="otpCodeInput"
                required
                maxlength="6"
                placeholder="123456"
                class="w-full text-center tracking-[0.3em] font-mono text-2xl font-black bg-gray-900 border-2 border-purple-900/40 text-white rounded-xl px-4 py-3 outline-none focus:border-purple-500 transition-all"
              >
            </div>

            <button
              type="submit"
              id="otpSubmitBtn"
              class="w-full py-4 px-6 rounded-xl font-black text-xs sm:text-sm uppercase tracking-wider text-white shadow-xl transition-all hover:scale-[1.02] flex items-center justify-center gap-2 cursor-pointer"
              style="background: linear-gradient(135deg, var(--color-primary), #9333ea);"
            >
              <span>Doğrula ve Giriş Yap</span>
            </button>
          </form>

          <div class="flex items-center justify-between text-xs font-bold text-gray-400 mt-6 pt-4 border-t border-purple-900/30">
            <button type="button" id="resendOtpBtn" onclick="resendEmailOtp()" class="hover:text-purple-400 transition-colors flex items-center gap-1.5">
              <span>Kodu Tekrar Gönder</span>
            </button>
            <button type="button" onclick="switchAuthStep('login-container')" class="hover:text-white transition-colors">
              Girişe Dön
            </button>
          </div>
        </div>

        <!-- ================= 4. TEMP EMAIL UPDATE ================= -->
        <div id="temp-email-container" class="auth-step hidden transition-all duration-300">
          <div class="mb-6">
            <h1 class="text-2xl sm:text-3xl font-black tracking-tight text-white mb-2">E-Posta Adresinizi Güncelleyin</h1>
            <p class="text-xs sm:text-sm text-gray-400">
              Hesabınızda geçici bir e-posta adresi tanımlı. Güvenliğiniz için lütfen geçerli e-posta adresinizi giriniz.
            </p>
          </div>

          <form id="tempEmailForm" class="space-y-4">
            <div>
              <label class="block text-xs font-black uppercase tracking-wider text-gray-300 mb-1.5">Yeni E-Posta Adresiniz</label>
              <input
                type="email"
                id="tempEmailInput"
                required
                placeholder="adiniz@example.com"
                class="w-full text-white text-sm rounded-xl px-4 py-3.5 border-2 border-purple-900/40 bg-gray-900 outline-none focus:border-purple-500 transition-all"
              >
            </div>

            <button
              type="submit"
              id="tempEmailSubmitBtn"
              class="w-full py-4 px-6 rounded-xl font-black text-xs sm:text-sm uppercase tracking-wider text-white shadow-xl transition-all hover:scale-[1.02] flex items-center justify-center gap-2 cursor-pointer"
              style="background: linear-gradient(135deg, var(--color-primary), #9333ea);"
            >
              <span>Devam Et ve Kod Gönder</span>
            </button>
          </form>

          <div class="text-center mt-6 pt-4 border-t border-purple-900/30">
            <button type="button" onclick="switchAuthStep('login-container')" class="text-xs font-bold text-gray-400 hover:text-white">
              Girişe Dön
            </button>
          </div>
        </div>

        <!-- ================= 5. 2FA VERIFICATION ================= -->
        <div id="twofa-container" class="auth-step hidden transition-all duration-300">
          <div class="mb-6">
            <h1 class="text-2xl sm:text-3xl font-black tracking-tight text-white mb-2">İki Aşamalı Doğrulama (2FA)</h1>
            <p class="text-xs sm:text-sm text-gray-400" id="twofaDescription">
              Lütfen iki aşamalı doğrulama kodunuzu giriniz.
            </p>
          </div>

          <div id="twofaMethodsContainer" class="flex flex-wrap gap-2 mb-4"></div>

          <form id="twofaForm" class="space-y-4">
            <div>
              <div class="flex items-center justify-between mb-1.5">
                <label id="twofaInputLabel" class="block text-xs font-black uppercase tracking-wider text-gray-300">6 Haneli Kod</label>
                <button type="button" id="twofaEmailSendBtn" onclick="sendTwoFaEmailCode()" class="text-xs font-bold text-purple-400 hover:underline hidden">Kodu E-Postama Gönder</button>
              </div>
              <input
                type="text"
                id="twofaCodeInput"
                required
                maxlength="10"
                placeholder="123456"
                class="w-full text-center tracking-[0.3em] font-mono text-2xl font-black bg-gray-900 border-2 border-purple-900/40 text-white rounded-xl px-4 py-3 outline-none focus:border-purple-500 transition-all"
              >
            </div>

            <button
              type="submit"
              id="twofaSubmitBtn"
              class="w-full py-4 px-6 rounded-xl font-black text-xs sm:text-sm uppercase tracking-wider text-white shadow-xl transition-all hover:scale-[1.02] flex items-center justify-center gap-2 cursor-pointer"
              style="background: linear-gradient(135deg, var(--color-primary), #9333ea);"
            >
              <span>Doğrula ve Giriş Yap</span>
            </button>
          </form>

          <div class="text-center mt-6 pt-4 border-t border-purple-900/30">
            <button type="button" onclick="switchAuthStep('login-container')" class="text-xs font-bold text-gray-400 hover:text-white">
              Girişe Dön
            </button>
          </div>
        </div>
      </div>

      <!-- RIGHT SIDE: Showcase Artwork (5 Cols) -->
      <div
        class="hidden lg:flex lg:col-span-5 relative overflow-hidden flex-col justify-end p-10 xl:p-12 border-l-2"
        style="
          background: linear-gradient(180deg, rgba(20, 12, 28, 0.7) 0%, rgba(14, 9, 20, 0.95) 100%);
          border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.20);
        "
      >
        <!-- Showcase Artwork Image -->
        <img
          src="{% if settings.auth.background %}{{ settings.auth.background }}{% elsif settings.header.banner %}{{ settings.header.banner }}{% else %}https://images.unsplash.com/photo-1627856013091-fed6e4e30025?q=80&w=2070&auto=format&fit=crop{% endif %}"
          alt="Showcase"
          class="absolute inset-0 w-full h-full object-cover opacity-35 mix-blend-luminosity"
        >
        <div class="absolute inset-0 bg-gradient-to-t from-[#0e0914] via-[#0e0914]/70 to-transparent"></div>

        <!-- Ambient Glow -->
        <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-64 h-64 rounded-full blur-3xl opacity-30 pointer-events-none"
             style="background: var(--color-primary);"></div>

        <div class="relative z-10 space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-black uppercase tracking-wider border"
               style="background: rgba(var(--color-primary-rgb, 124, 58, 237), 0.2); border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.4); color: var(--color-primary);">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>Sunucumuz Aktif</span>
          </div>

          <h2 class="text-3xl xl:text-4xl font-black text-white leading-tight" style="color: #ffffff !important;">
            {{ settings.auth.right_title | default: "Minecraft Dünyasına\nAdımını At" | newline_to_br }}
          </h2>

          <p class="text-sm font-medium leading-relaxed" style="color: #cbd5e1;">
            {{ settings.auth.right_description | default: "Hemen aramıza katıl, arkadaşlarınla birlikte devasa haritalarda hayatta kal, mini oyunlarda yeteneklerini göster ve efsanevi ödüller kazan!" }}
          </p>

          <!-- Live Player Counter -->
          <div
            class="flex items-center gap-4 p-4 rounded-2xl border backdrop-blur-md"
            style="background: rgba(14, 9, 20, 0.75); border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.3);"
          >
            <div class="w-12 h-12 rounded-xl flex items-center justify-center"
                 style="background: rgba(var(--color-primary-rgb, 124, 58, 237), 0.2); color: var(--color-primary);">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
              </svg>
            </div>
            <div>
              <div class="text-[11px] font-bold uppercase tracking-wider text-gray-400">Çevrimiçi Oyuncu</div>
              <div class="text-xl font-black text-white flex items-center gap-1.5" style="color: #ffffff !important;">
                <span id="auth-online-count" class="server-player-count text-emerald-400">
                  {% if statistics.onlinePlayers -%}
                    {{- statistics.onlinePlayers -}}
                  {%- else -%}
                    ...
                  {%- endif %}
                </span>
                <span class="text-xs font-semibold text-gray-300">Oyuncu Aktif</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  let currentAuthTokens = {
    emailToken: null,
    tempToken: null,
    maskedEmail: null,
    twoFaMethods: [],
    currentTwoFaMethod: 'authenticator',
  };

  // Server Status
  const serverIp = '{{ settings.server_ip | default: "mc.hypixel.net" }}';
  async function fetchAuthServerStatus() {
    try {
      const res = await fetch(`https://api.mcstatus.io/v2/status/java/${serverIp}`);
      if (res.ok) {
        const data = await res.json();
        return data.players ? data.players.online : (data.online ? 1 : 0);
      }
    } catch (e) {
      try {
        const res2 = await fetch(`https://mcapi.tr/api/v1/status/${serverIp}`);
        if (res2.ok) {
          const data2 = await res2.json();
          if (data2.online && data2.players) return data2.players.online;
        }
      } catch (e2) {}
    }
    return null;
  }

  fetchAuthServerStatus().then((online) => {
    const el = document.getElementById('auth-online-count');
    if (el) {
      el.classList.remove('animate-pulse');
      if (online !== null) {
        el.innerText = online;
      }
    }
  });

  function showAlert(title, message, type = 'error') {
    const banner = document.getElementById('authAlertBanner');
    const titleEl = document.getElementById('authAlertTitle');
    const descEl = document.getElementById('authAlertDesc');
    const iconEl = document.getElementById('authAlertIcon');

    if (banner && titleEl && descEl && iconEl) {
      if (type === 'success') {
        banner.className = 'mb-6 p-4 rounded-2xl border bg-emerald-950/80 border-emerald-500/50 text-emerald-200 text-sm font-bold flex items-start gap-3 shadow-lg animate-[fade-in_300ms_ease-out]';
        iconEl.innerHTML = `<svg class="w-5 h-5 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>`;
      } else if (type === 'warning' || type === 'info') {
        banner.className = 'mb-6 p-4 rounded-2xl border bg-amber-950/80 border-amber-500/50 text-amber-200 text-sm font-bold flex items-start gap-3 shadow-lg animate-[fade-in_300ms_ease-out]';
        iconEl.innerHTML = `<svg class="w-5 h-5 text-amber-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`;
      } else {
        banner.className = 'mb-6 p-4 rounded-2xl border bg-red-950/80 border-red-500/50 text-red-200 text-sm font-bold flex items-start gap-3 shadow-lg animate-[fade-in_300ms_ease-out]';
        iconEl.innerHTML = `<svg class="w-5 h-5 text-red-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`;
      }

      titleEl.innerText = title;
      descEl.innerText = message;
      banner.classList.remove('hidden');
    }

    if (window.showToast) {
      window.showToast(message || title, type);
    }
  }

  function switchAuthStep(stepId) {
    document.querySelectorAll('.auth-step').forEach((el) => el.classList.add('hidden'));
    const target = document.getElementById(stepId);
    if (target) target.classList.remove('hidden');
  }

  function togglePasswordVisibility(inputId, btn) {
    const input = document.getElementById(inputId);
    if (!input) return;
    if (input.type === 'password') {
      input.type = 'text';
      btn.innerHTML = `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18"/></svg>`;
    } else {
      input.type = 'password';
      btn.innerHTML = `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>`;
    }
  }

  function toggleAuth(type) {
    switchAuthStep(type === 'register' ? 'register-container' : 'login-container');
    const newPath = type === 'register' ? '/auth/sign-up' : '/auth/sign-in';
    window.history.pushState({}, '', newPath);
  }

  function handleSuccessfulLogin(res) {
    const payload = res.data || res;
    if (payload.accessToken || res.accessToken) {
      try {
        localStorage.setItem('accessToken', payload.accessToken || res.accessToken);
        if (payload.refreshToken || res.refreshToken) {
          localStorage.setItem('refreshToken', payload.refreshToken || res.refreshToken);
        }
        if (payload.user || res.user) {
          localStorage.setItem('user', JSON.stringify(payload.user || res.user));
        }
      } catch (e) {}
    }

    showAlert('Giriş Başarılı', payload.message || res.message || 'Giriş başarılı! Yönlendiriliyorsunuz...', 'success');

    const urlParams = new URLSearchParams(window.location.search);
    const returnUrl = urlParams.get('return') || '/';
    setTimeout(() => {
      window.location.href = returnUrl;
    }, 600);
  }

  // Discord OAuth
  async function handleDiscordAuth(action = 'login') {
    try {
      const redirectUri = window.location.origin + '/';
      const res = await fetch(`/api/storefront/v2/auth/discord?action=${action}&redirectUri=${encodeURIComponent(redirectUri)}`);
      const data = await res.json();
      if (data.success && data.data?.oauthUrl) window.location.href = data.data.oauthUrl;
      else if (data.oauthUrl) window.location.href = data.oauthUrl;
      else showAlert('Discord Hatası', data.message || 'Discord giriş bağlantısı alınamadı!', 'error');
    } catch (e) {
      showAlert('Bağlantı Hatası', 'Discord servisine bağlanılamadı!', 'error');
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    const params = new URLSearchParams(window.location.search);
    const accessToken = params.get('accessToken');
    const refreshToken = params.get('refreshToken');
    const discordError = params.get('discord_error');
    const discordUsername = params.get('discord_username');
    const generalError = params.get('error');

    if (accessToken) {
      handleSuccessfulLogin({ accessToken, refreshToken, message: 'Discord ile giriş başarılı!' });
      return;
    }

    if (discordError === 'NOT_LINKED') {
      const uName = discordUsername ? decodeURIComponent(discordUsername) : 'Discord';
      showAlert(
        'Discord Hesabı Eşleşmedi',
        `"${uName}" Discord hesabınız ile eşleşen bir oyuncu hesabı bulunamadı. Lütfen önce standart kullanıcı adı ve şifrenizle giriş yapıp Profil sayfanızdan Discord hesabınızı bağlayınız.`,
        'error'
      );
    } else if (discordError === 'ALREADY_LINKED_TO_ANOTHER_ACCOUNT') {
      showAlert('Discord Bağlantı Hatası', 'Bu Discord hesabı zaten bu sitedeki başka bir oyuncu hesabına bağlı.', 'error');
    } else if (discordError === 'USER_BANNED') {
      showAlert('Hesap Yasaklandı', 'Hesabınız sunucu kuralları gereği yasaklanmıştır.', 'error');
    } else if (discordError) {
      showAlert('Discord Hatası', decodeURIComponent(discordError), 'error');
    } else if (generalError) {
      showAlert('Giriş Hatası', decodeURIComponent(generalError), 'error');
    }
  });

  // Handle Login
  document.getElementById('loginForm')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(e.target);
    const data = Object.fromEntries(formData.entries());

    if (data['cf-turnstile-response']) {
      data.turnstileToken = data['cf-turnstile-response'];
      delete data['cf-turnstile-response'];
    }

    const btn = e.target.querySelector('button[type="submit"]');
    const originalText = btn.innerHTML;

    btn.disabled = true;
    btn.innerHTML = '<span class="animate-pulse">Giriş yapılıyor...</span>';

    try {
      const res = await fetch('/api/storefront/v2/auth/signin', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      const result = await res.json();

      if (result.accessToken || result.data?.accessToken) {
        handleSuccessfulLogin(result);
        return;
      }

      if (result.requires2FA || result.data?.requires2FA) {
        const payload = result.data || result;
        currentAuthTokens.tempToken = payload.tempToken;
        currentAuthTokens.twoFaMethods = payload.twoFactorMethods || payload.methods || ['authenticator'];
        currentAuthTokens.currentTwoFaMethod = payload.primaryMethod || payload.twoFactorMethods?.[0] || payload.methods?.[0] || 'authenticator';
        currentAuthTokens.maskedEmail = payload.maskedEmail || '';
        currentAuthTokens.discordUsername = payload.discordUsername || '';
        renderTwoFaMethodPicker();
        switchAuthStep('twofa-container');
        document.getElementById('twofaCodeInput')?.focus();
        showAlert('2FA Doğrulaması', payload.message || 'İki aşamalı doğrulama kodunuzu giriniz.', 'info');

        if (currentAuthTokens.currentTwoFaMethod === 'discord') {
          sendTwoFaDiscordCode();
        }
        return;
      }

      if ((result.requiresEmailVerification || result.data?.requiresEmailVerification) && !result.isTempEmail && !result.data?.isTempEmail) {
        const payload = result.data || result;
        currentAuthTokens.emailToken = payload.emailToken;
        currentAuthTokens.maskedEmail = payload.maskedEmail || '';
        const otpEmailEl = document.getElementById('otpMaskedEmail');
        if (otpEmailEl) otpEmailEl.innerText = payload.maskedEmail || 'e-posta adresinize';
        switchAuthStep('email-otp-container');
        document.getElementById('otpCodeInput')?.focus();
        showAlert('E-Posta Doğrulama', payload.message || 'Lütfen e-posta doğrulama kodunuzu giriniz.', 'info');
        return;
      }

      if ((result.requiresEmailVerification || result.data?.requiresEmailVerification) && (result.isTempEmail || result.data?.isTempEmail)) {
        const payload = result.data || result;
        currentAuthTokens.tempToken = payload.tempToken;
        switchAuthStep('temp-email-container');
        document.getElementById('tempEmailInput')?.focus();
        showAlert('E-Posta Güncelleme', payload.message || 'Lütfen geçerli bir e-posta adresi giriniz.', 'info');
        return;
      }

      showAlert('Giriş Başarısız', result.message || 'Kullanıcı adı veya şifre hatalı!', 'error');
    } catch (err) {
      showAlert('Bağlantı Hatası', 'Sunucuya bağlanılamadı!', 'error');
    } finally {
      btn.disabled = false;
      btn.innerHTML = originalText;
    }
  });

  // Handle Register
  document.getElementById('registerForm')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(e.target);
    const data = Object.fromEntries(formData.entries());

    if (data['cf-turnstile-response']) {
      data.turnstileToken = data['cf-turnstile-response'];
      delete data['cf-turnstile-response'];
    }

    if (data.password !== data.confirm_password) {
      showAlert('Şifre Uyuşmazlığı', 'Girdiğiniz şifreler birbiriyle eşleşmiyor!', 'error');
      return;
    }

    const btn = document.getElementById('registerSubmitBtn') || e.target.querySelector('button[type="submit"]');
    const originalText = btn.innerHTML;

    btn.disabled = true;
    btn.innerHTML = '<span class="animate-pulse">Hesap oluşturuluyor...</span>';

    try {
      const res = await fetch('/api/storefront/v2/auth/signup', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      const result = await res.json();

      if (result.success || res.ok) {
        showAlert('Kayıt Başarılı', 'Hesabınız oluşturuldu! Şimdi giriş yapabilirsiniz.', 'success');
        toggleAuth('login');
        const loginUserInput = document.querySelector('#loginForm input[name="username"]');
        if (loginUserInput) loginUserInput.value = data.username;
      } else {
        showAlert('Kayıt Başarısız', result.message || 'Kayıt işlemi başarısız!', 'error');
      }
    } catch (err) {
      showAlert('Bağlantı Hatası', 'Sunucuya bağlanılamadı!', 'error');
    } finally {
      btn.disabled = false;
      btn.innerHTML = originalText;
    }
  });

  // Email OTP
  document.getElementById('emailOtpForm')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const code = document.getElementById('otpCodeInput').value.trim();
    if (!code || !currentAuthTokens.emailToken) return;

    const btn = document.getElementById('otpSubmitBtn');
    const originalText = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<span class="animate-pulse">Doğrulanıyor...</span>';

    try {
      const res = await fetch('/api/storefront/v2/auth/verify-email', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ emailToken: currentAuthTokens.emailToken, code: code }),
      });
      const result = await res.json();
      if (result.accessToken || (result.success && result.accessToken) || result.data?.accessToken) {
        handleSuccessfulLogin(result.data || result);
      } else {
        showAlert('Doğrulama Hatası', result.message || result.data?.message || 'Geçersiz doğrulama kodu!', 'error');
      }
    } catch (err) {
      showAlert('Bağlantı Hatası', 'Doğrulama sırasında hata oluştu!', 'error');
    } finally {
      btn.disabled = false;
      btn.innerHTML = originalText;
    }
  });

  async function resendEmailOtp() {
    if (!currentAuthTokens.emailToken) return;
    const btn = document.getElementById('resendOtpBtn');
    btn.disabled = true;

    try {
      const res = await fetch('/api/storefront/v2/auth/resend-email', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ emailToken: currentAuthTokens.emailToken }),
      });
      const data = await res.json();
      if (data.success) {
        showAlert('Kod Gönderildi', 'Doğrulama kodu tekrar gönderildi.', 'success');
      } else {
        showAlert('Kod Gönderilemedi', data.message || 'Kod gönderilemedi.', 'error');
      }
    } catch (e) {
      showAlert('Bağlantı Hatası', 'Kod gönderilemedi!', 'error');
    } finally {
      btn.disabled = false;
    }
  }

  // Temp Email
  document.getElementById('tempEmailForm')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = document.getElementById('tempEmailInput').value.trim();
    if (!email || !currentAuthTokens.tempToken) return;

    const btn = document.getElementById('tempEmailSubmitBtn');
    const originalText = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<span class="animate-pulse">Güncelleniyor...</span>';

    try {
      const res = await fetch('/api/storefront/v2/auth/update-temp-email', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ tempToken: currentAuthTokens.tempToken, email: email }),
      });
      const result = await res.json();
      const payload = result.data || result;
      if (result.success || payload.emailToken) {
        currentAuthTokens.emailToken = payload.emailToken;
        currentAuthTokens.maskedEmail = email;
        const otpEmailEl = document.getElementById('otpMaskedEmail');
        if (otpEmailEl) otpEmailEl.innerText = email;
        switchAuthStep('email-otp-container');
        showAlert('E-Posta Güncellendi', result.message || 'Doğrulama kodu e-postanıza gönderildi.', 'success');
      } else {
        showAlert('Güncelleme Başarısız', result.message || 'E-posta güncellenemedi.', 'error');
      }
    } catch (err) {
      showAlert('Bağlantı Hatası', 'E-posta güncellenemedi!', 'error');
    } finally {
      btn.disabled = false;
      btn.innerHTML = originalText;
    }
  });

  // 2FA Picker
  function renderTwoFaMethodPicker() {
    const container = document.getElementById('twofaMethodsContainer');
    const emailSendBtn = document.getElementById('twofaEmailSendBtn');
    const inputLabel = document.getElementById('twofaInputLabel');
    if (!container) return;

    container.innerHTML = '';
    const methods = currentAuthTokens.twoFaMethods;

    methods.forEach((method) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      const isActive = currentAuthTokens.currentTwoFaMethod === method;
      btn.className = `px-3 py-1.5 rounded-xl text-xs font-bold transition-all border ${
        isActive
          ? 'bg-purple-600/30 text-purple-300 border-purple-500 shadow-md'
          : 'bg-gray-900 text-gray-400 border-purple-900/40 hover:text-white'
      }`;

      let label = 'Authenticator';
      if (method === 'email') label = 'E-Posta';
      else if (method === 'discord') label = 'Discord';
      else if (method === 'recovery_code') label = 'Kurtarma Kodu';

      btn.innerText = label;
      btn.onclick = () => {
        currentAuthTokens.currentTwoFaMethod = method;
        renderTwoFaMethodPicker();
      };
      container.appendChild(btn);
    });

    if (currentAuthTokens.currentTwoFaMethod === 'discord') {
      if (emailSendBtn) {
        emailSendBtn.classList.remove('hidden');
        emailSendBtn.innerText = 'Kodu Discord DM\'den Tekrar Gönder';
        emailSendBtn.onclick = sendTwoFaDiscordCode;
      }
      if (inputLabel) inputLabel.innerText = '6 Haneli Discord Güvenlik Kodu';
      const desc = document.getElementById('twofaDescription');
      if (desc) desc.innerHTML = `Discord hesabınıza (${currentAuthTokens.discordUsername ? '<strong>@' + currentAuthTokens.discordUsername + '</strong>' : 'Discord'}) 6 haneli bir giriş kodu gönderdik. DM kutunuzu kontrol edin.`;
    } else if (currentAuthTokens.currentTwoFaMethod === 'email') {
      if (emailSendBtn) {
        emailSendBtn.classList.remove('hidden');
        emailSendBtn.innerText = 'Kodu E-Postama Gönder';
        emailSendBtn.onclick = sendTwoFaEmailCode;
      }
      if (inputLabel) inputLabel.innerText = '6 Haneli E-Posta Kodu';
    } else if (currentAuthTokens.currentTwoFaMethod === 'recovery_code') {
      if (emailSendBtn) emailSendBtn.classList.add('hidden');
      if (inputLabel) inputLabel.innerText = '8 Haneli Kurtarma Kodu';
    } else {
      if (emailSendBtn) emailSendBtn.classList.add('hidden');
      if (inputLabel) inputLabel.innerText = '6 Haneli Authenticator Kodu';
    }
  }

  async function sendTwoFaDiscordCode() {
    if (!currentAuthTokens.tempToken) return;
    const btn = document.getElementById('twofaEmailSendBtn');
    if (btn) {
      btn.disabled = true;
      btn.innerText = 'Kod gönderiliyor...';
    }
    try {
      const res = await fetch('/api/storefront/v2/auth/2fa/send-discord-code', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ tempToken: currentAuthTokens.tempToken }),
      });
      const data = await res.json();
      if (data.success) showAlert('Kod Gönderildi', data.message || 'Güvenlik kodu Discord DM kutunuza gönderildi.', 'success');
      else showAlert('Kod Gönderilemedi', data.message || 'Kod gönderilemedi.', 'error');
    } catch (e) {
      showAlert('Bağlantı Hatası', 'Bağlantı hatası!', 'error');
    } finally {
      if (btn) {
        btn.disabled = false;
        btn.innerText = 'Kodu Discord DM\'den Tekrar Gönder';
      }
    }
  }

  async function sendTwoFaEmailCode() {
    if (!currentAuthTokens.tempToken) return;
    const btn = document.getElementById('twofaEmailSendBtn');
    if (btn) {
      btn.disabled = true;
      btn.innerText = 'Kod gönderiliyor...';
    }

    try {
      const res = await fetch('/api/storefront/v2/auth/2fa/send-email-code', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ tempToken: currentAuthTokens.tempToken }),
      });
      const data = await res.json();
      if (data.success) showAlert('Kod Gönderildi', '2FA kodu e-postanıza gönderildi.', 'success');
      else showAlert('Kod Gönderilemedi', data.message || 'Kod gönderilemedi.', 'error');
    } catch (e) {
      showAlert('Bağlantı Hatası', 'Bağlantı hatası!', 'error');
    } finally {
      if (btn) {
        btn.disabled = false;
        btn.innerText = 'Kodu E-Postama Gönder';
      }
    }
  }

  document.getElementById('twofaForm')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const code = document.getElementById('twofaCodeInput').value.trim();
    if (!code || !currentAuthTokens.tempToken) return;

    const btn = document.getElementById('twofaSubmitBtn');
    const originalText = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<span class="animate-pulse">Doğrulanıyor...</span>';

    try {
      const res = await fetch('/api/storefront/v2/auth/2fa/verify', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          tempToken: currentAuthTokens.tempToken,
          method: currentAuthTokens.currentTwoFaMethod,
          code: code,
        }),
      });
      const result = await res.json();
      if (result.accessToken || (result.success && result.accessToken) || result.data?.accessToken) {
        handleSuccessfulLogin(result.data || result);
      } else {
        showAlert('Doğrulama Hatası', result.message || result.data?.message || 'Doğrulama kodu hatalı!', 'error');
      }
    } catch (err) {
      showAlert('Doğrulama Hatası', '2FA doğrulama hatası!', 'error');
    } finally {
      btn.disabled = false;
      btn.innerHTML = originalText;
    }
  });
</script>
