<!-- ============================================================
     FORUM KONU DETAYI (Purpy Remastered Dark Luxury)
     ============================================================ -->
<div class="w-full max-w-[1350px] mx-auto px-4 sm:px-6 py-6 sm:py-10 space-y-8 min-h-[60vh]">
  <!-- Breadcrumb -->
  <div
    class="flex flex-wrap items-center gap-2 text-xs sm:text-sm font-semibold px-4 py-2.5 rounded-2xl border backdrop-blur-md w-fit shadow-lg"
    style="
      background: linear-gradient(135deg, rgba(26, 16, 32, 0.85), rgba(18, 10, 24, 0.85));
      border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.25);
    "
  >
    <a href="/" class="hover:text-primary transition-colors flex items-center gap-1.5" style="color: #cbd5e1;">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
      </svg>
    </a>
    <span class="text-gray-500">/</span>
    <a href="/forum" class="hover:text-primary transition-colors" style="color: #cbd5e1;">Forum</a>
    {% if forumTopic.categoryId %}
      <span class="text-gray-500">/</span>
      <a href="/forum/{{ forumTopic.categoryId }}" class="hover:text-primary transition-colors" style="color: #cbd5e1;">Kategori</a>
    {% endif %}
    <span class="text-gray-500">/</span>
    <span class="font-bold line-clamp-1 max-w-[200px]" style="color: var(--color-primary);">{{ forumTopic.title }}</span>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- SOL / ORTA: Mesajlar Listesi (8 Cols) -->
    <main class="lg:col-span-8 space-y-6">
      <!-- Konu Başlık Kartı -->
      <div
        class="rounded-3xl border-2 shadow-2xl p-6 sm:p-8 backdrop-blur-xl"
        style="
          background: linear-gradient(135deg, rgba(26, 16, 32, 0.95), rgba(18, 10, 24, 0.95));
          border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.25);
        "
      >
        <div class="flex flex-wrap items-center gap-3 mb-4">
          {% if forumTopic.isPinned %}
            <span class="px-3 py-1 bg-amber-500/20 text-amber-300 text-xs font-black uppercase tracking-wider rounded-xl border border-amber-500/40 flex items-center gap-1.5 shadow">
              <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20"><path d="M9.828 3h3.982a2 2 0 011.992 2.181l-.637 7A2 2 0 0113.174 14H11.5v3.5a.5.5 0 01-1 0V14H8.826a2 2 0 01-1.991-1.819l-.637-7a2 2 0 011.992-2.181h1.638z"/></svg>
              Sabit
            </span>
          {% endif %}
          {% if forumTopic.isLocked %}
            <span class="px-3 py-1 bg-rose-500/20 text-rose-300 text-xs font-black uppercase tracking-wider rounded-xl border border-rose-500/40 flex items-center gap-1.5 shadow">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
              Kilitli
            </span>
          {% endif %}
          <div class="flex items-center gap-2 text-xs font-semibold text-gray-400">
            <svg class="w-4 h-4 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <span>{{ forumTopic.createdAt | date: "%d.%m.%Y %H:%M" }}</span>
          </div>
        </div>
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-black text-white leading-tight" style="color: #ffffff !important;">{{ forumTopic.title }}</h1>
      </div>

      <!-- OP (İlk Mesaj / Konu Sahibi) -->
      <div
        class="rounded-3xl border-2 shadow-2xl overflow-hidden flex flex-col md:flex-row backdrop-blur-xl"
        style="
          background: linear-gradient(135deg, rgba(26, 16, 32, 0.95), rgba(18, 10, 24, 0.95));
          border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.25);
        "
      >
        <!-- Yazar Kolonu -->
        <div
          class="w-full md:w-56 p-6 flex flex-col items-center text-center flex-shrink-0 border-b md:border-b-0 md:border-r"
          style="background: rgba(14, 9, 20, 0.7); border-color: rgba(255, 255, 255, 0.08);"
        >
          <div class="relative w-20 h-20 mb-3">
            <div class="absolute inset-0 rounded-2xl blur-lg opacity-40" style="background-color: var(--color-primary);"></div>
            <img src="https://mc-heads.net/avatar/{{ forumTopic.authorName }}/100" class="relative w-full h-full object-cover rounded-2xl border-2 border-primary/50 shadow-lg" alt="{{ forumTopic.authorName }}">
          </div>
          <div class="font-black text-white text-base mb-1" style="color: #ffffff !important;">{{ forumTopic.authorName }}</div>
          <div class="px-3 py-0.5 rounded-lg text-[10px] font-black uppercase tracking-wider mb-2 border border-primary/40 text-purple-300"
               style="background: rgba(var(--color-primary-rgb, 124, 58, 237), 0.2);">
            Konu Sahibi
          </div>
        </div>
        
        <!-- İçerik Kolonu -->
        <div class="flex-1 flex flex-col min-w-0 p-6 md:p-8">
          <div class="prose prose-invert prose-sm md:prose-base max-w-none text-gray-200 break-words lexical-content flex-1 leading-relaxed">
            {{ forumTopic.content | lexical_html }}
          </div>
          
          <div class="mt-8 pt-5 border-t flex flex-wrap items-center justify-between gap-4" style="border-color: rgba(255, 255, 255, 0.08);">
            <span class="text-xs font-bold text-gray-400">#1 (Başlangıç)</span>
            <button class="flex items-center gap-2 text-xs font-bold text-rose-300 hover:text-white transition-all px-4 py-2 rounded-xl border border-rose-500/30 hover:border-rose-500/60 bg-rose-500/10 cursor-pointer shadow">
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
              <span>Beğen ({{ forumTopic.likeCount | default: 0 }})</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Yanıtlar -->
      {% if forumTopic.messages and forumTopic.messages.size > 0 %}
        <div class="space-y-6 mt-8">
          {% for message in forumTopic.messages %}
            <div
              class="rounded-3xl border-2 shadow-2xl overflow-hidden flex flex-col md:flex-row backdrop-blur-xl"
              style="
                background: linear-gradient(135deg, rgba(26, 16, 32, 0.95), rgba(18, 10, 24, 0.95));
                border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.20);
              "
            >
              <!-- Yazar Kolonu -->
              <div
                class="w-full md:w-56 p-6 flex flex-col items-center text-center flex-shrink-0 border-b md:border-b-0 md:border-r"
                style="background: rgba(14, 9, 20, 0.7); border-color: rgba(255, 255, 255, 0.08);"
              >
                <img src="https://mc-heads.net/avatar/{{ message.authorName }}/80" class="w-16 h-16 object-cover rounded-2xl border-2 border-primary/30 shadow-md mb-2" alt="{{ message.authorName }}">
                <div class="font-black text-white text-sm mb-1" style="color: #ffffff !important;">{{ message.authorName }}</div>
                <div class="text-[10px] font-semibold text-gray-400 mb-2">Üye</div>
                <div class="text-[10px] font-semibold text-gray-500 w-full pt-2 border-t" style="border-color: rgba(255, 255, 255, 0.06);">
                  {{ message.createdAt | date: "%d.%m.%Y %H:%M" }}
                </div>
              </div>
              
              <!-- İçerik Kolonu -->
              <div class="flex-1 flex flex-col min-w-0 p-6 md:p-8">
                <div class="prose prose-invert prose-sm max-w-none text-gray-200 break-words lexical-content flex-1 leading-relaxed">
                  {{ message.content | lexical_html }}
                </div>
                
                <div class="mt-6 pt-4 border-t flex flex-wrap items-center justify-between gap-4" style="border-color: rgba(255, 255, 255, 0.08);">
                  <span class="text-xs font-bold text-gray-400">#{{ forloop.index | plus: 1 }}</span>
                  <button class="flex items-center gap-1.5 text-xs font-bold text-gray-400 hover:text-rose-400 transition-colors">
                    <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
                    <span>{{ message.likeCount | default: 0 }}</span>
                  </button>
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      {% endif %}

      <!-- Cevap Yazma Formu -->
      {% if forumTopic.isLocked %}
        <div
          class="rounded-3xl border-2 p-8 text-center mt-8 backdrop-blur-xl shadow-2xl"
          style="background: rgba(239, 68, 68, 0.12); border-color: rgba(239, 68, 68, 0.35);"
        >
          <div class="w-14 h-14 bg-rose-500/20 text-rose-400 border border-rose-500/40 rounded-2xl flex items-center justify-center mx-auto mb-3">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
            </svg>
          </div>
          <h3 class="text-xl font-black text-white mb-1" style="color: #ffffff !important;">Bu Konu Kilitlenmiş</h3>
          <p class="text-xs text-rose-200 font-medium">Bu konuya yeni yanıt gönderilemez. İlgili tartışma sonlandırılmıştır.</p>
        </div>
      {% elsif customer %}
        <div
          class="rounded-3xl border-2 shadow-2xl p-6 md:p-8 mt-8 backdrop-blur-xl"
          style="
            background: linear-gradient(135deg, rgba(26, 16, 32, 0.95), rgba(18, 10, 24, 0.95));
            border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.30);
          "
        >
          <h3 class="text-lg sm:text-xl font-black text-white mb-6 flex items-center gap-3 pb-3 border-b" style="color: #ffffff !important; border-color: rgba(255, 255, 255, 0.08);">
            <div class="w-8 h-8 rounded-xl flex items-center justify-center bg-primary/20 text-primary border border-primary/40">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"/>
              </svg>
            </div>
            <span>Cevap Yaz</span>
          </h3>
          <form id="replyForm" class="space-y-6">
            <div
              class="rounded-2xl border-2 overflow-hidden flex flex-col shadow-inner"
              style="background: rgba(14, 9, 20, 0.85); border-color: rgba(255, 255, 255, 0.1);"
            >
              <!-- Toolbar -->
              <div class="flex flex-wrap items-center gap-1 p-2.5 border-b" style="background: rgba(20, 12, 28, 0.8); border-color: rgba(255, 255, 255, 0.08);">
                <button type="button" id="bold-btn" class="p-2 text-gray-400 hover:text-white hover:bg-white/10 rounded-lg transition-colors cursor-pointer" title="Kalın">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 4h8a4 4 0 014 4 4 4 0 01-4 4H6z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 12h9a4 4 0 014 4 4 4 0 01-4 4H6z"/></svg>
                </button>
                <button type="button" id="italic-btn" class="p-2 text-gray-400 hover:text-white hover:bg-white/10 rounded-lg transition-colors cursor-pointer" title="İtalik">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 20l4-16m4 4l-4 16M6 16l4-16"/></svg>
                </button>
                <button type="button" id="underline-btn" class="p-2 text-gray-400 hover:text-white hover:bg-white/10 rounded-lg transition-colors cursor-pointer" title="Altı Çizili">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 3v7a6 6 0 006 6 6 6 0 006-6V3m-6 18h6"/></svg>
                </button>
                <button type="button" id="strike-btn" class="p-2 text-gray-400 hover:text-white hover:bg-white/10 rounded-lg transition-colors cursor-pointer" title="Üstü Çizili">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 12h14M8 6h8a2 2 0 010 4H8a2 2 0 010-4zM8 14h8a2 2 0 000 4H8a2 2 0 000-4z"/></svg>
                </button>
                <div class="w-px h-5 mx-1" style="background: rgba(255, 255, 255, 0.1);"></div>
                <button type="button" id="left-btn" class="p-2 text-gray-400 hover:text-white hover:bg-white/10 rounded-lg transition-colors cursor-pointer" title="Sola Hizala">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h10M4 18h16"/></svg>
                </button>
                <button type="button" id="center-btn" class="p-2 text-gray-400 hover:text-white hover:bg-white/10 rounded-lg transition-colors cursor-pointer" title="Ortala">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M7 12h10M4 18h16"/></svg>
                </button>
                <button type="button" id="right-btn" class="p-2 text-gray-400 hover:text-white hover:bg-white/10 rounded-lg transition-colors cursor-pointer" title="Sağa Hizala">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M10 12h10M4 18h16"/></svg>
                </button>
              </div>
              <div
                id="lexical-editor"
                class="min-h-[160px] p-5 outline-none text-sm text-white font-sans cursor-text"
                contenteditable="true"
              ></div>
            </div>
            <div class="flex justify-end">
              <button
                type="submit"
                class="px-8 py-3.5 rounded-2xl font-black text-xs uppercase tracking-wider text-white shadow-2xl transition-all duration-300 hover:scale-105 border border-white/20 cursor-pointer flex items-center justify-center gap-2"
                style="
                  background: linear-gradient(135deg, var(--color-primary), #9333ea);
                  box-shadow: 0 10px 25px rgba(var(--color-primary-rgb, 124, 58, 237), 0.4);
                "
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
                </svg>
                <span>Gönder</span>
              </button>
            </div>
          </form>
        </div>
      {% else %}
        <div
          class="rounded-3xl border-2 shadow-2xl p-8 mt-8 text-center flex flex-col items-center backdrop-blur-xl"
          style="
            background: linear-gradient(135deg, rgba(26, 16, 32, 0.95), rgba(18, 10, 24, 0.95));
            border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.25);
          "
        >
          <div class="w-16 h-16 rounded-2xl flex items-center justify-center mb-3 shadow-lg border"
               style="background: rgba(var(--color-primary-rgb, 124, 58, 237), 0.2); border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.4); color: var(--color-primary);">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"/>
            </svg>
          </div>
          <h3 class="text-xl font-black text-white mb-2" style="color: #ffffff !important;">Sohbete Katıl!</h3>
          <p class="text-xs text-gray-300 font-medium mb-6 max-w-md">Kendi fikirlerini belirtmek ve diğer oyuncularla etkileşime geçmek için hemen giriş yap.</p>
          <a href="/auth/sign-in?return={{ request.url | url_encode }}"
             class="px-8 py-3.5 rounded-2xl font-black text-xs uppercase tracking-wider text-white shadow-2xl transition-all duration-300 hover:scale-105 border border-white/20"
             style="background: linear-gradient(135deg, var(--color-primary), #9333ea);">
            Hemen Giriş Yap
          </a>
        </div>
      {% endif %}
    </main>

    <!-- SAĞ: Konu İstatistikleri (4 Cols) -->
    <aside class="lg:col-span-4 space-y-6">
      <div
        class="rounded-3xl border-2 shadow-2xl p-6 sticky top-24 backdrop-blur-xl"
        style="
          background: linear-gradient(135deg, rgba(28, 16, 38, 0.95), rgba(18, 10, 24, 0.95));
          border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.30);
        "
      >
        <h3 class="font-black text-white mb-6 pb-3 border-b text-sm flex items-center gap-2" style="color: #ffffff !important; border-color: rgba(255, 255, 255, 0.08);">
          <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
          </svg>
          <span>Konu İstatistikleri</span>
        </h3>
        
        <div class="space-y-3.5">
          <div class="flex items-center justify-between p-3.5 rounded-2xl border" style="background: rgba(14, 9, 20, 0.6); border-color: rgba(255, 255, 255, 0.08);">
            <div class="text-xs font-bold text-gray-300 flex items-center gap-2">
              <svg class="w-4 h-4 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
              <span>Okunma</span>
            </div>
            <div class="font-black text-white text-base" style="color: #ffffff !important;">{{ forumTopic.viewCount | default: 0 }}</div>
          </div>
          <div class="flex items-center justify-between p-3.5 rounded-2xl border" style="background: rgba(14, 9, 20, 0.6); border-color: rgba(255, 255, 255, 0.08);">
            <div class="text-xs font-bold text-gray-300 flex items-center gap-2">
              <svg class="w-4 h-4 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
              <span>Yanıt</span>
            </div>
            <div class="font-black text-white text-base" style="color: #ffffff !important;">{{ forumTopic.replyCount | default: 0 }}</div>
          </div>
          <div class="flex items-center justify-between p-3.5 rounded-2xl border" style="background: rgba(14, 9, 20, 0.6); border-color: rgba(255, 255, 255, 0.08);">
            <div class="text-xs font-bold text-gray-300 flex items-center gap-2">
              <svg class="w-4 h-4 text-rose-400" fill="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
              <span>Beğeni</span>
            </div>
            <div class="font-black text-white text-base" style="color: #ffffff !important;">{{ forumTopic.likeCount | default: 0 }}</div>
          </div>
        </div>
      </div>
    </aside>
  </div>
</div>

<style>
  .editor-text-bold { font-weight: bold; }
  .editor-text-italic { font-style: italic; }
  .editor-text-underline { text-decoration: underline; }
  .editor-text-strikethrough { text-decoration: line-through; }
  .editor-text-underlineStrikethrough { text-decoration: underline line-through; }
  
  .lexical-content p {
    margin-bottom: 1rem;
    line-height: 1.7;
  }
  .lexical-content p:last-child {
    margin-bottom: 0;
  }
</style>

<script type="module">
  import { createEditor, FORMAT_TEXT_COMMAND, FORMAT_ELEMENT_COMMAND } from 'https://esm.sh/lexical@0.14.5';
  import { registerRichText } from 'https://esm.sh/@lexical/rich-text@0.14.5';

  window.lexicalContentJSON = null;

  const myTheme = {
    text: {
      bold: 'editor-text-bold',
      italic: 'editor-text-italic',
      underline: 'editor-text-underline',
      strikethrough: 'editor-text-strikethrough',
      underlineStrikethrough: 'editor-text-underlineStrikethrough',
    },
  };

  const config = {
    namespace: 'ForumReply',
    theme: myTheme,
    onError: (error) => {
      console.error('Lexical Hatası:', error);
    },
  };

  const editor = createEditor(config);
  const editorElement = document.getElementById('lexical-editor');

  if (editorElement) {
    editor.setRootElement(editorElement);
    registerRichText(editor);

    document.getElementById('bold-btn')?.addEventListener('mousedown', (e) => {
      e.preventDefault();
      editor.dispatchCommand(FORMAT_TEXT_COMMAND, 'bold');
    });
    document.getElementById('italic-btn')?.addEventListener('mousedown', (e) => {
      e.preventDefault();
      editor.dispatchCommand(FORMAT_TEXT_COMMAND, 'italic');
    });
    document.getElementById('underline-btn')?.addEventListener('mousedown', (e) => {
      e.preventDefault();
      editor.dispatchCommand(FORMAT_TEXT_COMMAND, 'underline');
    });
    document.getElementById('strike-btn')?.addEventListener('mousedown', (e) => {
      e.preventDefault();
      editor.dispatchCommand(FORMAT_TEXT_COMMAND, 'strikethrough');
    });

    document.getElementById('left-btn')?.addEventListener('mousedown', (e) => {
      e.preventDefault();
      editor.dispatchCommand(FORMAT_ELEMENT_COMMAND, 'left');
    });
    document.getElementById('center-btn')?.addEventListener('mousedown', (e) => {
      e.preventDefault();
      editor.dispatchCommand(FORMAT_ELEMENT_COMMAND, 'center');
    });
    document.getElementById('right-btn')?.addEventListener('mousedown', (e) => {
      e.preventDefault();
      editor.dispatchCommand(FORMAT_ELEMENT_COMMAND, 'right');
    });

    editor.registerUpdateListener(({ editorState }) => {
      editorState.read(() => {
        window.lexicalContentJSON = editorState.toJSON();
      });
    });

    document.getElementById('replyForm')?.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (!window.lexicalContentJSON || !window.lexicalContentJSON.root.children.length) {
        window.showToast?.('Lütfen bir mesaj girin.', 'error');
        return;
      }

      const btn = e.target.querySelector('button[type="submit"]');
      const originalText = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = '<div class="w-4 h-4 border-2 border-white/20 border-t-white rounded-full animate-spin mr-2"></div> <span>Gönderiliyor...</span>';

      const topicId = '{{ forumTopic.id }}';

      try {
        const res = await fetch(`/api/storefront/v1/forum/topic/${topicId}/message`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ content: window.lexicalContentJSON }),
        });
        const result = await res.json();

        if (result.success || res.ok) {
          window.showToast?.('Cevabınız gönderildi!', 'success');
          window.location.reload();
        } else {
          window.showToast?.(result.message || 'Bir hata oluştu.', 'error');
          btn.disabled = false;
          btn.innerHTML = originalText;
        }
      } catch (err) {
        window.showToast?.('Bağlantı hatası.', 'error');
        btn.disabled = false;
        btn.innerHTML = originalText;
      }
    });
  }
</script>
