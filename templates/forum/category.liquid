<!-- ============================================================
     FORUM KATEGORİSİ (Purpy Remastered Dark Luxury)
     ============================================================ -->
<div class="w-full max-w-[1350px] mx-auto px-4 sm:px-6 py-6 sm:py-10 space-y-8 min-h-[60vh]">
  <!-- Breadcrumb -->
  <div
    class="flex flex-wrap items-center gap-2 text-xs sm:text-sm font-semibold px-4 py-2.5 rounded-2xl border backdrop-blur-md w-fit shadow-lg"
    style="
      background: linear-gradient(135deg, rgba(26, 16, 32, 0.85), rgba(18, 10, 24, 0.85));
      border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.25);
    "
  >
    <a href="/" class="hover:text-primary transition-colors flex items-center gap-1.5" style="color: #cbd5e1;">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
      </svg>
    </a>
    <span class="text-gray-500">/</span>
    <a href="/forum" class="hover:text-primary transition-colors" style="color: #cbd5e1;">Forum</a>
    <span class="text-gray-500">/</span>
    <span class="font-bold" style="color: var(--color-primary);">{{ forumCategory.name | default: 'Kategori' }}</span>
  </div>

  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6 pb-2 border-b" style="border-color: rgba(255, 255, 255, 0.08);">
    <div class="flex items-center gap-4">
      <div class="w-16 h-16 rounded-3xl flex items-center justify-center flex-shrink-0 border-2 shadow-2xl"
           style="background: rgba(var(--color-primary-rgb, 124, 58, 237), 0.2); border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.4); color: var(--color-primary);">
        {% if forumCategory.icon %}
          <i class="{{ forumCategory.icon }} text-2xl"></i>
        {% else %}
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/>
          </svg>
        {% endif %}
      </div>
      <div>
        <h1 class="text-2xl sm:text-3xl font-black text-white uppercase tracking-wide" style="color: #ffffff !important;">{{ forumCategory.name }}</h1>
        <p class="text-xs sm:text-sm font-medium text-gray-300">{{ forumCategory.description }}</p>
      </div>
    </div>

    {% if customer %}
      <a href="/forum/new?category={{ forumCategory.slug | default: forumCategory.id }}"
         class="inline-flex items-center gap-2 px-6 py-3.5 rounded-2xl font-black text-xs uppercase tracking-wider text-white shadow-2xl transition-all duration-300 hover:scale-105 border border-white/20"
         style="background: linear-gradient(135deg, var(--color-primary), #9333ea);">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/>
        </svg>
        <span>Yeni Konu</span>
      </a>
    {% endif %}
  </div>

  <!-- Main Layout -->
  <div class="space-y-6">
    <h2 class="text-lg sm:text-xl font-black text-white flex items-center gap-2.5" style="color: #ffffff !important;">
      <div class="w-8 h-8 rounded-xl flex items-center justify-center bg-primary/20 text-primary border border-primary/40">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
        </svg>
      </div>
      <span>Tüm Konular</span>
    </h2>

    {% if forumTopics and forumTopics.size > 0 %}
      <div class="space-y-3">
        {% for topic in forumTopics %}
          <a
            href="/forum/{{ forumCategory.slug | default: forumCategory.id }}/{{ topic.slug | default: topic.id }}"
            class="block rounded-3xl border-2 p-5 transition-all duration-300 group hover:border-primary/60 hover:scale-[1.01] backdrop-blur-xl shadow-xl cursor-pointer"
            style="
              background: linear-gradient(135deg, rgba(26, 16, 32, 0.95), rgba(18, 10, 24, 0.95));
              border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.20);
            "
          >
            <div class="flex items-start gap-4 sm:gap-5">
              <div class="flex-shrink-0">
                <img
                  src="https://mc-heads.net/avatar/{{ topic.authorName }}/48"
                  class="w-12 h-12 rounded-2xl border-2 border-primary/40 shadow-lg"
                  alt="{{ topic.authorName }}"
                >
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-1.5 flex-wrap">
                  {% if topic.isPinned %}
                    <span class="px-2 py-0.5 text-amber-300 text-[10px] font-black uppercase tracking-wider rounded-lg border border-amber-500/30" style="background: rgba(245, 158, 11, 0.15);">Sabit</span>
                  {% endif %}
                  {% if topic.isLocked %}
                    <span class="px-2 py-0.5 text-rose-300 text-[10px] font-black uppercase tracking-wider rounded-lg border border-rose-500/30" style="background: rgba(239, 68, 68, 0.15);">Kilitli</span>
                  {% endif %}
                  <h3 class="font-black text-white group-hover:text-primary transition-colors truncate text-base sm:text-lg" style="color: #ffffff !important;">{{ topic.title }}</h3>
                </div>
                <div class="flex flex-wrap items-center gap-3 text-xs font-semibold text-gray-400">
                  <span class="text-purple-300 font-bold">{{ topic.authorName }}</span>
                  <span>•</span>
                  <span>{{ topic.createdAt | date: "%d.%m.%Y %H:%M" }}</span>
                  <span>•</span>
                  <span class="flex items-center gap-1">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                    {{ topic.viewCount | default: 0 }}
                  </span>
                  <span class="flex items-center gap-1">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
                    {{ topic.replyCount | default: 0 }}
                  </span>
                  <span class="flex items-center gap-1 text-rose-400">
                    <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
                    {{ topic.likeCount | default: 0 }}
                  </span>
                </div>
              </div>
              
              <div class="hidden sm:flex items-center justify-center w-10 h-10 rounded-2xl border text-gray-400 group-hover:text-white group-hover:border-primary/50 group-hover:bg-primary/20 transition-all flex-shrink-0"
                   style="background: rgba(14, 9, 20, 0.6); border-color: rgba(255, 255, 255, 0.08);">
                <svg class="w-5 h-5 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
                </svg>
              </div>
            </div>
          </a>
        {% endfor %}
      </div>
    {% else %}
      <div class="py-16 text-center rounded-3xl border-2 border-dashed flex flex-col items-center justify-center gap-3"
           style="background: rgba(14, 9, 20, 0.4); border-color: rgba(255, 255, 255, 0.08);">
        <p class="text-xs sm:text-sm text-gray-400 font-bold">Bu kategoride henüz bir konu açılmamış.</p>
        {% if customer %}
          <a href="/forum/new?category={{ forumCategory.slug | default: forumCategory.id }}"
             class="mt-2 inline-flex items-center gap-2 px-6 py-2.5 rounded-xl font-bold text-xs uppercase tracking-wider text-white shadow"
             style="background: var(--color-primary);">
            İlk Konuyu Sen Aç
          </a>
        {% endif %}
      </div>
    {% endif %}
  </div>
</div>
