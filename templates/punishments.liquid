<!-- ============================================================
     CEZALAR MERKEZİ (Purpy Remastered Dark Luxury)
     ============================================================ -->
<div class="w-full max-w-[1350px] mx-auto px-4 sm:px-6 py-6 sm:py-10 space-y-8 min-h-[60vh]">
  <!-- Breadcrumb -->
  <div
    class="flex flex-wrap items-center gap-2 text-xs sm:text-sm font-semibold px-4 py-2.5 rounded-2xl border backdrop-blur-md w-fit shadow-lg"
    style="
      background: linear-gradient(135deg, rgba(26, 16, 32, 0.85), rgba(18, 10, 24, 0.85));
      border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.25);
    "
  >
    <a href="/" class="hover:text-primary transition-colors flex items-center gap-1.5" style="color: #cbd5e1;">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
      </svg>
    </a>
    <span class="text-gray-500">/</span>
    <span class="font-bold" style="color: var(--color-primary);">Cezalar</span>
  </div>

  <!-- Başlık -->
  <div class="flex items-center gap-3.5 mb-8">
    <div class="w-2 h-10 rounded-full" style="background: linear-gradient(to bottom, var(--color-primary), #9333ea);"></div>
    <div>
      <h1 class="text-2xl sm:text-3xl font-black text-white uppercase tracking-wide" style="color: #ffffff !important;">
        Ceza Kayıtları
      </h1>
      <p class="text-xs sm:text-sm font-medium text-gray-300">
        Sunucu kurallarını ihlal eden oyuncuların aldığı cezaları buradan şeffaf olarak görüntüleyebilirsiniz.
      </p>
    </div>
  </div>

  <!-- Kategori & İstatistik Kartları -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <!-- Yasaklamalar (Ban) -->
    <a
      href="/punishments/ban"
      class="group rounded-3xl border-2 p-6 shadow-2xl transition-all duration-300 hover:scale-[1.02] backdrop-blur-xl flex flex-col relative overflow-hidden cursor-pointer"
      style="
        background: linear-gradient(135deg, rgba(32, 14, 22, 0.95), rgba(18, 10, 24, 0.95));
        border-color: rgba(239, 68, 68, 0.30);
      "
    >
      <div class="flex items-start justify-between mb-6 relative z-10">
        <div class="w-14 h-14 rounded-2xl flex items-center justify-center border shadow-lg group-hover:scale-110 transition-transform"
             style="background: rgba(239, 68, 68, 0.2); border-color: rgba(239, 68, 68, 0.4); color: #f87171;">
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/>
          </svg>
        </div>
        <div class="text-right">
          <div class="text-[10px] font-black text-gray-400 uppercase tracking-wider mb-0.5">Toplam</div>
          <div id="stat-ban" class="text-3xl font-black text-rose-400">0</div>
        </div>
      </div>
      <div class="relative z-10 mt-auto">
        <h3 class="text-lg font-black text-white group-hover:text-rose-400 transition-colors mb-1" style="color: #ffffff !important;">Yasaklamalar (Ban)</h3>
        <p class="text-xs font-medium text-gray-400">Sunucudan uzaklaştırılan oyuncular</p>
      </div>
    </a>

    <!-- Susturulmalar (Mute) -->
    <a
      href="/punishments/mute"
      class="group rounded-3xl border-2 p-6 shadow-2xl transition-all duration-300 hover:scale-[1.02] backdrop-blur-xl flex flex-col relative overflow-hidden cursor-pointer"
      style="
        background: linear-gradient(135deg, rgba(28, 16, 38, 0.95), rgba(18, 10, 24, 0.95));
        border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.30);
      "
    >
      <div class="flex items-start justify-between mb-6 relative z-10">
        <div class="w-14 h-14 rounded-2xl flex items-center justify-center border shadow-lg group-hover:scale-110 transition-transform"
             style="background: rgba(var(--color-primary-rgb, 124, 58, 237), 0.2); border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.4); color: var(--color-primary);">
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2"/>
          </svg>
        </div>
        <div class="text-right">
          <div class="text-[10px] font-black text-gray-400 uppercase tracking-wider mb-0.5">Toplam</div>
          <div id="stat-mute" class="text-3xl font-black text-purple-300">0</div>
        </div>
      </div>
      <div class="relative z-10 mt-auto">
        <h3 class="text-lg font-black text-white group-hover:text-primary transition-colors mb-1" style="color: #ffffff !important;">Susturulmalar (Mute)</h3>
        <p class="text-xs font-medium text-gray-400">Sohbet erişimi kısıtlanan oyuncular</p>
      </div>
    </a>

    <!-- Uyarılar (Warning) -->
    <a
      href="/punishments/warning"
      class="group rounded-3xl border-2 p-6 shadow-2xl transition-all duration-300 hover:scale-[1.02] backdrop-blur-xl flex flex-col relative overflow-hidden cursor-pointer"
      style="
        background: linear-gradient(135deg, rgba(32, 24, 14, 0.95), rgba(18, 10, 24, 0.95));
        border-color: rgba(245, 158, 11, 0.30);
      "
    >
      <div class="flex items-start justify-between mb-6 relative z-10">
        <div class="w-14 h-14 rounded-2xl flex items-center justify-center border shadow-lg group-hover:scale-110 transition-transform"
             style="background: rgba(245, 158, 11, 0.2); border-color: rgba(245, 158, 11, 0.4); color: #fbbf24;">
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
          </svg>
        </div>
        <div class="text-right">
          <div class="text-[10px] font-black text-gray-400 uppercase tracking-wider mb-0.5">Toplam</div>
          <div id="stat-warning" class="text-3xl font-black text-amber-300">0</div>
        </div>
      </div>
      <div class="relative z-10 mt-auto">
        <h3 class="text-lg font-black text-white group-hover:text-amber-400 transition-colors mb-1" style="color: #ffffff !important;">Uyarılar (Warn)</h3>
        <p class="text-xs font-medium text-gray-400">Kuralları ihlal ettiği için uyarılan oyuncular</p>
      </div>
    </a>
  </div>

  <!-- Son Cezalar Tablosu -->
  <div
    class="rounded-3xl border-2 shadow-2xl p-6 sm:p-8 backdrop-blur-xl"
    style="
      background: linear-gradient(135deg, rgba(26, 16, 32, 0.95), rgba(18, 10, 24, 0.95));
      border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.25);
    "
  >
    <div class="flex items-center justify-between gap-4 mb-6 pb-4 border-b" style="border-color: rgba(255, 255, 255, 0.08);">
      <h2 class="text-lg sm:text-xl font-black text-white flex items-center gap-2.5" style="color: #ffffff !important;">
        <div class="w-8 h-8 rounded-xl flex items-center justify-center bg-primary/20 text-primary border border-primary/40">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
        <span>Son Verilen Cezalar</span>
      </h2>
    </div>

    <div id="recent-punishments" class="space-y-3">
      <div class="py-12 text-center text-gray-400 font-bold flex flex-col items-center justify-center">
        <div class="w-6 h-6 border-2 border-primary border-t-transparent rounded-full animate-spin mb-3"></div>
        <span class="text-xs">Cezalar Yükleniyor...</span>
      </div>
    </div>
  </div>
</div>

<script>
  window.SERVER_PUNISHMENTS_DATA = {{ punishments | json }};
</script>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const statBan = document.getElementById('stat-ban');
    const statMute = document.getElementById('stat-mute');
    const statWarning = document.getElementById('stat-warning');
    const recentList = document.getElementById('recent-punishments');

    let allData = [];

    function formatTimeAgo(dateStr) {
      const date = new Date(dateStr);
      const now = new Date();
      const seconds = Math.floor((now - date) / 1000);
      let interval = seconds / 31536000;
      if (interval > 1) return Math.floor(interval) + ' yıl önce';
      interval = seconds / 2592000;
      if (interval > 1) return Math.floor(interval) + ' ay önce';
      interval = seconds / 86400;
      if (interval > 1) return Math.floor(interval) + ' gün önce';
      interval = seconds / 3600;
      if (interval > 1) return Math.floor(interval) + ' saat önce';
      interval = seconds / 60;
      if (interval > 1) return Math.floor(interval) + ' dk önce';
      return 'Az önce';
    }

    function getTypeBadge(type) {
      if (type === 'BAN' || type === 'IP_BAN') {
        return '<span class="px-2.5 py-1 bg-rose-500/20 text-rose-300 border border-rose-500/40 rounded-xl text-[10px] font-black uppercase tracking-wider shadow">Ban</span>';
      }
      if (type === 'MUTE' || type === 'IP_MUTE') {
        return '<span class="px-2.5 py-1 bg-purple-500/20 text-purple-300 border border-purple-500/40 rounded-xl text-[10px] font-black uppercase tracking-wider shadow">Mute</span>';
      }
      return '<span class="px-2.5 py-1 bg-amber-500/20 text-amber-300 border border-amber-500/40 rounded-xl text-[10px] font-black uppercase tracking-wider shadow">Warn</span>';
    }

    function render(data) {
      let banCount = 0;
      let muteCount = 0;
      let warnCount = 0;

      data.forEach(item => {
        if (item.type === 'BAN' || item.type === 'IP_BAN') banCount++;
        else if (item.type === 'MUTE' || item.type === 'IP_MUTE') muteCount++;
        else if (item.type === 'WARNING') warnCount++;
      });

      if (statBan) statBan.innerText = banCount;
      if (statMute) statMute.innerText = muteCount;
      if (statWarning) statWarning.innerText = warnCount;

      const recents = data.slice(0, 10);
      if (recents.length === 0) {
        recentList.innerHTML = `
          <div class="py-10 text-center text-xs text-gray-400 font-bold">Kayıtlı ceza bulunmuyor.</div>
        `;
        return;
      }

      recentList.innerHTML = recents.map(item => `
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-4 rounded-2xl border transition-all hover:bg-white/5"
             style="background: rgba(14, 9, 20, 0.6); border-color: rgba(255, 255, 255, 0.08);">
          <div class="flex items-center gap-3.5">
            <img src="https://mc-heads.net/avatar/${item.punishedUser || 'steve'}/40" class="w-10 h-10 rounded-xl border border-primary/30 shadow" alt="">
            <div>
              <div class="flex items-center gap-2">
                <span class="font-black text-white text-sm" style="color: #ffffff !important;">${item.punishedUser || 'Bilinmiyor'}</span>
                ${getTypeBadge(item.type)}
              </div>
              <div class="text-xs text-gray-400 mt-1 font-medium line-clamp-1">
                Sebep: <span class="text-gray-300">${item.reason || 'Sebep belirtilmemiş'}</span>
              </div>
            </div>
          </div>
          <div class="flex sm:flex-col items-center sm:items-end justify-between gap-1 text-[11px] font-semibold text-gray-400 shrink-0">
            <div>Yetkili: <span class="text-purple-300 font-bold">${item.operator || 'Sistem'}</span></div>
            <div class="text-[10px] text-gray-500">${formatTimeAgo(item.createdAt)}</div>
          </div>
        </div>
      `).join('');
    }

    if (window.SERVER_PUNISHMENTS_DATA && window.SERVER_PUNISHMENTS_DATA.length > 0) {
      allData = window.SERVER_PUNISHMENTS_DATA;
      render(allData);
    } else {
      fetch('/api/storefront/v2/punishments')
        .then(res => res.json())
        .then(data => {
          if (Array.isArray(data)) {
            allData = data;
            render(allData);
          } else {
            recentList.innerHTML = '<div class="py-10 text-center text-xs text-gray-400 font-bold">Cezalar yüklenemedi.</div>';
          }
        })
        .catch(() => {
          recentList.innerHTML = '<div class="py-10 text-center text-xs text-gray-400 font-bold">Sunucuyla bağlantı kurulamadı.</div>';
        });
    }
  });
</script>
