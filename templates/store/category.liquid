<!-- ============================================================
     STORE > CATEGORY (Ürün Listesi - crafter-purpy 1:1 Port)
     ============================================================ -->
<div class="w-full max-w-[1350px] mx-auto px-4 sm:px-6 py-6 sm:py-8">
  <!-- Breadcrumb -->
  <div class="flex flex-wrap items-center gap-2 text-xs sm:text-sm font-semibold mb-6 px-4 py-2.5 rounded-xl border backdrop-blur-md w-fit"
       style="background: rgba(26, 16, 32, 0.7); border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.20);">
    <a href="/store" class="hover:text-primary transition-colors flex items-center gap-1.5" style="color: #cbd5e1;">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
      </svg>
      <span>Mağaza</span>
    </a>
    <span class="text-gray-500">/</span>
    <a href="/store/{{ server.slug }}" class="hover:text-primary transition-colors" style="color: #cbd5e1;">
      {{ server.name | default: 'Sunucu' }}
    </a>
    <span class="text-gray-500">/</span>
    <span class="font-bold" style="color: var(--color-primary);">{{ category.name | default: 'Kategori' }}</span>
  </div>

  <!-- StoreHeader Container -->
  <div
    class="w-full rounded-2xl p-6 sm:p-8 mb-8 shadow-xl border-2 relative overflow-hidden flex flex-col md:flex-row items-center justify-between gap-6"
    style="
      background: linear-gradient(135deg, rgba(26, 16, 32, 0.95), rgba(18, 10, 24, 0.95));
      border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.25);
    "
  >
    <div class="flex-1 min-w-0 z-10">
      <div class="flex items-center gap-3 mb-2">
        <div class="w-2 h-8 rounded-full" style="background: linear-gradient(to bottom, var(--color-primary), #9333ea);"></div>
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-black uppercase tracking-wide text-white" style="color: #ffffff !important;">
          {{ category.name }}
        </h1>
      </div>
      <p class="text-sm sm:text-base text-gray-300 max-w-2xl font-medium" style="color: rgba(255, 255, 255, 0.75) !important;">
        {{ category.description | default: 'Bu kategorideki tüm ürün ve paketleri aşağıdan inceleyebilirsiniz.' }}
      </p>
    </div>

    {% if category.image != blank %}
      <div class="shrink-0 relative z-10">
        <div class="relative w-24 h-24 sm:w-28 sm:h-28 md:w-32 md:h-32">
          <div
            class="absolute inset-0 rounded-full blur-2xl opacity-50 pointer-events-none"
            style="background-color: var(--color-primary);"
          ></div>
          <img
            src="{{ category.image }}"
            alt="{{ category.name }}"
            class="w-full h-full object-contain drop-shadow-2xl"
          >
        </div>
      </div>
    {% endif %}

    <!-- Decorative Corner Glow -->
    <div
      class="absolute top-0 right-0 w-64 h-64 rounded-full blur-3xl pointer-events-none opacity-20"
      style="background: radial-gradient(circle, var(--color-primary), transparent 70%);"
    ></div>
  </div>

  <!-- ÜRÜNLER ALANI -->
  {% if products and products.size > 0 %}
    {% if category.type == 'listed_products' %}
      <!-- ============================================================
           1:1 PRODUCT COMPARISON TABLE (crafter-purpy)
           ============================================================ -->
      <div class="w-full overflow-x-auto pb-6">
        <div class="min-w-[800px]">
          <!-- Ürün Başlık Kartları Grid -->
          <div
            class="grid gap-4 mb-6"
            style="grid-template-columns: 250px repeat({{ products.size }}, minmax(180px, 1fr));"
          >
            <!-- Sol Boş Köşe -->
            <div class="p-4 flex items-end">
              <span class="text-xs font-bold uppercase tracking-wider text-gray-400">Ürün Karşılaştırma</span>
            </div>

            <!-- Ürün Kartları -->
            {% for product in products %}
              <div
                class="rounded-2xl p-5 flex flex-col items-center gap-3 border-2 shadow-xl relative transition-all duration-300 hover:border-primary/60"
                style="
                  background: linear-gradient(135deg, rgba(26, 16, 32, 0.95), rgba(18, 10, 24, 0.95));
                  border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.25);
                "
              >
                <!-- Ürün Resmi -->
                <a href="/store/{{ server.slug }}/{{ category.slug }}/{{ product.slug }}" class="relative w-24 h-24 rounded-xl overflow-hidden flex items-center justify-center p-2"
                   style="background: rgba(14, 9, 20, 0.8);">
                  {% if product.image != blank %}
                    <img src="{{ product.image }}" alt="{{ product.name }}" class="w-full h-full object-contain hover:scale-110 transition-transform duration-300">
                  {% else %}
                    <svg class="w-10 h-10 text-primary/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
                    </svg>
                  {% endif %}
                </a>

                <!-- Ürün İsmi -->
                <a href="/store/{{ server.slug }}/{{ category.slug }}/{{ product.slug }}" class="text-center">
                  <h3 class="font-bold text-base text-white hover:text-primary transition-colors line-clamp-2" style="color: #ffffff !important;">
                    {{ product.name }}
                  </h3>
                </a>

                <!-- Ürün Açıklaması -->
                <p class="text-xs text-gray-400 text-center line-clamp-2">
                  {{ product.description | lexical_text | default: product.description | truncate: 80 }}
                </p>

                <!-- Fiyat -->
                <div class="text-xl font-black" style="color: var(--color-primary);">
                  ₺{{ product.price }}
                </div>

                <!-- Sepete Ekle Butonu -->
                <button
                  onclick="handleAddToCart('{{ product.id }}', '{{ product.name | escape }}', '{{ product.price }}', '{{ product.image }}')"
                  {% if product.stock != null and product.stock == 0 %}disabled{% endif %}
                  class="w-full py-2.5 px-3 rounded-xl font-bold text-xs text-white uppercase tracking-wider shadow-md transition-all hover:scale-105 disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer"
                  style="background: linear-gradient(135deg, var(--color-primary), #9333ea);"
                >
                  {% if product.stock != null and product.stock == 0 %}
                    Stokta Yok
                  {% else %}
                    Sepete Ekle
                  {% endif %}
                </button>
              </div>
            {% endfor %}
          </div>

          <!-- Özellikler Tablosu (Addons & Features) -->
          {% if category.addons and category.addons.size > 0 %}
            <div
              class="rounded-2xl border-2 overflow-hidden shadow-2xl"
              style="
                background: linear-gradient(135deg, rgba(26, 16, 32, 0.95), rgba(18, 10, 24, 0.95));
                border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.25);
              "
            >
              {% for addon in category.addons %}
                <div class="border-b last:border-b-0" style="border-color: rgba(255, 255, 255, 0.08);">
                  <!-- Addon Başlığı -->
                  <div class="p-4 border-b" style="background: rgba(var(--color-primary-rgb, 124, 58, 237), 0.15); border-color: rgba(255, 255, 255, 0.08);">
                    <h4 class="font-black text-sm sm:text-base uppercase tracking-wider text-white" style="color: #ffffff !important;">
                      {{ addon.title }}
                    </h4>
                  </div>

                  <!-- Özellik Satırları -->
                  {% for feature in addon.features %}
                    <div
                      class="grid gap-4 items-center border-b last:border-b-0 hover:bg-white/[0.02] transition-colors"
                      style="
                        grid-template-columns: 250px repeat({{ products.size }}, minmax(180px, 1fr));
                        border-color: rgba(255, 255, 255, 0.06);
                      "
                    >
                      <!-- Özellik İsmi ve Info Tooltip -->
                      <div class="p-4 flex items-center gap-2 border-r" style="border-color: rgba(255, 255, 255, 0.06);">
                        <span class="font-medium text-xs sm:text-sm text-gray-200" style="color: #e2e8f0 !important;">
                          {{ feature.title }}
                        </span>
                        {% if feature.info != blank %}
                          <div class="relative group/tip inline-flex items-center">
                            <svg class="w-4 h-4 text-gray-400 hover:text-primary cursor-pointer transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                            <div class="absolute left-full ml-2 top-1/2 -translate-y-1/2 w-56 p-2.5 rounded-xl text-xs leading-relaxed opacity-0 invisible group-hover/tip:opacity-100 group-hover/tip:visible transition-all z-50 shadow-2xl bg-gray-950 text-gray-200 border border-purple-500/30 pointer-events-none">
                              {{ feature.info }}
                            </div>
                          </div>
                        {% endif %}
                      </div>

                      <!-- Her Ürün İçin Özellik Değeri (Check / X / CustomValue) -->
                      {% for product in products %}
                        {% assign is_included = false %}
                        {% assign custom_val = '' %}

                        {% for sel_addon in product.selectedAddons %}
                          {% assign sel_aid = sel_addon.addonId | default: sel_addon.addon_id | default: sel_addon.id %}
                          {% if sel_aid == addon.id %}
                            {% for sel_feat in sel_addon.features %}
                              {% assign sel_fid = sel_feat.featureId | default: sel_feat.feature_id | default: sel_feat.id %}
                              {% if sel_fid == feature.id %}
                                {% if sel_feat.included == true or sel_feat.included == 'true' or sel_feat.included == 1 %}
                                  {% assign is_included = true %}
                                {% endif %}
                                {% assign custom_val = sel_feat.customValue | default: sel_feat.custom_value %}
                              {% endif %}
                            {% endfor %}
                          {% endif %}
                        {% endfor %}

                        <!-- Fallback to direct product.addons if exists -->
                        {% if is_included == false and custom_val == blank %}
                          {% for p_addon in product.addons %}
                            {% if p_addon.addon_id == addon.id or p_addon.id == addon.id %}
                              {% if p_addon.value != blank %}
                                {% assign custom_val = p_addon.value %}
                                {% assign is_included = true %}
                              {% endif %}
                            {% endif %}
                          {% endfor %}
                        {% endif %}

                        <div class="p-4 flex items-center justify-center text-center border-r last:border-r-0" style="border-color: rgba(255, 255, 255, 0.06);">
                          {% if is_included %}
                            {% if custom_val != blank and custom_val != '' and custom_val != 'true' and custom_val != '1' %}
                              <span class="text-xs font-bold text-white px-2.5 py-1 rounded-lg border"
                                    style="background: rgba(var(--color-primary-rgb, 124, 58, 237), 0.2); border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.35); color: #ffffff !important;">
                                {{ custom_val }}
                              </span>
                            {% else %}
                              <div class="w-7 h-7 rounded-full flex items-center justify-center bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3">
                                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                                </svg>
                              </div>
                            {% endif %}
                          {% else %}
                            <div class="w-7 h-7 rounded-full flex items-center justify-center bg-rose-500/10 text-rose-400 border border-rose-500/20 opacity-75">
                              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                              </svg>
                            </div>
                          {% endif %}
                        </div>
                      {% endfor %}
                    </div>
                  {% endfor %}
                </div>
              {% endfor %}
            </div>
          {% else %}
            <div class="p-8 text-center text-gray-400 rounded-2xl border" style="background: rgba(26, 16, 32, 0.6); border-color: rgba(255, 255, 255, 0.08);">
              Bu kategoride karşılaştırma özelliği bulunmamaktadır.
            </div>
          {% endif %}
        </div>
      </div>

    {% else %}
      <!-- ============================================================
           STANDART PRODUCT GRID (1:1 ProductCard)
           ============================================================ -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 sm:gap-6">
        {% for product in products %}
          {% assign is_out_of_stock = false %}
          {% if product.stock != null and product.stock == 0 %}
            {% assign is_out_of_stock = true %}
          {% endif %}

          <div class="relative h-full group block cursor-pointer">
            <div
              class="relative overflow-hidden rounded-2xl transition-all duration-500 ease-out hover:scale-[1.02] hover:-translate-y-1 shadow-xl hover:shadow-2xl p-5 sm:p-6 flex flex-col gap-4 min-h-[350px] h-full border-2"
              style="
                background: linear-gradient(135deg, rgba(26, 16, 32, 0.95), rgba(18, 10, 24, 0.95));
                border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.20);
              "
              onmouseover="this.style.borderColor='rgba(var(--color-primary-rgb, 124, 58, 237), 0.6)'; this.style.boxShadow='0 20px 40px rgba(var(--color-primary-rgb, 124, 58, 237), 0.25)';"
              onmouseout="this.style.borderColor='rgba(var(--color-primary-rgb, 124, 58, 237), 0.20)'; this.style.boxShadow='none';"
            >
              <!-- Animated Gradient Overlay -->
              <div
                class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"
                style="background: linear-gradient(135deg, rgba(var(--color-primary-rgb, 124, 58, 237), 0.15), transparent, rgba(140, 80, 220, 0.15));"
              ></div>

              <!-- Content Container -->
              <div class="relative z-10 flex flex-col gap-3 h-full">
                <!-- Badges Row -->
                <div class="flex items-center justify-between gap-2 flex-shrink-0">
                  <div class="flex items-center gap-1.5 flex-wrap">
                    {% if is_out_of_stock %}
                      <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-red-500/20 text-red-400 border border-red-500/30">
                        Tükendi
                      </span>
                    {% elsif product.stock and product.stock > 0 and product.stock <= 10 %}
                      <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-amber-500/20 text-amber-400 border border-amber-500/30 animate-pulse">
                        Son {{ product.stock }} Adet
                      </span>
                    {% else %}
                      <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">
                        Stokta
                      </span>
                    {% endif %}

                    {% if product.isFeatured %}
                      <span class="px-2 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider text-white shadow-sm"
                            style="background: linear-gradient(135deg, var(--color-primary), #9333ea);">
                        Öne Çıkan
                      </span>
                    {% endif %}
                  </div>

                  {% if product.discountValue and product.discountValue > 0 %}
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-black text-white bg-rose-600 shadow-sm">
                      -{{ product.discountValue }}{% if product.discountType == 'percentage' %}%{% else %}₺{% endif %}
                    </span>
                  {% endif %}
                </div>

                <!-- Product Image -->
                <a href="/store/{{ server.slug }}/{{ category.slug }}/{{ product.slug }}" class="flex-1 flex items-center justify-center py-4">
                  <div class="relative w-[120px] h-[120px] sm:w-[130px] sm:h-[130px]">
                    <div
                      class="absolute inset-0 rounded-full blur-2xl opacity-0 group-hover:opacity-60 transition-all duration-700 pointer-events-none"
                      style="background-color: var(--color-primary);"
                    ></div>
                    {% if product.image != blank %}
                      <img
                        src="{{ product.image }}"
                        alt="{{ product.name }}"
                        class="w-full h-full object-contain drop-shadow-2xl transition-all duration-500 group-hover:scale-110 group-hover:brightness-110"
                      >
                    {% else %}
                      <div class="w-full h-full flex items-center justify-center rounded-2xl bg-purple-950/30 border border-primary/20">
                        <svg class="w-12 h-12 text-primary/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
                        </svg>
                      </div>
                    {% endif %}
                  </div>
                </a>

                <!-- Product Info & Price -->
                <div class="text-center flex-shrink-0 space-y-1">
                  <a href="/store/{{ server.slug }}/{{ category.slug }}/{{ product.slug }}">
                    <h3 class="text-base sm:text-lg font-black leading-tight truncate transition-colors hover:text-primary" style="color: #ffffff !important;">
                      {{ product.name }}
                    </h3>
                  </a>

                  <div class="flex items-center justify-center gap-2 pt-1">
                    {% if product.discountValue and product.discountValue > 0 %}
                      <s class="text-xs text-gray-400 font-semibold">₺{{ product.price }}</s>
                      {% if product.discountType == 'percentage' %}
                        {% assign discount_amount = product.price | times: product.discountValue | divided_by: 100 %}
                        {% assign final_price = product.price | minus: discount_amount %}
                      {% else %}
                        {% assign final_price = product.price | minus: product.discountValue %}
                      {% endif %}
                      <span class="text-lg sm:text-xl font-black" style="color: var(--color-primary);">₺{{ final_price }}</span>
                    {% else %}
                      <span class="text-lg sm:text-xl font-black" style="color: var(--color-primary);">₺{{ product.price }}</span>
                    {% endif %}
                  </div>
                </div>

                <!-- Product Actions Row -->
                <div class="flex items-center gap-2 mt-auto pt-2 flex-shrink-0">
                  <!-- Info / Details button -->
                  <a
                    href="/store/{{ server.slug }}/{{ category.slug }}/{{ product.slug }}"
                    class="p-2.5 rounded-xl border transition-all duration-300 hover:scale-105 flex items-center justify-center cursor-pointer"
                    style="
                      background: rgba(14, 9, 20, 0.7);
                      border-color: rgba(255, 255, 255, 0.12);
                      color: #ffffff;
                    "
                    title="Detaylar"
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                  </a>

                  <!-- Add to Cart button -->
                  <button
                    onclick="handleAddToCart('{{ product.id }}', '{{ product.name | escape }}', '{{ product.price }}', '{{ product.image }}')"
                    class="p-2.5 rounded-xl border transition-all duration-300 hover:scale-105 flex items-center justify-center cursor-pointer"
                    style="
                      background: rgba(14, 9, 20, 0.7);
                      border-color: rgba(255, 255, 255, 0.12);
                      color: #ffffff;
                    "
                    title="Sepete Ekle"
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
                    </svg>
                  </button>

                  <!-- Buy Now Button -->
                  <button
                    onclick="openBuyModal('{{ product.id }}', '{{ product.name | escape }}', '{{ product.price }}', '{{ product.image }}')"
                    class="flex-1 py-2.5 px-3 rounded-xl font-bold text-xs text-white uppercase tracking-wider flex items-center justify-center gap-1.5 shadow-lg transition-all duration-300 hover:scale-[1.03] cursor-pointer"
                    style="background: linear-gradient(135deg, var(--color-primary), #9333ea);"
                  >
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                    </svg>
                    <span>Hemen Al</span>
                  </button>
                </div>
              </div>

              <!-- Shine Effect on Hover -->
              <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-1000 pointer-events-none overflow-hidden">
                <div class="absolute top-0 -left-full h-full w-1/3 bg-gradient-to-r from-transparent via-white/10 to-transparent skew-x-12 group-hover:left-full transition-all duration-1000"></div>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}

  {% else %}
    <div
      class="col-span-full py-16 px-6 text-center rounded-2xl border-2 border-dashed flex flex-col items-center justify-center gap-3"
      style="background: rgba(14, 9, 20, 0.4); border-color: rgba(255,255,255,0.08);"
    >
      <svg class="w-16 h-16 text-gray-500 opacity-40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
      </svg>
      <h3 class="text-lg font-bold text-white">Bu Kategoride Henüz Ürün Bulunmuyor</h3>
      <p class="text-xs text-gray-400">Yakında bu kategoriye özel avantajlı ürünler eklenecektir.</p>
      <a href="/store/{{ server.slug }}" class="mt-2 px-5 py-2.5 rounded-xl text-xs font-bold text-white shadow-lg transition-all hover:scale-105"
         style="background: linear-gradient(135deg, var(--color-primary), #9333ea);">
        Diğer Kategorilere Göz At
      </a>
    </div>
  {% endif %}
</div>

<!-- ============================================================
     BUY NOW CONFIRMATION MODAL (crafter-purpy 1:1 Dialog)
     ============================================================ -->
<div id="buy-now-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 hidden backdrop-blur-md" style="background: rgba(0, 0, 0, 0.75);">
  <div class="relative w-full max-w-md rounded-3xl p-6 sm:p-8 shadow-2xl border-2 overflow-hidden animate-in fade-in zoom-in duration-300"
       style="background: linear-gradient(135deg, #1a1020, #140c1c); border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.4);">
    
    <!-- Modal Header -->
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-xl font-black uppercase text-white" style="color: #ffffff !important;">Hemen Satın Al</h3>
      <button onclick="closeBuyModal()" class="w-8 h-8 rounded-full flex items-center justify-center text-gray-400 hover:text-white transition-colors"
              style="background: rgba(255, 255, 255, 0.08);">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <p class="text-xs text-gray-300 mb-5">Bu ürünü mevcut bakiyenizle hemen satın almak istediğinize emin misiniz?</p>

    <!-- Product Summary Card -->
    <div class="flex items-center gap-4 p-4 rounded-2xl mb-4 border"
         style="background: rgba(14, 9, 20, 0.7); border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.25);">
      <img id="modal-product-img" src="" alt="" class="w-14 h-14 object-contain rounded-xl">
      <div class="flex-1 min-w-0">
        <h4 id="modal-product-name" class="font-bold text-white truncate text-sm" style="color: #ffffff !important;"></h4>
        <p class="text-xs text-gray-400">Adet: 1</p>
      </div>
      <div class="text-right">
        <span id="modal-product-price" class="font-black text-lg" style="color: var(--color-primary);"></span>
      </div>
    </div>

    <!-- User Balance Summary -->
    <div class="p-4 rounded-2xl mb-6 border flex items-center justify-between"
         style="background: rgba(var(--color-primary-rgb, 124, 58, 237), 0.10); border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.25);">
      <div class="flex items-center gap-2">
        <svg class="w-5 h-5 text-purple-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg>
        <span class="text-xs text-gray-300 font-semibold">Mevcut Bakiyeniz:</span>
      </div>
      <span class="font-black text-base text-emerald-400">₺{{ customer.balance | default: customer.credit | default: 0 }}</span>
    </div>

    <!-- Modal Actions -->
    <div class="flex items-center gap-3">
      <button onclick="closeBuyModal()" class="flex-1 py-3 rounded-xl font-bold text-xs text-gray-300 hover:text-white border transition-colors"
              style="background: rgba(255, 255, 255, 0.05); border-color: rgba(255, 255, 255, 0.1);">
        Vazgeç
      </button>
      <button id="modal-confirm-btn" onclick="confirmDirectPurchase()" class="flex-1 py-3 rounded-xl font-black text-xs text-white uppercase tracking-wider shadow-lg transition-all hover:scale-105"
              style="background: linear-gradient(135deg, var(--color-primary), #9333ea);">
        Onayla ve Satın Al
      </button>
    </div>
  </div>
</div>

<script>
  let activeProductId = null;

  function openBuyModal(id, name, price, image) {
    {% if customer %}
      activeProductId = id;
      document.getElementById('modal-product-name').textContent = name;
      document.getElementById('modal-product-price').textContent = '₺' + price;
      const imgEl = document.getElementById('modal-product-img');
      if (imgEl) imgEl.src = image || '';
      document.getElementById('buy-now-modal').classList.remove('hidden');
    {% else %}
      window.location.href = '/auth/login';
    {% endif %}
  }

  function closeBuyModal() {
    document.getElementById('buy-now-modal').classList.add('hidden');
    activeProductId = null;
  }

  async function confirmDirectPurchase() {
    if (!activeProductId) return;
    const btn = document.getElementById('modal-confirm-btn');
    if (btn) {
      btn.disabled = true;
      btn.textContent = 'İşleniyor...';
    }

    try {
      const res = await fetch('/api/storefront/v2/cart/checkout', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ productIds: [activeProductId] })
      });
      if (res.ok) {
        window.location.href = '/chest';
      } else {
        if (window.CrafterCart && window.CrafterCart.add) {
          window.CrafterCart.add(activeProductId, 1);
        }
        window.location.href = '/cart';
      }
    } catch(err) {
      window.location.href = '/cart';
    }
  }

  function handleAddToCart(id, name, price, image) {
    if (window.CrafterCart && window.CrafterCart.add) {
      window.CrafterCart.add(id, 1);
    } else {
      const form = document.createElement('form');
      form.method = 'POST';
      form.action = '/cart/add';
      const input = document.createElement('input');
      input.type = 'hidden';
      input.name = 'id';
      input.value = id;
      form.appendChild(input);
      document.body.appendChild(form);
      form.submit();
    }
  }
</script>
