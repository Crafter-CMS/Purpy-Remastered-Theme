  <script>
    // Asynchronous feed synchronization if needed
    async function syncCommunityFeed() {
      try {
        const res = await fetch('/api/storefront/v2/statistics');
        if (!res.ok) return;
        const data = await res.json();
        if (!data || !data.data) return;
        // Feeds can be dynamically enhanced here
      } catch(e) {}
    }
  </script>

  <script>
    // Live Statistics Fetcher for 3-Column Community Stream
    (function fetchLiveCommunityStreams() {
      async function loadStats() {
        try {
          const endpoints = [
            '/api/storefront/v2/statistics',
            '/api/website/v2/statistics',
            '/api/statistics'
          ];
          let data = null;
          for (const ep of endpoints) {
            try {
              const res = await fetch(ep);
              if (res.ok) {
                const json = await res.json();
                data = json.data || json;
                if (data && (data.latest || data.payments || data.purchases || data.signups)) break;
              }
            } catch(e) {}
          }

          if (!data) return;

          const latest = data.latest || data;
          const payments = latest.payments || [];
          const purchases = latest.purchases || [];
          const signups = latest.signups || [];

          // 1. Update Purchases Column
          if (purchases.length > 0) {
            const listEl = document.getElementById('purchases-feed-list');
            if (listEl) {
              listEl.innerHTML = purchases.slice(0, 4).map(p => `
                <div class="flex items-center gap-3.5 p-3 rounded-2xl border transition-all duration-300 hover:scale-[1.02]"
                     style="background: rgba(14, 9, 20, 0.7); border-color: rgba(255, 255, 255, 0.06);"
                     onmouseover="this.style.borderColor='rgba(var(--color-primary-rgb, 124, 58, 237), 0.4)';"
                     onmouseout="this.style.borderColor='rgba(255, 255, 255, 0.06)';">
                  <div class="relative w-11 h-11 rounded-xl overflow-hidden border flex-shrink-0" style="border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.35);">
                    <img src="https://mc-heads.net/avatar/${p.username}/44" alt="${p.username}" class="w-full h-full object-cover">
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="font-bold text-xs text-white truncate">${p.username}</div>
                    <div class="text-[11px] font-semibold truncate text-purple-300">${p.productName || 'Mağaza Ürünü'}</div>
                  </div>
                  <div class="text-right flex-shrink-0">
                    <span class="px-2.5 py-1 rounded-lg text-xs font-black text-white shadow-sm" style="background: rgba(var(--color-primary-rgb, 124, 58, 237), 0.3); border: 1px solid rgba(var(--color-primary-rgb, 124, 58, 237), 0.4);">
                      ₺${p.amount}
                    </span>
                  </div>
                </div>
              `).join('');
            }
          }

          // 2. Update Payments Column
          if (payments.length > 0) {
            const listEl = document.getElementById('payments-feed-list');
            if (listEl) {
              listEl.innerHTML = payments.slice(0, 4).map(p => `
                <div class="flex items-center gap-3.5 p-3 rounded-2xl border transition-all duration-300 hover:scale-[1.02]"
                     style="background: rgba(14, 9, 20, 0.7); border-color: rgba(255, 255, 255, 0.06);"
                     onmouseover="this.style.borderColor='rgba(16, 185, 129, 0.4)';"
                     onmouseout="this.style.borderColor='rgba(255, 255, 255, 0.06)';">
                  <div class="relative w-11 h-11 rounded-xl overflow-hidden border flex-shrink-0" style="border-color: rgba(16, 185, 129, 0.35);">
                    <img src="https://mc-heads.net/avatar/${p.username}/44" alt="${p.username}" class="w-full h-full object-cover">
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="font-bold text-xs text-white truncate">${p.username}</div>
                    <div class="text-[11px] font-semibold text-emerald-400">Bakiye Yüklemesi</div>
                  </div>
                  <div class="text-right flex-shrink-0">
                    <span class="px-2.5 py-1 rounded-lg text-xs font-black text-emerald-400 shadow-sm" style="background: rgba(16, 185, 129, 0.2); border: 1px solid rgba(16, 185, 129, 0.35);">
                      +${p.amount} ₺
                    </span>
                  </div>
                </div>
              `).join('');
            }
          }

          // 3. Update Signups Row (6-Grid)
          if (signups.length > 0) {
            const listEl = document.getElementById('signups-feed-list');
            if (listEl) {
              listEl.innerHTML = signups.slice(0, 6).map(u => `
                <div class="flex flex-col items-center text-center p-4 rounded-2xl border transition-all duration-300 hover:scale-105 hover:-translate-y-1 group"
                     style="background: rgba(14, 9, 20, 0.7); border-color: rgba(255, 255, 255, 0.07);"
                     onmouseover="this.style.borderColor='rgba(56, 189, 248, 0.5)';"
                     onmouseout="this.style.borderColor='rgba(255, 255, 255, 0.07)';">
                  <div class="relative w-14 h-14 rounded-2xl overflow-hidden border-2 mb-2.5 shadow-lg group-hover:scale-105 transition-transform"
                       style="border-color: rgba(56, 189, 248, 0.35);">
                    <img src="https://mc-heads.net/avatar/${u.username}/56" alt="${u.username}" class="w-full h-full object-cover">
                  </div>
                  <h4 class="font-black text-xs text-white truncate w-full mb-1" style="color: #ffffff !important;">${u.username}</h4>
                  <span class="px-2 py-0.5 rounded-md text-[10px] font-bold text-sky-300 border"
                        style="background: rgba(56, 189, 248, 0.15); border-color: rgba(56, 189, 248, 0.3);">
                    Yeni Üye
                  </span>
                </div>
              `).join('');
            }
          }
        } catch(err) {
          console.warn('Live community stream error:', err);
        }
      }
      loadStats();
    })();
  </script>
