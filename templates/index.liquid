            <div class="flex flex-col text-left">
              <span class="text-[10px] font-black uppercase tracking-wider text-purple-300">SUNUCU ADRESİ (KOPYALA)</span>
              <span class="text-sm sm:text-base font-black text-white tracking-wide group-hover:text-primary transition-colors font-mono" style="color: #ffffff !important;">{{ settings.server_ip | default: 'mc.hypixel.net' }}</span>
