<!-- ============================================================
     KUPON BOZDUR (Purpy Remastered Dark Luxury)
     ============================================================ -->
{% if customer %}
  <div class="w-full max-w-[1350px] mx-auto px-4 sm:px-6 py-6 sm:py-10 space-y-8 min-h-[60vh]">
    <!-- Breadcrumb -->
    <div
      class="flex flex-wrap items-center gap-2 text-xs sm:text-sm font-semibold px-4 py-2.5 rounded-2xl border backdrop-blur-md w-fit shadow-lg"
      style="
        background: linear-gradient(135deg, rgba(26, 16, 32, 0.85), rgba(18, 10, 24, 0.85));
        border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.25);
      "
    >
      <a href="/" class="hover:text-primary transition-colors flex items-center gap-1.5" style="color: #cbd5e1;">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
        </svg>
      </a>
      <span class="text-gray-500">/</span>
      <span class="font-bold" style="color: var(--color-primary);">Kupon Kullan</span>
    </div>

    <!-- Header -->
    <div class="flex items-center gap-3.5 mb-8">
      <div class="w-2 h-10 rounded-full" style="background: linear-gradient(to bottom, var(--color-primary), #9333ea);"></div>
      <div>
        <h1 class="text-2xl sm:text-3xl font-black text-white uppercase tracking-wide" style="color: #ffffff !important;">
          Kupon Bozdur
        </h1>
        <p class="text-xs sm:text-sm font-medium text-gray-300">
          Sunucumuz veya etkinlikler tarafından verilen hediye & promosyon kuponlarınızı buradan anında bozdurabilirsiniz.
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- SOL: Ana Bölüm (8 Cols) -->
      <div class="lg:col-span-8">
        <div
          class="rounded-3xl border-2 shadow-2xl p-6 sm:p-10 backdrop-blur-xl"
          style="
            background: linear-gradient(135deg, rgba(26, 16, 32, 0.95), rgba(18, 10, 24, 0.95));
            border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.25);
          "
        >
          <!-- Başarı Mesajı -->
          <div id="redeem-success" class="hidden mb-8 p-6 rounded-2xl border relative overflow-hidden"
               style="background: rgba(16, 185, 129, 0.15); border-color: rgba(16, 185, 129, 0.4);">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-xl bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 flex items-center justify-center shrink-0">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                </svg>
              </div>
              <div class="flex-1">
                <h4 class="text-base font-black text-emerald-300 mb-1">Tebrikler! Kupon Başarıyla Kullanıldı</h4>
                <p id="redeem-success-text" class="text-xs sm:text-sm text-emerald-200 font-medium mb-3">
                  Ödülleriniz hesabınıza tanımlandı.
                </p>
                <div id="redeem-rewards" class="space-y-2">
                  <!-- JS ile ödüller buraya eklenecek -->
                </div>
              </div>
            </div>
          </div>

          <!-- Hata Mesajı -->
          <div id="redeem-error" class="hidden mb-8 p-6 rounded-2xl border relative overflow-hidden"
               style="background: rgba(239, 68, 68, 0.15); border-color: rgba(239, 68, 68, 0.4);">
            <div class="flex items-center gap-4">
              <div class="w-12 h-12 rounded-xl bg-rose-500/20 text-rose-400 border border-rose-500/40 flex items-center justify-center shrink-0">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/>
                </svg>
              </div>
              <div>
                <h4 class="text-base font-black text-rose-300 mb-1">Kupon Geçersiz</h4>
                <p id="redeem-error-text" class="text-xs sm:text-sm text-rose-200 font-medium">Bu kupon kodunu kullanamazsınız.</p>
              </div>
            </div>
          </div>

          <!-- Kupon Formu -->
          <form id="redeem-form" class="space-y-6">
            <div>
              <label class="block text-xs font-black uppercase tracking-wider text-purple-300 mb-3">
                KUPON / PROMOSYON KODU
              </label>
              <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-5 flex items-center pointer-events-none text-gray-400">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
                  </svg>
                </div>
                <input
                  type="text"
                  id="input-code"
                  placeholder="XXXX-XXXX-XXXX"
                  class="w-full pl-14 pr-6 py-5 rounded-2xl border-2 focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary transition-all font-mono font-black text-lg sm:text-xl tracking-widest text-white placeholder:text-gray-500 shadow-inner uppercase"
                  style="background: rgba(14, 9, 20, 0.85); border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.35);"
                  autocomplete="off"
                >
              </div>
            </div>

            <button
              type="submit"
              id="btn-submit"
              class="w-full sm:w-auto px-10 py-4.5 rounded-2xl font-black text-sm uppercase tracking-wider text-white shadow-2xl transition-all duration-300 hover:scale-105 flex items-center justify-center gap-2.5 border border-white/20 cursor-pointer disabled:opacity-50"
              style="
                background: linear-gradient(135deg, var(--color-primary), #9333ea);
                box-shadow: 0 10px 30px rgba(var(--color-primary-rgb, 124, 58, 237), 0.45);
              "
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7"/>
              </svg>
              <span>Kuponu Bozdur</span>
            </button>
          </form>
        </div>
      </div>

      <!-- SAĞ: Bilgi Paneli (4 Cols) -->
      <div class="lg:col-span-4">
        <div
          class="rounded-3xl border-2 shadow-2xl p-6 sm:p-7 backdrop-blur-xl space-y-6"
          style="
            background: linear-gradient(135deg, rgba(28, 16, 38, 0.95), rgba(18, 10, 24, 0.95));
            border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.30);
          "
        >
          <div class="flex items-center gap-3 pb-4 border-b" style="border-color: rgba(255, 255, 255, 0.08);">
            <div class="w-10 h-10 rounded-xl bg-primary/20 text-primary flex items-center justify-center border border-primary/40">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <h3 class="text-lg font-black text-white" style="color: #ffffff !important;">Bilgilendirme</h3>
          </div>

          <ul class="space-y-4 text-xs sm:text-sm font-medium text-gray-300">
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-emerald-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
              </svg>
              <span>Eğer kupon kodu geçerliyse, kazandığınız ödüller doğrudan hesabınıza tanımlanır.</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
              </svg>
              <span>Bakiye ödülleri cüzdanınıza eklenirken, eşya ödülleri site envanterinize (sandığınıza) gönderilir.</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-amber-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
              </svg>
              <span>Kuponlar tek kullanımlıktır ve başka hesaplara aktarılamaz.</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('redeem-form');
      const inputCode = document.getElementById('input-code');
      const btnSubmit = document.getElementById('btn-submit');

      const boxSuccess = document.getElementById('redeem-success');
      const textSuccess = document.getElementById('redeem-success-text');
      const rewardsList = document.getElementById('redeem-rewards');

      const boxError = document.getElementById('redeem-error');
      const textError = document.getElementById('redeem-error-text');

      form?.addEventListener('submit', async (e) => {
        e.preventDefault();

        const code = inputCode.value.trim();
        if (!code) return;

        boxSuccess?.classList.add('hidden');
        boxError?.classList.add('hidden');
        if (rewardsList) rewardsList.innerHTML = '';

        btnSubmit.disabled = true;
        btnSubmit.innerHTML = `
          <div class="w-4 h-4 border-2 border-white/20 border-t-white rounded-full animate-spin mr-2"></div>
          <span>Kontrol Ediliyor...</span>
        `;

        try {
          const res = await fetch('/api/storefront/redeem-codes/use', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ code }),
          });

          const data = await res.json();

          if (res.ok && !data.error) {
            boxSuccess?.classList.remove('hidden');
            if (textSuccess) textSuccess.innerText = data.message || 'Kupon başarıyla bozduruldu.';
            inputCode.value = '';

            if (data.bonus || (data.products && data.products.length > 0)) {
              let html = '';
              if (data.bonus) {
                html += `
                  <div class="flex items-center gap-3 p-3.5 rounded-2xl border shadow-sm mt-3"
                       style="background: rgba(16, 185, 129, 0.15); border-color: rgba(16, 185, 129, 0.35);">
                    <div class="w-10 h-10 rounded-xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-black text-xl border border-emerald-500/30">₺</div>
                    <div>
                      <div class="text-[10px] font-black text-gray-300 uppercase tracking-wider">Kazanılan Bakiye</div>
                      <div class="font-black text-emerald-300 text-base">+${data.bonus} ₺</div>
                    </div>
                  </div>
                `;
              }
              if (data.products && data.products.length > 0) {
                const pList = data.products
                  .map(
                    (p) => `
                  <li class="flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                    <span class="font-bold text-white text-xs">${p.name}</span>
                  </li>
                `
                  )
                  .join('');
                html += `
                  <div class="flex items-start gap-3 p-3.5 rounded-2xl border shadow-sm mt-2"
                       style="background: rgba(124, 58, 237, 0.15); border-color: rgba(124, 58, 237, 0.35);">
                    <div class="w-10 h-10 rounded-xl bg-primary/20 text-primary flex items-center justify-center border border-primary/30 shrink-0">
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7"/></svg>
                    </div>
                    <div>
                      <div class="text-[10px] font-black text-purple-300 uppercase tracking-wider mb-1">Kazanılan Ürünler</div>
                      <ul class="space-y-1.5">${pList}</ul>
                    </div>
                  </div>
                `;
              }
              if (rewardsList) rewardsList.innerHTML = html;
            }
          } else {
            boxError?.classList.remove('hidden');
            if (textError) textError.innerText = data.message || data.error || 'Kupon geçersiz veya kullanılmış.';
          }
        } catch (err) {
          boxError?.classList.remove('hidden');
          if (textError) textError.innerText = 'Sunucuyla bağlantı kurulamadı.';
        } finally {
          btnSubmit.disabled = false;
          btnSubmit.innerHTML = `
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7"/></svg>
            <span>Kuponu Bozdur</span>
          `;
        }
      });
    });
  </script>
{% else %}
  <div class="w-full max-w-[1350px] mx-auto px-4 sm:px-6 py-16 min-h-[60vh] flex items-center justify-center">
    <div
      class="rounded-3xl border-2 shadow-2xl p-10 max-w-lg w-full text-center backdrop-blur-xl"
      style="
        background: linear-gradient(135deg, rgba(26, 16, 32, 0.95), rgba(18, 10, 24, 0.95));
        border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.25);
      "
    >
      <div
        class="w-20 h-20 mx-auto rounded-3xl flex items-center justify-center mb-6 shadow-2xl border"
        style="
          background: rgba(var(--color-primary-rgb, 124, 58, 237), 0.15);
          border-color: rgba(var(--color-primary-rgb, 124, 58, 237), 0.35);
          color: var(--color-primary);
        "
      >
        <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
        </svg>
      </div>
      <h2 class="text-2xl sm:text-3xl font-black text-white mb-2" style="color: #ffffff !important;">Giriş Yapmalısınız</h2>
      <p class="text-xs sm:text-sm font-medium text-gray-300 mb-8 max-w-md mx-auto">
        Kupon kodlarını kullanabilmek için lütfen hesabınıza giriş yapın.
      </p>
      <a
        href="/auth/sign-in?return=/redeem"
        class="w-full py-4 rounded-2xl font-black text-sm uppercase tracking-wider text-white shadow-2xl transition-all duration-300 hover:scale-[1.02] flex items-center justify-center gap-2 border border-white/20"
        style="
          background: linear-gradient(135deg, var(--color-primary), #9333ea);
          box-shadow: 0 10px 30px rgba(var(--color-primary-rgb, 124, 58, 237), 0.45);
        "
      >
        Giriş Yap
      </a>
    </div>
  </div>
{% endif %}
